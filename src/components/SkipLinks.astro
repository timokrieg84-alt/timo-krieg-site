---
import site from "../config/site";
---
<nav aria-label="Skip Links" class="sr-only focus-within:not-sr-only">
  <ul class="flex gap-3 p-2">
    {site.accessibility.skipLinks.map((link) => (
      <li>
        <a href={link.href} class="rounded-md bg-white px-3 py-2 text-sm font-medium text-neutral-900 shadow focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-yellow-400">
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
