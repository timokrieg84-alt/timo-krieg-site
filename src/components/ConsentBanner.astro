---
import siteConfig from "../site-config";
const { integrations } = siteConfig;
const cc = integrations.cookieConsent;
---
<div id="cookie-consent" class="fixed inset-x-0 {cc.position === 'bottom' ? 'bottom-0' : 'top-0'} z-50 hidden">
  <div class="mx-auto max-w-5xl rounded-t-lg bg-[#0F2B46] p-4 text-white shadow-lg">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h3 class="text-base font-semibold">{cc.texts.headline}</h3>
        <p class="mt-1 text-sm/6 text-white/90">{cc.texts.intro}</p>
      </div>
      <div class="flex items-center gap-2">
        <button id="cc-accept" class="inline-flex items-center rounded-md bg-[#C6A667] px-3 py-2 text-sm font-semibold text-[#0F2B46] hover:bg-[#A78B52]">{cc.texts.acceptAll}</button>
        <button id="cc-reject" class="inline-flex items-center rounded-md border border-white/20 bg-transparent px-3 py-2 text-sm font-semibold text-white hover:bg-white/10">{cc.texts.rejectAll}</button>
        <button id="cc-manage" class="inline-flex items-center rounded-md border border-white/20 bg-transparent px-3 py-2 text-sm font-semibold text-white hover:bg-white/10">{cc.texts.manage}</button>
      </div>
    </div>
    <div id="cc-details" class="mt-3 hidden text-sm/6 text-white/90">
      <p class="mb-2">{cc.texts.details.essential}</p>
      <p>{cc.texts.details.analytics}</p>
      <div class="mt-3 flex items-center gap-4">
        {cc.categories.map((cat) => (
          <label class="inline-flex items-center gap-2">
            <input type="checkbox" class="h-4 w-4 rounded border-white/30 bg-transparent text-[#C6A667] focus:ring-[#C6A667]" checked={cat.default} disabled={cat.required} data-cat={cat.id} />
            <span>{cat.label}{cat.required ? ' (erforderlich)' : ''}</span>
          </label>
        ))}
      </div>
      <div class="mt-3">
        <button id="cc-save" class="inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-[#0F2B46] hover:bg-gray-100">Speichern</button>
      </div>
    </div>
  </div>
  <script>
    (function(){
      const el = document.getElementById('cookie-consent');
      const details = document.getElementById('cc-details');
      const accept = document.getElementById('cc-accept');
      const reject = document.getElementById('cc-reject');
      const manage = document.getElementById('cc-manage');
      const save = document.getElementById('cc-save');
      const KEY = 'cookie_consent_v1';
      const persisted = localStorage.getItem(KEY);
      const show = () => el?.classList.remove('hidden');
      const hide = () => el?.classList.add('hidden');
      if (!persisted) show();
      function set(consent){ localStorage.setItem(KEY, JSON.stringify(consent)); hide(); }
      accept?.addEventListener('click', () => set({ essential: true, analytics: true, timestamp: Date.now() }));
      reject?.addEventListener('click', () => set({ essential: true, analytics: false, timestamp: Date.now() }));
      manage?.addEventListener('click', () => details?.classList.toggle('hidden'));
      save?.addEventListener('click', () => {
        const boxes = Array.from(document.querySelectorAll('[data-cat]'));
        const consent = boxes.reduce((acc, b) => { acc[b.dataset.cat] = b.checked; return acc; }, { essential: true });
        set(consent);
      });
    })();
  </script>
</div>
