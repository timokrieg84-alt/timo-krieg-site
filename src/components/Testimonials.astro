<section id="cases" class="section">
  <div class="container stack">
    <div class="stack center max-w-md" data-reveal>
      <span class="eyebrow" data-reveal-child>Referenzen</span>
      <h2 data-reveal-child>Ergebnisse, die Vertrauen schaffen</h2>
    </div>
    <div class="swiper js-logos">
      <div class="swiper-wrapper">
        <div class="swiper-slide"><span>Logo 1</span></div>
        <div class="swiper-slide"><span>Logo 2</span></div>
        <div class="swiper-slide"><span>Logo 3</span></div>
        <div class="swiper-slide"><span>Logo 4</span></div>
      </div>
      <div class="swiper-pagination"></div>
    </div>
  </div>
</section>
<style>
.swiper { padding-top: var(--sp-5); }
.swiper-slide { display: grid; place-items: center; height: 96px; border: 1px solid var(--clr-border); border-radius: var(--radius-md); background: var(--clr-surface); }
.swiper-pagination-progressbar { background: rgba(28,140,255,.15); }
.swiper-pagination-progressbar-fill { background: var(--clr-accent); }
</style>
<script client:idle lang="ts">
  import 'swiper/css'; import 'swiper/css/pagination';
  (async () => {
    const { Swiper } = await import('swiper');
    const { Pagination, A11y, Autoplay } = await import('swiper/modules');
    const el = document.querySelector('.js-logos'); if (!el) return;
    new Swiper(el as any, {
      modules: [Pagination, A11y, Autoplay],
      slidesPerView: 2, spaceBetween: 16,
      autoplay: { delay: 2500, pauseOnMouseEnter: true, disableOnInteraction: false },
      a11y: { enabled: true },
      pagination: { el: (el as HTMLElement).querySelector('.swiper-pagination') as HTMLElement, type: 'progressbar' },
      breakpoints: { 640: { slidesPerView: 3, spaceBetween: 20 }, 960: { slidesPerView: 4, spaceBetween: 24 } }
    });
  })();
</script>
