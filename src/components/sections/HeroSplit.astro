---
interface Cta { label: string; path?: string; href?: string }
interface Image { src: string; alt: string }
interface Props {
  headline: string;
  subline?: string;
  primaryCta?: Cta;
  secondaryCta?: Cta;
  image: Image;
}
const { headline, subline, primaryCta, secondaryCta, image } = Astro.props as Props;
---
<section class="relative isolate overflow-hidden bg-white dark:bg-gray-950">
  <div class="mx-auto grid max-w-7xl grid-cols-1 items-center gap-10 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:gap-16 lg:py-24 lg:px-8">
    <div>
      <h1 class="font-display text-4xl font-semibold tracking-tight text-gray-900 dark:text-white sm:text-5xl">{headline}</h1>
      {subline && <p class="mt-4 text-lg text-gray-600 dark:text-gray-300">{subline}</p>}
      <div class="mt-8 flex flex-wrap items-center gap-3">
        {primaryCta && (
          <a href={primaryCta.href ?? primaryCta.path} class="inline-flex items-center rounded-md bg-[#0F2B46] px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-[#0B2236] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0F2B46]">{primaryCta.label}</a>
        )}
        {secondaryCta && (
          <a href={secondaryCta.href ?? secondaryCta.path} class="inline-flex items-center rounded-md bg-[#C6A667] px-4 py-2.5 text-sm font-semibold text-[#0F2B46] shadow-sm transition-colors hover:bg-[#A78B52] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#C6A667]">{secondaryCta.label}</a>
        )}
      </div>
    </div>
    <div class="relative">
      <img src={image.src} alt={image.alt} class="w-full rounded-xl border border-gray-200 object-cover shadow-sm dark:border-gray-800" />
      <div class="pointer-events-none absolute inset-0 rounded-xl ring-1 ring-inset ring-black/5 dark:ring-white/5" aria-hidden="true" />
    </div>
  </div>
</section>
