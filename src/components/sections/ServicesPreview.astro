---
import siteConfig from "../../site-config";
interface Props { headline?: string; serviceIds: string[]; cta?: { label: string; path: string } }
const { headline, serviceIds, cta } = Astro.props as Props;
const services = siteConfig.data.services.filter(s => serviceIds.includes(s.id));
---
<section class="bg-white dark:bg-gray-950">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    {headline && <h2 class="font-display text-3xl font-semibold tracking-tight text-gray-900 dark:text-white">{headline}</h2>}
    <div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <article class="group rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md dark:border-gray-800 dark:bg-gray-900">
          <a href={`/leistungen#${s.slug}`} class="block">
            <img src={s.image.src} alt={s.image.alt} class="h-44 w-full rounded-lg object-cover" />
            <h3 class="mt-4 text-lg font-semibold text-gray-900 dark:text-white">{s.title}</h3>
            <p class="mt-1 line-clamp-3 text-sm text-gray-600 dark:text-gray-300">{s.summary}</p>
          </a>
          {s.cta?.path && (
            <div class="mt-3">
              <a href={s.cta.path} class="inline-flex items-center text-sm font-medium text-[#0F2B46] hover:text-[#0B2236] dark:text-[#C6A667] dark:hover:text-[#A78B52]">{s.cta.label} →</a>
            </div>
          )}
        </article>
      ))}
    </div>
    {cta && (
      <div class="mt-8">
        <a href={cta.path} class="inline-flex items-center rounded-md bg-[#0F2B46] px-4 py-2 text-sm font-semibold text-white hover:bg-[#0B2236]">{cta.label}</a>
      </div>
    )}
  </div>
</section>
