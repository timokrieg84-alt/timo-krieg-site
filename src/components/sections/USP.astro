---
interface Item { icon?: string; title: string; text?: string }
interface Props { id?: string; items: Item[] }
const { id = 'usp', items = [] } = Astro.props as Props;
---
<section id={id} class="mx-auto max-w-[1200px] px-6 py-16">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {items.map((it) => (
      <div class="rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 p-6 shadow-sm">
        <div class="h-10 w-10 rounded-lg bg-yellow-300/40 text-yellow-800 dark:text-yellow-300 flex items-center justify-center">
          {it.icon === 'cup' && (<svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M3 3h14v8a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5V3zm16 3h2a2 2 0 1 1 0 4h-2V6z"/></svg>)}
          {it.icon === 'cake' && (<svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a2 2 0 1 1-2 2 2 2 0 0 1 2-2zm-6 8h12l2 6H4l2-6zm-2 8h16v2H4z"/></svg>)}
          {it.icon === 'leaf' && (<svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M5 3c10 0 14 6 14 12 0 4-3 6-6 6-6 0-12-4-12-10C1 7 3 3 5 3zm7 5c-4 0-7 3-7 7 0 3 3 5 6 5 4 0 7-2 7-6 0-3-2-6-6-6z"/></svg>)}
          {it.icon === 'sun' && (<svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M6.76 4.84l-1.8-1.79-1.41 1.41 1.79 1.8 1.42-1.42zM1 13h3v-2H1v2zm10 9h2v-3h-2v3zm9-9v-2h-3v2h3zm-2.05 7.95l1.41-1.41-1.79-1.8-1.41 1.41 1.79 1.8zM12 4a1 1 0 0 0 1-1V0h-2v3a1 1 0 0 0 1 1z"/></svg>)}
        </div>
        <h3 class="mt-4 text-lg font-semibold text-neutral-900 dark:text-neutral-100">{it.title}</h3>
        {it.text && <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-300">{it.text}</p>}
      </div>
    ))}
  </div>
</section>
