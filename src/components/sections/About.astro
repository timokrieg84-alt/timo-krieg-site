---
interface Feature { icon: string; title: string; text: string }
interface Image { src: string; alt: string }
interface Props { title: string; text: string; features?: Feature[]; image?: Image }
const { title, text, features = [], image } = Astro.props as Props;
---
<section id="about" class="scroll-mt-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <div class="grid grid-cols-1 items-center gap-10 md:grid-cols-2">
      <div>
        <h2 class="text-3xl font-semibold text-neutral-900 dark:text-white" style="font-family: 'Playfair Display', serif;">{title}</h2>
        <p class="mt-4 text-neutral-700 dark:text-neutral-300">{text}</p>
        {features.length > 0 && (
          <ul class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
            {features.map((f) => (
              <li class="flex items-start gap-3 rounded-xl border border-[#E9E2D0] bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900">
                <div class="mt-0.5 text-[#6B8E23]">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                    <circle cx="12" cy="12" r="10" opacity=".15"></circle>
                    <path d="M7 12h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">{f.title}</h3>
                  <p class="mt-1 text-sm text-neutral-700 dark:text-neutral-300">{f.text}</p>
                </div>
              </li>
            ))}
          </ul>
        )}
      </div>
      {image && (
        <div>
          <img src={image.src} alt={image.alt} class="w-full rounded-2xl border border-[#E9E2D0] object-cover shadow-sm dark:border-neutral-800" loading="lazy" />
        </div>
      )}
    </div>
  </div>
</section>
