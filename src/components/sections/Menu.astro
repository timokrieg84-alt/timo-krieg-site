---
import site from "@/config/site";
import { formatPrice } from "@/components/Price";
interface Option { label: string; priceDelta?: number }
interface Item { id: string; name: string; description?: string; price: { amount: number }; allergens?: string[]; tags?: string[]; options?: Option[] }
interface Category { id: string; title: string; items: Item[] }
interface Props {
  id?: string;
  heading?: string;
  layout?: 'tabs' | 'list';
  showAllergens?: boolean;
  showCategoryImages?: boolean;
  note?: string;
}
const { id = 'menu', heading = 'Speisekarte', layout = 'tabs', showAllergens = true, note } = Astro.props as Props;
const categories: Category[] = site.data.menu.categories as any;
const first = categories[0]?.id;
const allergenLabel: Record<string, string> = {
  MILK: 'Milch',
  GLUTEN: 'Gluten',
  EGG: 'Ei',
  NUTS: 'Nüsse',
};
---
<section id={id} class="mx-auto max-w-[1200px] px-6 py-16">
  <div class="flex items-end justify-between gap-4 mb-6">
    <div>
      <h2 class="text-2xl sm:text-3xl font-serif font-bold text-neutral-900 dark:text-neutral-50" style="font-family: Merriweather, ui-serif, Georgia, Cambria, Times New Roman, Times, serif;">{heading}</h2>
      {note && <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">{note}</p>}
    </div>
  </div>

  {layout === 'tabs' ? (
    <div>
      <div id="menu-tabs" class="flex gap-2 overflow-x-auto pb-2 -mx-1 px-1">
        {categories.map((cat) => (
          <button data-cat={cat.id} class={`shrink-0 rounded-full border px-4 py-2 text-sm transition-colors ${cat.id === first ? 'bg-yellow-100 dark:bg-yellow-900/30 border-yellow-300 text-neutral-900 dark:text-neutral-100' : 'bg-neutral-50 dark:bg-neutral-800 border-neutral-200 dark:border-neutral-700 text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-700'}`}>{cat.title}</button>
        ))}
      </div>
      <div class="mt-6" id="menu-panels">
        {categories.map((cat) => (
          <div data-panel={cat.id} class={cat.id === first ? '' : 'hidden'}>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
              {cat.items.map((it) => (
                <article class="rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 p-5 shadow-sm flex flex-col">
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">{it.name}</h3>
                      {it.description && <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-300">{it.description}</p>}
                    </div>
                    <div class="text-sm font-semibold text-neutral-900 dark:text-neutral-100 whitespace-nowrap">{formatPrice(it.price.amount)}</div>
                  </div>
                  {(it.tags?.length || (showAllergens && it.allergens?.length)) && (
                    <div class="mt-3 flex flex-wrap gap-1.5">
                      {it.tags?.map((t) => (
                        <span class="inline-flex items-center rounded-full bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300 px-2 py-0.5 text-xs">{t}</span>
                      ))}
                      {showAllergens && it.allergens?.map((a) => (
                        <span class="inline-flex items-center rounded-full bg-neutral-100 text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 px-2 py-0.5 text-xs">{allergenLabel[a] ?? a}</span>
                      ))}
                    </div>
                  )}
                  {it.options?.length ? (
                    <div class="mt-3 text-xs text-neutral-600 dark:text-neutral-400">
                      Optionen: {it.options.map((o, i) => (
                        <span>
                          {o.label}{o.priceDelta ? ` (+${formatPrice(o.priceDelta)})` : ''}{i < (it.options!.length - 1) ? ', ' : ''}
                        </span>
                      ))}
                    </div>
                  ) : null}
                </article>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  ) : (
    <div class="space-y-10">
      {categories.map((cat) => (
        <div>
          <h3 class="text-xl font-semibold text-neutral-900 dark:text-neutral-50">{cat.title}</h3>
          <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {cat.items.map((it) => (
              <article class="rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 p-5 shadow-sm">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h4 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">{it.name}</h4>
                    {it.description && <p class="mt-1 text-sm text-neutral-600 dark:text-neutral-300">{it.description}</p>}
                  </div>
                  <div class="text-sm font-semibold text-neutral-900 dark:text-neutral-100 whitespace-nowrap">{formatPrice(it.price.amount)}</div>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>
  )}

  <script set:html>
    {`
      (function(){
        const tabs = document.getElementById('menu-tabs');
        const panels = document.getElementById('menu-panels');
        if(!tabs || !panels) return;
        tabs.addEventListener('click', (e)=>{
          const b = e.target.closest('button');
          if(!b) return;
          const key = b.getAttribute('data-cat');
          tabs.querySelectorAll('button').forEach(btn=>{
            if(btn===b){
              btn.classList.add('bg-yellow-100','dark:bg-yellow-900/30','border-yellow-300','text-neutral-900','dark:text-neutral-100');
              btn.classList.remove('bg-neutral-50','dark:bg-neutral-800','border-neutral-200','dark:border-neutral-700');
            } else {
              btn.classList.remove('bg-yellow-100','dark:bg-yellow-900/30','border-yellow-300','text-neutral-900','dark:text-neutral-100');
              btn.classList.add('bg-neutral-50','dark:bg-neutral-800','border-neutral-200','dark:border-neutral-700');
            }
          });
          panels.querySelectorAll('[data-panel]').forEach(p=>{
            p.classList.toggle('hidden', p.getAttribute('data-panel')!==key);
          });
        });
      })();
    `}
  </script>
</section>
