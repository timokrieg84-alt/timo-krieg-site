---
import site from "../../config/site";

interface Props {
  title: string;
  subtitle?: string;
  showCategoryNav?: boolean;
  categories?: string[]; // ids from site.data.menu.categories
}

const { title, subtitle, showCategoryNav = true, categories = [] } = Astro.props as Props;
const allCategories = site.data.menu.categories;
const visible = categories.length ? allCategories.filter(c => categories.includes(c.id)) : allCategories;
---
<section id="menu" class="scroll-mt-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <div class="mb-10 max-w-3xl">
      <h2 class="text-3xl font-semibold text-neutral-900 dark:text-white" style="font-family: 'Playfair Display', serif;">{title}</h2>
      {subtitle && <p class="mt-2 text-neutral-700 dark:text-neutral-300">{subtitle}</p>}
    </div>

    {showCategoryNav && (
      <div class="mb-8 flex flex-wrap gap-2">
        {visible.map((cat) => (
          <a href={`#cat-${cat.id}`} class="inline-flex items-center rounded-full border border-[#E9E2D0] bg-white px-3 py-1.5 text-sm font-medium text-neutral-800 hover:bg-neutral-50 focus:outline-none focus:ring-2 focus:ring-yellow-400 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-200">{cat.title}</a>
        ))}
      </div>
    )}

    <div class="space-y-14">
      {visible.map((cat) => (
        <section id={`cat-${cat.id}`} class="scroll-mt-24">
          <h3 class="text-2xl font-semibold text-neutral-900 dark:text-white" style="font-family: 'Playfair Display', serif;">{cat.title}</h3>
          <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {cat.items.map((item) => (
              <li class="group rounded-2xl border border-[#E9E2D0] bg-white/80 p-4 shadow-sm backdrop-blur transition hover:-translate-y-0.5 hover:shadow-md dark:border-neutral-800 dark:bg-neutral-900/80">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h4 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">{item.name}</h4>
                    {item.description && <p class="mt-1 text-sm text-neutral-700 dark:text-neutral-300">{item.description}</p>}
                    <div class="mt-2 flex flex-wrap gap-2">
                      {item.size && <span class="inline-flex items-center rounded-full bg-neutral-100 px-2 py-0.5 text-xs text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300">{item.size}</span>}
                      {item.diet?.map((d) => (
                        <span class="inline-flex items-center rounded-full bg-emerald-100 px-2 py-0.5 text-xs text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300">{d}</span>
                      ))}
                      {item.allergens?.length > 0 && (
                        <span class="inline-flex items-center rounded-full bg-amber-100 px-2 py-0.5 text-xs text-amber-700 dark:bg-amber-900/30 dark:text-amber-300">Allergene: {item.allergens.join(', ')}</span>
                      )}
                    </div>
                  </div>
                  <div class="text-right">
                    <span class="whitespace-nowrap text-sm font-semibold text-neutral-900 dark:text-neutral-100">{item.price.display}</span>
                  </div>
                </div>
                {item.options && item.options.length > 0 && (
                  <div class="mt-3 text-xs text-neutral-600 dark:text-neutral-400">
                    Optionen: {item.options.map((o) => `${o.label} ${o.priceDiff?.display || ''}`).join(' · ')}
                  </div>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</section>
