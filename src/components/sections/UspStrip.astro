---
interface Usp { icon?: string; title: string; text?: string }
interface Props { items: Usp[] }
const { items } = Astro.props as Props;
---
<section class="bg-gray-50 dark:bg-gray-900/60">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {items.map((u) => (
        <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-gray-900">
          <h3 class="text-base font-semibold text-gray-900 dark:text-white">{u.title}</h3>
          {u.text && <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">{u.text}</p>}
        </div>
      ))}
    </div>
  </div>
</section>
