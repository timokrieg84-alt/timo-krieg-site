---
import Map from "../Map.astro";
import ContactForm from "../forms/ContactForm.astro";

interface Address { street: string; postalCode: string; city: string; country?: string }
interface Coordinates { lat: number; lng: number }
interface Props {
  title?: string;
  text?: string;
  address: Address;
  phone?: string;
  email?: string;
  map?: { provider?: string; coordinates: Coordinates; zoom?: number; markerLabel?: string };
  directions?: string;
  form?: string;
}

const { title = 'Kontakt & Anfahrt', text, address, phone, email, map, directions, form } = Astro.props as Props;
---
<section id="contact" class="scroll-mt-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <div class="mb-10 max-w-3xl">
      <h2 class="text-3xl font-semibold text-neutral-900 dark:text-white" style="font-family: 'Playfair Display', serif;">{title}</h2>
      {text && <p class="mt-2 text-neutral-700 dark:text-neutral-300">{text}</p>}
    </div>
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
      <div class="space-y-6">
        <div class="rounded-2xl border border-[#E9E2D0] bg-white p-5 dark:border-neutral-800 dark:bg-neutral-900">
          <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">Adresse</h3>
          <address class="mt-2 not-italic text-sm text-neutral-700 dark:text-neutral-300">
            {address.street}<br />
            {address.postalCode} {address.city}
          </address>
          <div class="mt-3 text-sm">
            {phone && <a href={`tel:${phone}`} class="text-neutral-700 hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-white">{phone}</a>}<br />
            {email && <a href={`mailto:${email}`} class="text-neutral-700 hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-white">{email}</a>}
          </div>
        </div>
        {map && (
          <div class="space-y-3">
            <Map coordinates={map.coordinates} zoom={map.zoom} markerLabel={map.markerLabel} />
            {directions && <p class="text-sm text-neutral-700 dark:text-neutral-300">{directions}</p>}
          </div>
        )}
      </div>
      <div class="rounded-2xl border border-[#E9E2D0] bg-white p-6 shadow-sm dark:border-neutral-800 dark:bg-neutral-900">
        <h3 class="text-base font-semibold text-neutral-900 dark:text-neutral-100">Schreib uns</h3>
        <div class="mt-4">
          <ContactForm />
        </div>
      </div>
    </div>
  </div>
</section>
