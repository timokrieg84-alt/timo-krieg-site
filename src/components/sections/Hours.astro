---
import site from "@/config/site";
interface Props { id?: string; heading?: string; showKitchen?: boolean; style?: 'table' | 'cards' }
const { id = 'hours', heading = 'Öffnungszeiten', showKitchen = true, style = 'table' } = Astro.props as Props;
const hours = site.data.hours;
const days = [
  ['monday','Montag'],
  ['tuesday','Dienstag'],
  ['wednesday','Mittwoch'],
  ['thursday','Donnerstag'],
  ['friday','Freitag'],
  ['saturday','Samstag'],
  ['sunday','Sonntag'],
] as const;
---
<section id={id} class="mx-auto max-w-[1200px] px-6 py-16">
  <h2 class="text-2xl sm:text-3xl font-serif font-bold text-neutral-900 dark:text-neutral-50" style="font-family: Merriweather, ui-serif, Georgia, Cambria, Times New Roman, Times, serif;">{heading}</h2>
  {style === 'table' ? (
    <div class="mt-6 overflow-hidden rounded-xl border border-neutral-200 dark:border-neutral-800">
      <table class="min-w-full divide-y divide-neutral-200 dark:divide-neutral-800 bg-white dark:bg-neutral-900">
        <tbody class="divide-y divide-neutral-200 dark:divide-neutral-800">
          {days.map(([key, label]) => (
            <tr>
              <td class="px-6 py-3 text-sm font-medium text-neutral-700 dark:text-neutral-300">{label}</td>
              <td class="px-6 py-3 text-sm text-neutral-900 dark:text-neutral-100">{hours.regular[key].open}–{hours.regular[key].close}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {days.map(([key, label]) => (
        <div class="rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 p-4">
          <div class="text-sm font-medium text-neutral-700 dark:text-neutral-300">{label}</div>
          <div class="mt-1 text-neutral-900 dark:text-neutral-100">{hours.regular[key].open}–{hours.regular[key].close}</div>
        </div>
      ))}
    </div>
  )}
  {showKitchen && (
    <div class="mt-6 text-sm text-neutral-700 dark:text-neutral-300">
      Küche: Frühstück {hours.kitchen.breakfast.start}–{hours.kitchen.breakfast.end} · Backstube {hours.kitchen.bakery.start}–{hours.kitchen.bakery.end}
      {hours.notes && <span class="block mt-1 text-neutral-500">{hours.notes}</span>}
    </div>
  )}
</section>
