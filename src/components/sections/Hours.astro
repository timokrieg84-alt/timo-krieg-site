---
interface Hour { day: string; opens: string | null; closes: string | null; note?: string }
interface Props { title?: string; note?: string; hours: Hour[] }
const { title = 'Öffnungszeiten', note, hours } = Astro.props as Props;
---
<section id="hours" class="scroll-mt-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <div class="mb-10 max-w-3xl">
      <h2 class="text-3xl font-semibold text-neutral-900 dark:text-white" style="font-family: 'Playfair Display', serif;">{title}</h2>
      {note && <p class="mt-2 text-neutral-700 dark:text-neutral-300">{note}</p>}
    </div>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {hours.map((h) => (
        <div class="flex items-center justify-between rounded-2xl border border-[#E9E2D0] bg-white p-4 dark:border-neutral-800 dark:bg-neutral-900">
          <span class="text-sm font-medium text-neutral-900 dark:text-neutral-100">{h.day}</span>
          <span class="text-sm text-neutral-700 dark:text-neutral-300">{h.opens && h.closes ? `${h.opens} – ${h.closes}` : (h.note || 'geschlossen')}</span>
        </div>
      ))}
    </div>
  </div>
</section>
