---
interface Testimonial { name: string; text: string }
interface Props { title?: string; items: Testimonial[] }
const { title = 'Was Gäste sagen', items } = Astro.props as Props;
---
<section id="testimonials" class="scroll-mt-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <div class="mb-10 max-w-3xl">
      <h2 class="text-3xl font-semibold text-neutral-900 dark:text-white" style="font-family: 'Playfair Display', serif;">{title}</h2>
    </div>
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((t) => (
        <li class="rounded-2xl border border-[#E9E2D0] bg-white p-5 shadow-sm dark:border-neutral-800 dark:bg-neutral-900">
          <p class="text-sm text-neutral-800 dark:text-neutral-200">“{t.text}”</p>
          <p class="mt-3 text-sm font-semibold text-neutral-900 dark:text-neutral-100">— {t.name}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
