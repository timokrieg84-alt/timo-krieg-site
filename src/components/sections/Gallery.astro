---
interface Img { src: string; alt: string }
interface Props { title?: string; images: Img[] }
const { title = 'Einblicke', images } = Astro.props as Props;
---
<section id="gallery" class="scroll-mt-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <div class="mb-10 max-w-3xl">
      <h2 class="text-3xl font-semibold text-neutral-900 dark:text-white" style="font-family: 'Playfair Display', serif;">{title}</h2>
    </div>
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:gap-4 lg:gap-5">
      {images.map((img) => (
        <li class="overflow-hidden rounded-xl">
          <img src={img.src} alt={img.alt} class="h-40 w-full object-cover sm:h-52 md:h-56 lg:h-64" loading="lazy" />
        </li>
      ))}
    </ul>
  </div>
</section>
