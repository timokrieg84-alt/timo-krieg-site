---
interface CardImage { src: string; alt: string }
interface Card { title: string; text?: string; meta?: string; image?: CardImage }
interface Props { title?: string; subtitle?: string; items: Card[] }
const { title, subtitle, items } = Astro.props as Props;
---
<section class="scroll-mt-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    {(title || subtitle) && (
      <div class="mb-10 max-w-3xl">
        {title && <h2 class="text-3xl font-semibold text-neutral-900 dark:text-white" style="font-family: 'Playfair Display', serif;">{title}</h2>}
        {subtitle && <p class="mt-2 text-neutral-700 dark:text-neutral-300">{subtitle}</p>}
      </div>
    )}
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <li class="group overflow-hidden rounded-2xl border border-[#E9E2D0] bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md dark:border-neutral-800 dark:bg-neutral-900">
          {item.image && <img src={item.image.src} alt={item.image.alt} class="h-44 w-full object-cover" loading="lazy" />}
          <div class="p-5">
            <h3 class="text-lg font-semibold text-neutral-900 dark:text-neutral-100">{item.title}</h3>
            {item.text && <p class="mt-2 text-sm text-neutral-700 dark:text-neutral-300">{item.text}</p>}
            {item.meta && <p class="mt-3 text-sm font-medium text-neutral-900 dark:text-neutral-100">{item.meta}</p>}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
