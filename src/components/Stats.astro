---
const stats = [
  { label: "Branchenportale", value: 30, suffix: "+" },
  { label: "Satelliten-Seiten", value: 50, suffix: "" },
  { label: "DSGVO-konform", value: 100, suffix: "%" },
];
---
<div class="grid grid-cols-2 md:grid-cols-3 gap-6">
  {stats.map((s) => (
    <div class="card p-6 reveal-up">
      <div class="text-4xl font-extrabold">
        <span class="stat" data-target={s.value} aria-live="polite">0</span>{s.suffix}
      </div>
      <div class="text-txt-2 mt-1">{s.label}</div>
    </div>
  ))}
</div>

<script is:client="visible">
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const els = document.querySelectorAll('.stat');
  const duration = 1.2;
  (async () => {
    if (reduce) { els.forEach(el => el.textContent = el.dataset.target); return; }
    const [{ gsap }, { ScrollTrigger }] = await Promise.all([
      import('gsap/dist/gsap'),
      import('gsap/dist/ScrollTrigger'),
    ]);
    gsap.registerPlugin(ScrollTrigger);
    els.forEach((el) => {
      const end = parseFloat(el.dataset.target || '0');
      const obj = { val: 0 };
      ScrollTrigger.create({
        trigger: el, start: 'top 85%', once: true,
        onEnter: () => gsap.to(obj, {
          val: end, duration, ease: 'power2.out',
          onUpdate: () => { el.textContent = Math.floor(obj.val).toString(); }
        })
      });
    });
  })();
</script>
