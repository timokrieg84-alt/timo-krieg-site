---
interface Cta { label: string; href: string }
interface Props {
  heading?: string;
  text?: string;
  cta?: Cta;
}
const { heading, text, cta } = Astro.props as Props;
---
<section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-12 md:py-16 text-center">
  {heading && <h1 class="text-3xl font-semibold text-neutral-900 dark:text-white" style="font-family: 'Playfair Display', serif;">{heading}</h1>}
  {text && <p class="mx-auto mt-4 max-w-2xl text-neutral-700 dark:text-neutral-300">{text}</p>}
  {cta && (
    <div class="mt-8">
      <a href={cta.href} class="inline-flex items-center rounded-full bg-[#F2B705] px-5 py-3 text-sm font-semibold text-neutral-900 shadow-sm hover:bg-[#C28E04] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-yellow-400">{cta.label}</a>
    </div>
  )}
</section>
