---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import site from "../data/site-config";
import Hero from "./sections/Hero.astro";
import FeaturesGrid from "./sections/FeaturesGrid.astro";
import ServicesGrid from "./sections/ServicesGrid.astro";
import TeamTeaser from "./sections/TeamTeaser.astro";
import TestimonialSlider from "./sections/TestimonialSlider.astro";
import FaqAccordion from "./sections/FaqAccordion.astro";
import CtaBanner from "./sections/CtaBanner.astro";
import PageHero from "./sections/PageHero.astro";
import ServicesList from "./sections/ServicesList.astro";
import TeamGrid from "./sections/TeamGrid.astro";
import OpeningHours from "./sections/OpeningHours.astro";
import ContactForm from "./sections/ContactForm.astro";

interface Props {
  section: any;
}
const { section } = Astro.props as Props;
const services = site.content.services;
const team = site.content.team;
const faqs = site.content.faqs;
const openingHours = site.content.openingHours;
const forms = site.content.forms;

let Component: AstroComponentFactory | null = null;
let data: any = section;

switch (section.type) {
  case 'hero':
    Component = Hero;
    break;
  case 'features-grid':
    Component = FeaturesGrid;
    break;
  case 'services-grid':
    data.items = section.items.map((id: string) => services.find((s) => s.id === id)).filter(Boolean);
    Component = ServicesGrid;
    break;
  case 'team-teaser':
    data.members = section.members.map((id: string) => team.find((m) => m.id === id)).filter(Boolean);
    Component = TeamTeaser;
    break;
  case 'testimonial-slider':
    data.items = section.items.map((id: string) => site.content.testimonials.find((t) => t.id === id)).filter(Boolean);
    Component = TestimonialSlider;
    break;
  case 'faq-accordion':
    data.items = section.items?.map((id: string) => faqs.find((f) => f.id === id)).filter(Boolean) ?? faqs;
    Component = FaqAccordion;
    break;
  case 'cta-banner':
    Component = CtaBanner;
    break;
  case 'page-hero':
    Component = PageHero;
    break;
  case 'services-list':
    data.items = section.items.map((id: string) => services.find((s) => s.id === id)).filter(Boolean);
    Component = ServicesList;
    break;
  case 'team-grid':
    data.members = section.members.map((id: string) => team.find((m) => m.id === id)).filter(Boolean);
    Component = TeamGrid;
    break;
  case 'opening-hours':
    data.items = openingHours;
    Component = OpeningHours;
    break;
  case 'form':
    data.form = Object.values(forms).find((f: any) => f.id === section.formRef);
    Component = ContactForm;
    break;
  default:
    Component = null;
}
---
{Component ? <Component {...data} /> : null}
