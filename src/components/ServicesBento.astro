---
import { servicesGrid } from "../data/site";
---
<section class="py-20 max-w-7xl mx-auto px-4">
  <div class="mb-10">
    <span class="text-emerald-400 font-bold text-sm tracking-widest uppercase">{servicesGrid.kicker_label}</span>
    <h2 class="text-4xl font-extrabold mt-2">{servicesGrid.headline_h2}</h2>
  </div>

  <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" role="list">
    {servicesGrid.grid_cards.map((c) => (
      <li class="group bg-brand-card p-6 rounded-2xl border border-white/10 hover:border-white/30 transition shadow-card will-change-transform">
        <a href={c.link} class="block focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 rounded-xl" aria-label={`${c.title} – ${c.sub_headline}`}>
          <div class="flex items-center gap-2 mb-3">
            <span class="text-2xl" aria-hidden="true">{c.icon}</span>
            {c.badge && <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">{c.badge}</span>}
          </div>
          <div class="inline-block px-3 py-1 rounded-full border text-xs font-bold mb-3 border-emerald-400 text-emerald-400">
            {c.title}
          </div>
          <h3 class="text-xl font-bold mb-1 group-hover:text-emerald-400 transition">{c.sub_headline}</h3>
          <p class="text-brand-muted text-sm leading-relaxed mb-3">{c.description}</p>
          {c.tags?.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-2">
              {c.tags.map((t) => (
                <span class="text-xs px-2 py-1 rounded-full border border-white/10 text-brand-muted">{t}</span>
              ))}
            </div>
          )}
          <span class="mt-4 inline-flex items-center gap-1 text-xs font-bold uppercase tracking-wider text-white group-hover:text-emerald-400">Mehr erfahren →</span>
        </a>
      </li>
    ))}
  </ul>
</section>
