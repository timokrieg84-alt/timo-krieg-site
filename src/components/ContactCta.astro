---
import { sections, contact, projectInfo } from "../data/site";
const { contact: contactSection } = sections;
---
<section id={sections.contactId} class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
  <div class="grid gap-8 lg:grid-cols-12 items-center">
    <div class="lg:col-span-6">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[var(--text)]">{contactSection.title}</h2>
      <p class="mt-4 text-[var(--text)]/90 max-w-2xl">{contactSection.text}</p>
      <div class="mt-6 rounded-xl border border-[var(--border)] bg-white p-6">
        <dl class="grid gap-3 sm:grid-cols-2">
          <div>
            <dt class="text-xs uppercase tracking-wide text-[var(--muted)]">E-Mail</dt>
            <dd class="text-[var(--text)]"><a class="hover:underline text-[var(--accent)]" href={`mailto:${contact.email}`}>{contact.email}</a></dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-wide text-[var(--muted)]">Telefon</dt>
            <dd class="text-[var(--text)]"><a class="hover:underline" href={`tel:${contact.phone}`}>{contact.phone}</a></dd>
          </div>
          <div class="sm:col-span-2">
            <dt class="text-xs uppercase tracking-wide text-[var(--muted)]">Adresse</dt>
            <dd class="text-[var(--text)]" set:html={contact.addressHtml}></dd>
          </div>
        </dl>
      </div>
    </div>
    <div class="lg:col-span-6">
      <form name="contact" method="post" netlify class="rounded-xl border border-[var(--border)] bg-white p-6 shadow-sm">
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <label class="block text-sm font-medium text-[var(--text)]" for="company">Unternehmen</label>
            <input required id="company" name="company" type="text" class="mt-1 w-full rounded-md border border-[var(--border)] px-3 py-2 text-[var(--text)] placeholder:text-[var(--muted)] focus:border-[var(--text)] focus:outline-none" placeholder="Ihre Firma" />
          </div>
          <div>
            <label class="block text-sm font-medium text-[var(--text)]" for="name">Name</label>
            <input required id="name" name="name" type="text" class="mt-1 w-full rounded-md border border-[var(--border)] px-3 py-2 text-[var(--text)] placeholder:text-[var(--muted)] focus:border-[var(--text)] focus:outline-none" placeholder="Max Mustermann" />
          </div>
          <div>
            <label class="block text-sm font-medium text-[var(--text)]" for="email">E-Mail</label>
            <input required id="email" name="email" type="email" class="mt-1 w-full rounded-md border border-[var(--border)] px-3 py-2 text-[var(--text)] placeholder:text-[var(--muted)] focus:border-[var(--text)] focus:outline-none" placeholder="mail@beispiel.de" />
          </div>
          <div class="sm:col-span-2">
            <label class="block text-sm font-medium text-[var(--text)]" for="message">Projektbeschreibung</label>
            <textarea required id="message" name="message" rows="5" class="mt-1 w-full rounded-md border border-[var(--border)] px-3 py-2 text-[var(--text)] placeholder:text-[var(--muted)] focus:border-[var(--text)] focus:outline-none" placeholder="Ziele, Zeitplan, Budgetrahmen…"></textarea>
          </div>
        </div>
        <div class="mt-6 flex items-center justify-between">
          <p class="text-xs text-[var(--muted)]">Durch Absenden stimmen Sie der <a href="/datenschutz" class="text-[var(--accent)] hover:underline">Datenschutzerklärung</a> zu.</p>
          <button type="submit" class="inline-flex items-center rounded-md bg-[var(--text)] px-5 py-2.5 text-sm font-medium text-[var(--text-inv)] hover:bg-[var(--accent)]">Absenden</button>
        </div>
      </form>
    </div>
  </div>
</section>
