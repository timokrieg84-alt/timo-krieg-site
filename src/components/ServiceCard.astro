---
import type { } from "astro";
import { colors } from "../data/site";

interface Service {
  slug: string;
  title: string;
  subtitle?: string;
  shortDescription?: string;
  features?: string[];
}

interface Props {
  service: Service;
}
const { service } = Astro.props as Props;
---
<article class={`group relative flex flex-col justify-between rounded-2xl border border-[${colors.muted}]/20 bg-[${colors.background}] p-6 shadow-sm transition-shadow hover:shadow-md`}
  id={service.slug}>
  <div>
    <h3 class={`text-lg font-semibold text-[${colors.text}]`}>{service.title}</h3>
    {service.subtitle && <p class={`mt-1 text-sm text-[${colors.muted}]`}>{service.subtitle}</p>}
    {service.shortDescription && (
      <p class={`mt-4 text-sm leading-6 text-[${colors.text}]/80`}>{service.shortDescription}</p>
    )}
    {service.features && service.features.length > 0 && (
      <ul class="mt-4 space-y-2">
        {service.features.slice(0, 4).map((f) => (
          <li class={`flex items-start gap-2 text-sm text-[${colors.text}]/70`}><span class={`mt-1 h-1.5 w-1.5 flex-none rounded-full bg-[${colors.secondary}]`}></span>{f}</li>
        ))}
      </ul>
    )}
  </div>
  <div class="mt-6 flex items-center justify-between">
    <a href={`/leistungen/${service.slug}`} class={`inline-flex items-center gap-2 text-sm font-semibold text-[${colors.primary}] hover:text-[${colors.secondary}]`}>
      Mehr erfahren
      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor"><path d="M7 5l6 5-6 5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
    <a href={`/#${service.slug}`} class={`text-xs text-[${colors.muted}] underline-offset-4 hover:underline`}>auf Startseite</a>
  </div>
  <div class={`pointer-events-none absolute inset-0 rounded-2xl ring-1 ring-inset ring-[${colors.gold}]/0 transition group-hover:ring-[${colors.gold}]/40`}></div>
</article>
