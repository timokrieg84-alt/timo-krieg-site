---
import { brand, services, sections, nav, contact, projectInfo } from "../data/site";
---
<footer class="mt-24 border-t border-[#F1F5F9] bg-[#FFFFFF] text-[#0F172A]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
    <div>
      <a href="/" class="font-semibold text-lg text-[#1E40AF]">{brand.logoText}</a>
      <p class="mt-3 text-sm text-[#94A3B8]">{projectInfo.tagline}</p>
      <div class="mt-4 text-sm">
        <a href={`/#${sections.contact}`} class="inline-flex items-center rounded-md bg-[#F97316] text-[#FFFFFF] px-3 py-2 font-medium hover:bg-[#1E40AF] transition-colors border border-[#F97316] hover:border-[#1E40AF]">Projekt anfragen</a>
      </div>
    </div>
    <div>
      <h2 class="font-semibold mb-3">Seiten</h2>
      <ul class="space-y-2 text-sm">
        <li><a href="/" class="hover:text-[#1E40AF]">Start</a></li>
        <li><a href={`/#${sections.services}`} class="hover:text-[#1E40AF]">Leistungen</a></li>
        <li><a href={`/#${sections.about}`} class="hover:text-[#1E40AF]">Über uns</a></li>
        <li><a href={`/#${sections.process}`} class="hover:text-[#1E40AF]">Prozess</a></li>
        <li><a href={`/#${sections.contact}`} class="hover:text-[#1E40AF]">Kontakt</a></li>
        <li><a href="/impressum" class="hover:text-[#1E40AF]">Impressum</a></li>
        <li><a href="/datenschutz" class="hover:text-[#1E40AF]">Datenschutz</a></li>
      </ul>
    </div>
    <div>
      <h2 class="font-semibold mb-3">Leistungen</h2>
      <ul class="space-y-2 text-sm">
        {services.map((s) => (
          <li><a href={`/leistungen/${s.slug}`} class="hover:text-[#1E40AF]">{s.title}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="font-semibold mb-3">Kontakt</h2>
      <address class="not-italic text-sm text-[#0F172A]">
        <div class="space-y-1">
          {contact.addressLines.map((l) => <div>{l}</div>)}
        </div>
        <div class="mt-3">
          <a class="hover:text-[#1E40AF]" href={`tel:${projectInfo.phone.replace(/\s+/g, '')}`}>{projectInfo.phone}</a><br />
          <a class="hover:text-[#1E40AF]" href={`mailto:${projectInfo.email}`}>{projectInfo.email}</a>
        </div>
      </address>
    </div>
  </div>
  <div class="border-t border-[#F1F5F9] py-4 text-sm text-[#94A3B8]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-3">
      <div>© {new Date().getFullYear()} {projectInfo.name}</div>
      <div class="flex items-center gap-4">
        <a href="/impressum" class="hover:text-[#1E40AF]">Impressum</a>
        <a href="/datenschutz" class="hover:text-[#1E40AF]">Datenschutz</a>
      </div>
    </div>
  </div>
</footer>
