---
const siteUrl = Astro.site ? String(Astro.site) : undefined;
const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Gylsere Januzi",
  "url": siteUrl,
  "slogan": "Exzellenz & Digitale Präsenz.",
  "email": "gjanuzikrieg@gmail.com",
  "telephone": "+49 175 6372395",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Kitzingstraße 7",
    "postalCode": "73529",
    "addressLocality": "Schwäbisch Gmünd",
    "addressCountry": "DE"
  }
};
---

<footer class="bg-brand-dark border-t border-white/10 py-12" role="contentinfo" aria-labelledby="footer-brand">
  <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8">
    <div>
      <h2 id="footer-brand" class="text-xl font-bold mb-2">Gylsere Januzi</h2>
      <p class="text-brand-muted text-sm">Exzellenz & Digitale Präsenz.</p>
    </div>

    <div class="text-brand-muted text-sm space-y-1">
      <address class="not-italic">
        <p>Kitzingstraße 7</p>
        <p>73529 Schwäbisch Gmünd</p>
      </address>
      <p>
        Tel:
        <a href="tel:+491756372395"
           class="text-brand-green hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-green rounded"
           aria-label="Telefon: +49 175 6372395">
          +49 175 6372395
        </a>
      </p>
      <p>
        E-Mail:
        <a href="mailto:gjanuzikrieg@gmail.com"
           class="text-brand-orange hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-green rounded"
           aria-label="E-Mail an gjanuzikrieg@gmail.com senden">
          gjanuzikrieg@gmail.com
        </a>
      </p>
    </div>

    <nav class="flex md:justify-end gap-6 text-sm font-medium" aria-label="Rechtliches">
      <a href="/impressum"
         class="hover:text-brand-pink transition focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-green rounded">
        Impressum
      </a>
      <a href="/datenschutz"
         class="hover:text-brand-pink transition focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-green rounded">
        Datenschutz
      </a>
    </nav>
  </div>

  <div aria-hidden="true" class="max-w-7xl mx-auto px-4 mt-10 grid grid-cols-3 gap-2">
    <span class="h-0.5 w-full bg-brand-orange/90 rounded-full"></span>
    <span class="h-0.5 w-full bg-brand-green/90 rounded-full"></span>
    <span class="h-0.5 w-full bg-brand-pink/90 rounded-full"></span>
  </div>

  <script type="application/ld+json">
    {JSON.stringify(orgLd)}
  </script>
</footer>
