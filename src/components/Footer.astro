---
import site from "../config/site";
const footer = site.footer;
const address = typeof footer.address === 'string' ? (site.contact.address as any) : footer.address;
const social = typeof footer.social === 'string' ? (site.contact.social as any) : footer.social;
const nav = Array.isArray(footer.navigation) ? footer.navigation : site.navigation.footer;
---
<footer class="border-t border-[#E9E2D0] bg-[#FFF9EC] dark:border-neutral-800 dark:bg-neutral-900" role="contentinfo">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="md:col-span-2">
        <a href="/" class="flex items-center gap-3">
          <img src={site.brand.logo.monochrome} alt={site.brand.logo.alt} class="h-8 w-auto" />
          <span class="font-semibold" style="font-family: 'Playfair Display', serif;">{site.brand.name}</span>
        </a>
        <p class="mt-4 max-w-md text-sm text-neutral-700 dark:text-neutral-300">{footer.slogan}</p>
        <p class="mt-3 text-sm text-neutral-600 dark:text-neutral-400">{footer.openingNote}</p>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">Kontakt</h3>
        <address class="not-italic mt-3 text-sm text-neutral-700 dark:text-neutral-300">
          {address.street}<br />
          {address.postalCode} {address.city}
        </address>
        <div class="mt-3 text-sm">
          <a href={`tel:${site.contact.phone}`} class="text-neutral-700 hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-white">{site.contact.phone}</a><br />
          <a href={`mailto:${site.contact.email}`} class="text-neutral-700 hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-white">{site.contact.email}</a>
        </div>
        <div class="mt-4 flex gap-3">
          <a href={social.instagram} aria-label="Instagram" class="text-neutral-700 hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5"><path d="M7 2C4.239 2 2 4.239 2 7v10c0 2.761 2.239 5 5 5h10c2.761 0 5-2.239 5-5V7c0-2.761-2.239-5-5-5H7zm0 2h10a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3zm11 2a1 1 0 1 0 0 2 1 1 0 0 0 0-2zM12 7a5 5 0 1 0 .001 10.001A5 5 0 0 0 12 7zm0 2a3 3 0 1 1-.001 6.001A3 3 0 0 1 12 9z"/></svg>
          </a>
          <a href={social.facebook} aria-label="Facebook" class="text-neutral-700 hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5"><path d="M13 3h4a1 1 0 0 1 1 1v4h-3a2 2 0 0 0-2 2v3h5l-1 4h-4v6h-4v-6H7v-4h3V9a4 4 0 0 1 4-4z"/></svg>
          </a>
          <a href={social.maps} aria-label="Karte" class="text-neutral-700 hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-white">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5"><path d="M12 2C8.134 2 5 5.134 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.866-3.134-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"/></svg>
          </a>
        </div>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-neutral-900 dark:text-neutral-100">Rechtliches</h3>
        <ul class="mt-3 space-y-2">
          {nav.map((item) => (
            <li><a href={item.href} class="text-sm text-neutral-700 hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-white">{item.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
    <div class="mt-10 flex flex-col gap-2 border-t border-[#E9E2D0] pt-6 text-xs text-neutral-600 dark:border-neutral-800 dark:text-neutral-400 md:flex-row md:items-center md:justify-between">
      <p>© {new Date().getFullYear()} {site.brand.name}</p>
      <p>Fotos: {site.brand.images.attribution}</p>
    </div>
  </div>
</footer>
