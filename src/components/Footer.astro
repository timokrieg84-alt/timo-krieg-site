---
import { brand, nav, services, contact } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-[#94A3B8]/50 bg-[#0B1220] text-white">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 grid grid-cols-1 md:grid-cols-4 gap-8">
    <div>
      <div class="flex items-center gap-3">
        <div class="h-8 w-8 rounded bg-[#22D3EE] ring-4 ring-[#22D3EE]/20"></div>
        <div class="text-lg font-semibold">{brand.logoText}</div>
      </div>
      <p class="mt-4 text-sm text-[#94A3B8] max-w-xs">{brand.tagline}</p>
      <div class="mt-4 text-sm text-[#94A3B8]">
        <div>{contact.street}</div>
        <div>{contact.zip} {contact.city}</div>
        <div class="mt-2"><a href={`tel:${contact.phone.replace(/\s+/g, '')}`} class="hover:text-white transition-colors">{contact.phone}</a></div>
        <div><a href={`mailto:${contact.email}`} class="hover:text-white transition-colors">{contact.email}</a></div>
        <div class="mt-2">{contact.openingHours}</div>
      </div>
    </div>

    <div>
      <div class="text-sm font-semibold uppercase tracking-wide text-[#94A3B8]">Navigation</div>
      <nav class="mt-3 flex flex-col gap-2">
        {nav.main.map((item) => (
          <a href={item.href} class="text-sm text-white/90 hover:text-[#22D3EE] transition-colors">{item.label}</a>
        ))}
      </nav>
    </div>

    <div>
      <div class="text-sm font-semibold uppercase tracking-wide text-[#94A3B8]">Leistungen</div>
      <nav class="mt-3 grid grid-cols-1 gap-2">
        {services.map((s) => (
          <a href={`/leistungen/${s.slug}`} class="text-sm text-white/90 hover:text-[#22D3EE] transition-colors">{s.title}</a>
        ))}
      </nav>
    </div>

    <div>
      <div class="text-sm font-semibold uppercase tracking-wide text-[#94A3B8]">Kontakt</div>
      <div class="mt-3 text-sm text-[#94A3B8] space-y-2">
        <div>
          <a href="#kontakt" class="inline-flex items-center gap-2 rounded-full bg-[#22D3EE] px-4 py-2 font-semibold text-[#0B1220] hover:bg-[#22D3EE]/90 transition-colors">Erstgespräch buchen</a>
        </div>
        <div>
          <a href="/impressum" class="hover:text-white transition-colors">Impressum</a> · <a href="/datenschutz" class="hover:text-white transition-colors">Datenschutz</a>
        </div>
      </div>
    </div>
  </div>
  <div class="border-t border-[#94A3B8]/40 py-4 text-center text-xs text-[#94A3B8]">© {year} {brand.name}. Alle Rechte vorbehalten.</div>
</footer>
