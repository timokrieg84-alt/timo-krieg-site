---
import { projectInfo } from "../data/site";
const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": projectInfo.company_name,
  "email": "info@januzi-bau.de",
  "telephone": "+49 175 6372395",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Kitzingstraße 7",
    "postalCode": "73529",
    "addressLocality": "Schwäbisch Gmünd",
    "addressCountry": "DE"
  }
};
const mapsEmbedUrl = `https://www.google.com/maps?q=${encodeURIComponent(projectInfo.location)}&output=embed`;
---
<footer class="bg-brand-dark border-t border-white/10 py-12" role="contentinfo" aria-labelledby="footer-brand">
  <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 lg:grid-cols-4 gap-8">
    <div>
      <h2 id="footer-brand" class="text-xl font-bold mb-2">{projectInfo.company_name}</h2>
      <p class="text-brand-muted text-sm">Exzellenz & Digitale Präsenz.</p>
    </div>

    <div class="text-brand-muted text-sm space-y-1">
      <address class="not-italic">
        <p>{projectInfo.location}</p>
      </address>
      <p>
        Tel: <a href={`tel:${projectInfo.phone_href}`} class="text-emerald-400 hover:underline">{projectInfo.phone}</a>
      </p>
      <p>
        E-Mail: <a href="mailto:info@januzi-bau.de" class="text-emerald-400 hover:underline">info@januzi-bau.de</a>
      </p>
    </div>

    <nav class="text-sm font-medium" aria-label="Rechtliches">
      <ul class="space-y-2">
        <li><a href="/impressum" class="hover:text-emerald-400 transition">Impressum</a></li>
        <li><a href="/datenschutz" class="hover:text-emerald-400 transition">Datenschutz</a></li>
      </ul>
    </nav>

    <div>
      <p class="text-sm font-semibold mb-2">Anfahrt</p>
      <div class="rounded-xl overflow-hidden border border-white/10">
        <div class="map-frame" data-map-container>
          <div class="map-placeholder p-3 text-center text-brand-muted">
            <p>{projectInfo.location}</p>
            <button class="mt-2 inline-flex items-center gap-2 px-3 py-2 rounded-lg border border-emerald-400 text-emerald-400 hover:bg-emerald-400 hover:text-black transition" type="button" data-load-map>Karte laden</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div aria-hidden="true" class="max-w-7xl mx-auto px-4 mt-10 grid grid-cols-3 gap-2">
    <span class="h-0.5 w-full bg-emerald-400/90 rounded-full"></span>
    <span class="h-0.5 w-full bg-emerald-400/70 rounded-full"></span>
    <span class="h-0.5 w-full bg-emerald-400/50 rounded-full"></span>
  </div>

  <script type="application/ld+json">{JSON.stringify(orgLd)}</script>
</footer>

<script is:raw>
(() => {
  const btn = document.querySelector('[data-load-map]');
  const wrap = document.querySelector('[data-map-container]');
  if (!btn || !wrap) return;
  const src = `${'https://www.google.com/maps?q=' + encodeURIComponent('Kitzingstraße 7, 73529 Schwäbisch Gmünd')}&output=embed`;
  btn.addEventListener('click', () => {
    const iframe = document.createElement('iframe');
    iframe.width = '100%';
    iframe.height = '240';
    iframe.loading = 'lazy';
    iframe.referrerPolicy = 'no-referrer-when-downgrade';
    iframe.style.border = '0';
    iframe.src = src;
    iframe.title = 'Karte: Anfahrt';
    wrap.innerHTML = '';
    wrap.appendChild(iframe);
  }, { once: true });
})();
</script>
