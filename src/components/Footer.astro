---
const telHref = 'tel:+491604365363';
---
<footer class="mt-16 border-t border-white/10">
  <div class="container py-12 grid gap-10 md:grid-cols-2">
    <div>
      <h3 class="text-xl font-semibold">Kontakt</h3>
      <p class="mt-2 text-slate-400">Timo Krieg – Digitalagentur & Performance Marketing<br/>Kitzingstraße 7, 73529 Schwäbisch Gmünd</p>
      <div class="mt-4 space-y-2">
        <a class="focus-ring block" href={telHref}>+49 160 4365363</a>
        <a class="focus-ring block" href="mailto:info@listingprofis.de">info@listingprofis.de</a>
      </div>
    </div>
    <div>
      <h3 class="text-xl font-semibold">Anfahrt</h3>
      <div class="mt-3">
        <div class="w-full h-[320px] md:h-[420px] rounded-xl border border-white/10 bg-gradient-to-br from-slate-900 to-slate-800 grid place-items-center text-slate-400">
          <span>Kartenplatzhalter</span>
        </div>
        <p class="mt-2 text-xs text-slate-400">Interaktive Karte kann später per Klick DSGVO-konform nachgeladen werden.</p>
      </div>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container py-6 text-sm text-slate-400 flex flex-col md:flex-row items-center justify-between gap-2">
      <span>© {new Date().getFullYear()} Timo Krieg – Digitalagentur & Performance Marketing</span>
      <nav class="flex gap-4">
        <a class="focus-ring" href="/impressum">Impressum</a>
        <a class="focus-ring" href="/datenschutz">Datenschutz</a>
      </nav>
    </div>
  </div>
</footer>
