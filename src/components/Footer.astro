---
const siteUrl = Astro.site ? String(Astro.site) : undefined;
const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Gylsere Januzi",
  "url": siteUrl,
  "slogan": "Exzellenz & Digitale Präsenz.",
  "email": "info@januzi-bau.de",
  "telephone": "+49 175 6372395",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Kitzingstraße 7",
    "postalCode": "73529",
    "addressLocality": "Schwäbisch Gmünd",
    "addressCountry": "DE"
  }
};
const mapsAddress = 'Kitzingstraße 7, 73529 Schwäbisch Gmünd';
const mapsSrc = `https://www.google.com/maps?q=${encodeURIComponent(mapsAddress)}&output=embed`;
---

<footer class="bg-brand-dark border-t border-white/10 py-12" role="contentinfo" aria-labelledby="footer-brand">
  <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8">
    <div>
      <h2 id="footer-brand" class="text-xl font-bold mb-2">Gylsere Januzi</h2>
      <p class="text-brand-muted text-sm">Exzellenz & Digitale Präsenz.</p>
    </div>

    <div class="text-brand-muted text-sm space-y-1">
      <address class="not-italic">
        <p>Kitzingstraße 7</p>
        <p>73529 Schwäbisch Gmünd</p>
      </address>
      <p>
        Tel:
        <a href="tel:+491756372395"
           class="text-emerald-400 hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 rounded"
           aria-label="Telefon: +49 175 6372395">
          +49 175 6372395
        </a>
      </p>
      <p>
        E-Mail:
        <a href="mailto:info@januzi-bau.de"
           class="text-emerald-400 hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 rounded"
           aria-label="E-Mail an info@januzi-bau.de senden">
          info@januzi-bau.de
        </a>
      </p>
    </div>

    <nav class="flex md:justify-end gap-6 text-sm font-medium" aria-label="Rechtliches">
      <a href="/impressum" class="hover:text-emerald-400 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 rounded">Impressum</a>
      <a href="/datenschutz" class="hover:text-emerald-400 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400 rounded">Datenschutz</a>
    </nav>
  </div>

  <div class="max-w-7xl mx-auto px-4 mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="rounded-xl border border-white/10 overflow-hidden bg-brand-card">
      <div class="p-4 flex items-center justify-between gap-3 border-b border-white/10">
        <p class="text-sm text-brand-muted">Direktkontakt</p>
        <div class="flex items-center gap-2">
          <a href="tel:+491756372395" class="px-3 py-1.5 rounded-lg border border-emerald-400 text-emerald-400 text-sm font-semibold hover:bg-emerald-400 hover:text-black transition">+49 175 6372395</a>
          <a href="mailto:info@januzi-bau.de" class="px-3 py-1.5 rounded-lg bg-emerald-400 text-black text-sm font-bold hover:bg-opacity-90 transition">E‑Mail</a>
        </div>
      </div>
      <div class="p-4">
        <div class="relative rounded-lg border border-white/10 overflow-hidden">
          <div class="p-4 text-center text-brand-muted" data-map-wrap>
            <p>{mapsAddress}</p>
            <button class="mt-3 px-3 py-2 rounded-lg bg-emerald-400 text-black text-sm font-semibold hover:bg-opacity-90 transition" type="button" data-load-map>Karte laden</button>
            <p class="text-xs mt-2">Hinweis: Durch das Laden der Karte werden ggf. personenbezogene Daten an Google übertragen.</p>
          </div>
        </div>
      </div>
    </div>
    <div aria-hidden="true" class="grid grid-cols-3 gap-2 self-start">
      <span class="h-0.5 w-full bg-emerald-400/90 rounded-full"></span>
      <span class="h-0.5 w-full bg-emerald-400/70 rounded-full"></span>
      <span class="h-0.5 w-full bg-emerald-400/50 rounded-full"></span>
    </div>
  </div>

  <script type="application/ld+json">{JSON.stringify(orgLd)}</script>
</footer>

<script is:raw>
(() => {
  const btn = document.querySelector('[data-load-map]');
  const wrap = document.querySelector('[data-map-wrap]');
  if (!btn || !wrap) return;
  btn.addEventListener('click', () => {
    const iframe = document.createElement('iframe');
    iframe.width = '100%'; iframe.height = '320'; iframe.loading = 'lazy';
    iframe.referrerPolicy = 'no-referrer-when-downgrade'; iframe.style.border = '0';
    iframe.title = 'Karte: Anfahrt'; iframe.src = `${'https://www.google.com/maps?q=' + encodeURIComponent('Kitzingstraße 7, 73529 Schwäbisch Gmünd')}&output=embed`;
    wrap.innerHTML = ''; wrap.appendChild(iframe);
  }, { once: true });
})();
</script>
