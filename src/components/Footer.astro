---
import { siteConfig } from "../config/site";
const footer = siteConfig.footer;
---
<footer class="mt-24 border-t border-zinc-200/60 dark:border-zinc-800 bg-white/70 dark:bg-zinc-950/60">
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <div>
        <a href="/" class="inline-flex items-center gap-3">
          <img src={siteConfig.branding.logo.src} alt={siteConfig.branding.logo.alt} width="40" height="40" class="h-10 w-10" />
          <span class="font-semibold text-zinc-800 dark:text-zinc-100">{siteConfig.project.name}</span>
        </a>
        <p class="mt-3 text-sm text-zinc-600 dark:text-zinc-400 max-w-xs">Warm, freundlich und lecker – dein Nachbarschaftscafé in Neukölln.</p>
      </div>

      {footer.columns.map((col) => (
        <div>
          <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 tracking-wide">{col.title}</h3>
          <ul class="mt-3 space-y-2">
            {col.items.map((item) => (
              <li>
                <a href={item.href} target={item.external ? "_blank" : undefined} rel={item.external ? "noopener noreferrer" : undefined} class="text-sm text-zinc-700 dark:text-zinc-300 hover:text-zinc-900 hover:underline underline-offset-4">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div>
        <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 tracking-wide">Folge uns</h3>
        <div class="mt-3 flex gap-3">
          {footer.social.map((s) => (
            <a href={s.href} class="inline-flex items-center gap-2 text-sm text-zinc-700 dark:text-zinc-300 hover:text-zinc-900" target="_blank" rel="noopener noreferrer">
              <span>{s.label}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-zinc-200 dark:border-zinc-800 pt-6">
      <p class="text-xs text-zinc-500">{footer.copyright}</p>
      <div class="flex items-center gap-3">
        <button id="theme-toggle" class="text-xs px-3 py-1 rounded-full border border-zinc-300 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-50 dark:hover:bg-zinc-800 transition">Dark/Light</button>
      </div>
    </div>
  </div>

  <script>
    const btn = document.getElementById('theme-toggle');
    if (btn) {
      btn.addEventListener('click', () => {
        const root = document.documentElement;
        const isDark = root.classList.toggle('dark');
        try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (e) {}
      });
    }
  </script>
</footer>
