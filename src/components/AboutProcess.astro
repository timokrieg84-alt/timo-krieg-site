---
import { sections } from "../data/site";
const { about, process } = sections;
---
<section id={sections.aboutId} class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
  <div class="grid gap-10 lg:grid-cols-12 items-start">
    <div class="lg:col-span-5">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text)]">{about.title}</h2>
      <p class="mt-4 text-[var(--text)]/90 leading-relaxed">{about.text}</p>
    </div>
    <div class="lg:col-span-7" id={sections.processId}>
      <h3 class="text-xl font-semibold text-[var(--text)]">{process.title}</h3>
      <ol class="mt-6 grid gap-4 sm:grid-cols-2">
        {process.steps.map((step, idx) => (
          <li class="relative rounded-lg border border-[var(--border)] bg-white p-5">
            <span class="absolute -top-3 -left-3 inline-flex h-8 w-8 items-center justify-center rounded-full bg-[var(--accent)] text-white text-sm font-semibold">{idx + 1}</span>
            <div class="font-medium text-[var(--text)]">{step.title}</div>
            <p class="mt-1 text-sm text-[var(--muted)]">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
