---
export interface MenuItem {
  name: string;
  description?: string;
  price: number;
  tags?: string[];
}
export interface Category {
  id: string;
  title: string;
  note?: string;
  items: MenuItem[];
}
export interface Props {
  title: string;
  subtitle?: string;
  categories: Category[];
  currency?: string; // e.g. EUR
  locale?: string; // e.g. de-DE
}
const { title, subtitle, categories = [], currency = 'EUR', locale = 'de-DE' } = Astro.props as Props;
const fmt = new Intl.NumberFormat(locale, { style: 'currency', currency });
---
<section id="speisekarte" class="scroll-mt-28 py-20 md:py-24 bg-bg border-t border-divider">
  <div class="container">
    <header class="max-w-2xl">
      <h2 class="font-heading text-[32px] md:text-[40px] leading-tight text-text">{title}</h2>
      {subtitle && <p class="mt-2 text-textSecondary">{subtitle}</p>}
    </header>

    <div class="mt-10 space-y-16">
      {categories.map((cat) => (
        <section id={cat.id} class="group">
          <div class="flex items-end justify-between gap-6 border-b border-divider pb-3">
            <h3 class="font-heading text-[26px] md:text-[32px] text-text">{cat.title}</h3>
            {cat.note && <span class="text-sm text-textSecondary">{cat.note}</span>}
          </div>
          <ul class="mt-6 grid md:grid-cols-2 gap-x-10 gap-y-6">
            {cat.items.map((item) => (
              <li class="p-0">
                <div class="flex items-start justify-between gap-6">
                  <div class="min-w-0">
                    <p class="font-semibold text-text leading-6">{item.name}</p>
                    {item.description && <p class="text-sm text-textSecondary mt-1">{item.description}</p>}
                    {item.tags && item.tags.length > 0 && (
                      <ul class="mt-2 flex flex-wrap gap-2 text-xs text-textSecondary">
                        {item.tags.map((t) => (
                          <li class="px-2 py-0.5 rounded-full bg-white border border-divider">{t}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                  <div class="shrink-0 text-text font-semibold">{fmt.format(item.price)}</div>
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</section>
