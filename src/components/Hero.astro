---
interface Cta {
  label: string;
  to: string; // will be normalized to anchor links
  style?: 'primary' | 'secondary';
}
interface Props {
  id?: string;
  title: string;
  subtitle?: string;
  image?: string;
  overlay?: number; // 0..1
  primaryCta?: Cta;
  secondaryCta?: Cta;
}
const {
  id = 'hero',
  title,
  subtitle = '',
  image = '/assets/images/hero/restaurant-innenraum.jpg',
  overlay = 0.35,
  primaryCta,
  secondaryCta
} = Astro.props as Props;
---
<section id={id} class="relative isolate w-full">
  <div class="absolute inset-0 -z-10">
    <img src={image} alt="" class="h-[70vh] w-full object-cover" loading="eager" />
    <div class="absolute inset-0" style={`background:linear-gradient(rgba(0,0,0,${overlay}), rgba(0,0,0,${overlay}))`}></div>
  </div>
  <div class="mx-auto max-w-[1200px] px-4 py-20 md:py-28 lg:py-32 text-white">
    <div class="max-w-3xl">
      <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">{title}</h1>
      {subtitle && <p class="mt-4 text-lg md:text-xl text-white/90">{subtitle}</p>}
      <div class="mt-8 flex flex-wrap gap-3">
        {primaryCta && (
          <a href={primaryCta.to.startsWith('#') ? primaryCta.to : '#contact'} class="inline-flex items-center justify-center rounded-md bg-[#2E7D32] text-white px-5 py-3 text-base font-medium shadow hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-white/70">
            {primaryCta.label}
          </a>
        )}
        {secondaryCta && (
          <a href={secondaryCta.to.startsWith('#') ? secondaryCta.to : '#menu'} class="inline-flex items-center justify-center rounded-md border border-white/70 text-white px-5 py-3 text-base font-medium hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/70">
            {secondaryCta.label}
          </a>
        )}
      </div>
    </div>
  </div>
</section>
