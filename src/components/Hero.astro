---
const heading = "Mehr Sichtbarkeit. Mehr Anfragen. Mehr Wachstum.";
const sub = "Premium-Online-Marketing aus einer Hand: SEO, Google Ads, Webdesign (Astro), Automation und mehr – messbar, DSGVO-sicher und auf nachhaltiges Wachstum ausgelegt.";
---
<section class="relative overflow-hidden">
  <picture class="absolute inset-0 -z-10">
    <source srcset="/images/hero-bg.webp" type="image/webp" />
    <img src="/images/hero-bg.webp" alt="Abstrakter, edler dunkler Hintergrund mit Cyan-Lichtakzenten" class="w-full h-full object-cover" loading="eager" fetchpriority="high"/>
  </picture>

  <div class="container py-24 md:py-32">
    <div class="badge mb-6 reveal-up">Online Marketing Office · Schwäbisch Gmünd</div>
    <h1 class="h1 max-w-[18ch] reveal-up">{heading}</h1>
    <p class="lead mt-5 max-w-[70ch] reveal-up">{sub}</p>
    <ul class="mt-6 grid sm:grid-cols-2 lg:grid-cols-4 gap-3 text-sm text-txt-2 reveal-up">
      <li class="card p-3">Über 30 Branchenportale synchronisiert</li>
      <li class="card p-3">DSGVO-konform inkl. Consent-Management</li>
      <li class="card p-3">Transparente KPIs und Reportings</li>
      <li class="card p-3">Ein fester Ansprechpartner</li>
    </ul>
    <div class="mt-8 flex flex-wrap items-center gap-4 reveal-up">
      <a href="/projekt-anfragen" class="btn btn-primary btn-glare" data-magnetic>Projekt anfragen</a>
      <a href="#leistungen" class="btn btn-secondary">Leistungen ansehen</a>
    </div>
  </div>
</section>
