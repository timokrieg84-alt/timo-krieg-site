<section class="section" aria-label="Hero">
  <div class="container--wide" style="position: relative;">
    <canvas id="hero-canvas" aria-hidden="true" style="position:absolute; inset:0; width:100%; height:100%; pointer-events:none;"></canvas>
    <div class="container" style="position: relative;">
      <div data-reveal data-stagger="0.06" class="stack max-w-lg" style="padding-top: min(18vh, 10rem); padding-bottom: min(12vh, 8rem);">
        <span class="badge badge--accent" data-reveal-child>Online Marketing Office · Schwäbisch Gmünd</span>
        <h1 data-reveal-child>Mehr Sichtbarkeit. Mehr Anfragen. Mehr Wachstum.</h1>
        <p class="text-muted" data-reveal-child>Premium-Online-Marketing aus einer Hand: SEO, Google Ads, Webdesign, Automation und mehr – messbar, DSGVO-sicher und auf nachhaltiges Wachstum ausgelegt.</p>
        <div class="btn-row" data-reveal-child>
          <a class="btn" href="/kontakt">Projekt anfragen</a>
          <a class="btn btn--secondary" href="/leistungen">Leistungen ansehen</a>
        </div>
        <ul role="list" class="flow" style="margin-top: var(--sp-5);" data-reveal-child>
          <li>Über 30 Branchenportale synchronisiert</li>
          <li>DSGVO-konform inkl. Consent-Management</li>
          <li>Transparente KPIs und Reportings</li>
          <li>Ein fester Ansprechpartner</li>
        </ul>
      </div>
    </div>
    <picture>
      <source srcset="/images/hero-office-dusk.webp" type="image/webp" />
      <img src="/images/hero-office-dusk.webp" alt="Hochwertiges Online-Marketing-Office mit Electric-Blue-Akzenten" style="position:absolute; inset:0; width:100%; height:100%; object-fit: cover; opacity: .18;" loading="eager" fetchpriority="high" />
    </picture>
  </div>
</section>
<script client:idle lang="ts">
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefersReduced) {
    (async () => {
      const { HeroBackground } = await import('../scripts/hero/HeroBackground.ts');
      const c = document.getElementById('hero-canvas');
      if (c) new HeroBackground(c as HTMLCanvasElement, { density: 0.008, maxRadius: 36, speed: 0.3 });
    })();
  }
  import('../scripts/gsap-reveals.ts');
</script>
