---
import { siteConfig } from "../config/site";
const hero = siteConfig.content.hero;
const layout = siteConfig.layout;
---
<section id={hero.id} class="relative isolate min-h-[50vh]" style={`min-height:${layout.heroHeight}`}> 
  <div class="absolute inset-0 -z-10">
    <img src={hero.bgImage} alt="" class="h-full w-full object-cover" loading="eager" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/20 to-transparent"></div>
  </div>
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 py-16 sm:py-24 lg:py-28">
    <div class="max-w-2xl">
      <div class="inline-flex items-center gap-2 rounded-full bg-yellow-300/90 text-zinc-900 px-3 py-1 text-xs font-medium shadow-sm">
        {hero.badge?.icon === 'sun' && (
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4"><path d="M12 18a6 6 0 100-12 6 6 0 000 12zM12 2.25a.75.75 0 01.75.75v1.5a.75.75 0 01-1.5 0V3a.75.75 0 01.75-.75zM12 19.5a.75.75 0 01.75.75V21.75a.75.75 0 01-1.5 0V20.25a.75.75 0 01.75-.75zM4.72 4.72a.75.75 0 011.06 0l1.06 1.06a.75.75 0 11-1.06 1.06L4.72 5.78a.75.75 0 010-1.06zM17.16 17.16a.75.75 0 011.06 0l1.06 1.06a.75.75 0 11-1.06 1.06l-1.06-1.06a.75.75 0 010-1.06zM2.25 12a.75.75 0 01.75-.75h1.5a.75.75 0 010 1.5H3a.75.75 0 01-.75-.75zM19.5 12a.75.75 0 01.75-.75h1.5a.75.75 0 010 1.5H20.25A.75.75 0 0119.5 12zM4.72 19.28a.75.75 0 000 1.06l1.06 1.06a.75.75 0 101.06-1.06L5.78 19.28a.75.75 0 00-1.06 0zM17.16 6.84a.75.75 0 000 1.06l1.06 1.06a.75.75 0 101.06-1.06L18.22 6.84a.75.75 0 00-1.06 0z"/></svg>
        )}
        <span>{hero.badge?.text}</span>
      </div>
      <h1 class="mt-5 text-4xl sm:text-5xl font-semibold text-white leading-tight tracking-tight">{hero.headline}</h1>
      <p class="mt-4 text-lg text-white/90 max-w-xl">{hero.subheadline}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={hero.primaryCta.href} class="inline-flex items-center justify-center rounded-md bg-yellow-400 hover:bg-yellow-500 text-zinc-900 font-medium px-5 py-3 shadow-md transition-colors">
          {hero.primaryCta.label}
        </a>
        <a href={hero.secondaryCta.href} class="inline-flex items-center justify-center rounded-md bg-white/10 hover:bg-white/20 text-white font-medium px-5 py-3 ring-1 ring-white/30 backdrop-blur-sm transition-colors">
          {hero.secondaryCta.label}
        </a>
      </div>
    </div>
  </div>
</section>
