---
import { sections } from "../data/site";
const { hero } = sections;
---
<section id={sections.heroId} class="relative overflow-hidden bg-[#F8FAFC]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-20 lg:py-28 grid gap-12 lg:grid-cols-12 items-center">
    <div class="lg:col-span-7">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-[#0B1221]">
        {hero.headline}
      </h1>
      <p class="mt-6 text-lg leading-8 text-[#64748B] max-w-2xl">
        {hero.subline}
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3">
        <a href={hero.primaryCta.href} class="inline-flex items-center justify-center rounded-md bg-[#0B1221] px-6 py-3 text-base font-medium text-[#FFFFFF] hover:bg-[#0EA5E9] transition-colors">
          {hero.primaryCta.label}
        </a>
        <a href={hero.secondaryCta.href} class="inline-flex items-center justify-center rounded-md border border-[#E2E8F0] bg-[#FFFFFF] px-6 py-3 text-base font-medium text-[#0B1221] hover:border-[#0B1221] transition-colors">
          {hero.secondaryCta.label}
        </a>
      </div>
    </div>
    <div class="lg:col-span-5">
      <div class="relative rounded-2xl border border-[#E2E8F0] bg-[#FFFFFF] p-6 shadow-sm">
        <div class="absolute -top-6 -left-6 h-24 w-24 rounded-full bg-[#0EA5E9] opacity-10"></div>
        <div class="absolute -bottom-6 -right-6 h-24 w-24 rounded-full bg-[#F59E0B] opacity-10"></div>
        <div class="grid grid-cols-2 gap-3 text-center">
          <div class="rounded-lg border border-[#E2E8F0] p-4">
            <div class="text-3xl font-bold text-[#0B1221]">95+</div>
            <div class="text-xs uppercase tracking-wide text-[#64748B]">Lighthouse</div>
          </div>
          <div class="rounded-lg border border-[#E2E8F0] p-4">
            <div class="text-3xl font-bold text-[#0B1221]"><span class="text-[#0EA5E9]">∞</span></div>
            <div class="text-xs uppercase tracking-wide text-[#64748B]">Skalierbar</div>
          </div>
          <div class="rounded-lg border border-[#E2E8F0] p-4">
            <div class="text-3xl font-bold text-[#0B1221]">AA</div>
            <div class="text-xs uppercase tracking-wide text-[#64748B]">A11y</div>
          </div>
          <div class="rounded-lg border border-[#E2E8F0] p-4">
            <div class="text-3xl font-bold text-[#0B1221]">0.9s</div>
            <div class="text-xs uppercase tracking-wide text-[#64748B]">TTI</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
