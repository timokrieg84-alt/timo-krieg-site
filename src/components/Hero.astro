---
import { sections, colors } from "../data/site";
const { hero } = sections;
---
<section id={sections.heroId} class="relative overflow-hidden bg-[var(--surface)]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-20 lg:py-28 grid gap-12 lg:grid-cols-12 items-center">
    <div class="lg:col-span-7">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-[var(--text)]">
        {hero.headline}
      </h1>
      <p class="mt-6 text-lg leading-8 text-[var(--muted)] max-w-2xl">
        {hero.subline}
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3">
        <a href={hero.primaryCta.href} class="inline-flex items-center justify-center rounded-md bg-[var(--text)] px-6 py-3 text-base font-medium text-[var(--text-inv)] hover:bg-[var(--accent)] transition-colors">
          {hero.primaryCta.label}
        </a>
        <a href={hero.secondaryCta.href} class="inline-flex items-center justify-center rounded-md border border-[var(--border)] bg-white px-6 py-3 text-base font-medium text-[var(--text)] hover:border-[var(--text)] transition-colors">
          {hero.secondaryCta.label}
        </a>
      </div>
    </div>
    <div class="lg:col-span-5">
      <div class="relative rounded-2xl border border-[var(--border)] bg-white p-6 shadow-sm">
        <div class="absolute -top-6 -left-6 h-24 w-24 rounded-full bg-[var(--accent)] opacity-10"></div>
        <div class="absolute -bottom-6 -right-6 h-24 w-24 rounded-full bg-[var(--accent2)] opacity-10"></div>
        <div class="grid grid-cols-2 gap-3 text-center">
          <div class="rounded-lg border border-[var(--border)] p-4">
            <div class="text-3xl font-bold text-[var(--text)]">95+</div>
            <div class="text-xs uppercase tracking-wide text-[var(--muted)]">Lighthouse</div>
          </div>
          <div class="rounded-lg border border-[var(--border)] p-4">
            <div class="text-3xl font-bold text-[var(--text)]"><span class="text-[var(--accent)]">∞</span></div>
            <div class="text-xs uppercase tracking-wide text-[var(--muted)]">Skalierbar</div>
          </div>
          <div class="rounded-lg border border-[var(--border)] p-4">
            <div class="text-3xl font-bold text-[var(--text)]">AA</div>
            <div class="text-xs uppercase tracking-wide text-[var(--muted)]">A11y</div>
          </div>
          <div class="rounded-lg border border-[var(--border)] p-4">
            <div class="text-3xl font-bold text-[var(--text)]">0.9s</div>
            <div class="text-xs uppercase tracking-wide text-[var(--muted)]">TTI</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
