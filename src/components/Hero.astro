---
const telHref = 'tel:+491604365363';
---
<section class="relative overflow-hidden">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="container relative py-24 md:py-32 text-center">
    <p class="kicker">Schwäbisch Gmünd • Ostalbkreis • DACH</p>
    <h1 class="mt-3 text-4xl md:text-6xl font-semibold tracking-tight text-white">Skalierbares Wachstum & erstklassiges Webdesign für den Mittelstand</h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-brand.muted">Ihre Digitalagentur für messbares Performance Marketing, Webdesign Schwäbisch Gmünd und Conversion Optimierung – schnell, klar, ergebnisorientiert.</p>
    <div class="mt-3 text-brand.muted" aria-label="Google Bewertung: 5 von 5 Sternen">
      <span class="text-amber-400" aria-hidden="true">★★★★★</span>
      <span class="sr-only">5.0</span> 5.0 Google Bewertung
    </div>
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
      <a href={telHref} class="btn btn-primary" aria-label="Jetzt anrufen unter +49 160 4365363">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.86 19.86 0 0 1-8.63-3.07A19.5 19.5 0 0 1 3.15 8.81 19.86 19.86 0 0 1 .08 0 2 2 0 0 1 2.05 0h3a2 2 0 0 1 2 1.72c.12.9.32 1.78.59 2.63a2 2 0 0 1-.45 2.11L6.1 7.91a16 16 0 0 0 6 6l1.45-1.09a2 2 0 0 1 2.11-.45c.85.27 1.73.47 2.63.59A2 2 0 0 1 22 16.92z"/></svg>
        Jetzt anrufen
      </a>
      <a href="/kontakt" class="btn btn-secondary">Kostenloses Erstgespräch</a>
    </div>
  </div>
</section>
