---
import { hero } from "../data/site";
---
<section id="home" class="py-20 sm:py-28 bg-brand-dark border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 text-center">
    <span class="text-emerald-400 font-bold text-sm tracking-widest uppercase">{hero.kicker_label}</span>
    <h1 class="text-5xl sm:text-7xl font-black tracking-tight mt-4 mb-2">{hero.headline_h1}</h1>
    <p class="text-emerald-400/80 font-bold">{hero.slogan_styled}</p>
    <p class="text-xl text-brand-muted max-w-2xl mx-auto mt-6">{hero.value_proposition}</p>

    <div class="flex flex-wrap justify-center gap-4 mt-10">
      <a href="#kontakt" class="border border-emerald-400 text-emerald-400 px-6 py-3 rounded-xl font-bold hover:bg-emerald-400 hover:text-black transition">{hero.cta_area.primary_button}</a>
      <a href={`tel:${hero.cta_area.secondary_action.phone_href}`} class="bg-emerald-400 text-black px-6 py-3 rounded-xl font-bold hover:bg-emerald-400/90 transition inline-flex items-center gap-2">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.86 19.86 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.86 19.86 0 0 1 2.09 4.18 2 2 0 0 1 4.06 2h3a2 2 0 0 1 2 1.72c.12.9.3 1.78.57 2.63a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.45-1.09a2 2 0 0 1 2.11-.45c.85.27 1.73.45 2.63.57A2 2 0 0 1 22 16.92z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {hero.cta_area.secondary_action.text}
      </a>
    </div>

    <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm text-brand-muted">
      <div class="rounded-lg border border-white/10 px-3 py-2">{hero.bottom_trust_ticker.response_time}</div>
      <div class="rounded-lg border border-white/10 px-3 py-2">{hero.bottom_trust_ticker.active_clients}</div>
      <div class="rounded-lg border border-white/10 px-3 py-2">{hero.bottom_trust_ticker.news_tag}</div>
    </div>
  </div>
</section>
