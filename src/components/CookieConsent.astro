---
import site from "@/config/site";
const cc = site.features.cookieConsent;
---
{cc?.enabled && (
  <div id="cookie-consent" class="fixed inset-x-0 bottom-0 z-50">
    <div class="mx-auto max-w-[1200px] px-6 pb-6">
      <div class="rounded-lg border border-neutral-200 dark:border-neutral-800 bg-white/95 dark:bg-neutral-900/95 shadow-md p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <p class="text-sm text-neutral-700 dark:text-neutral-300">{cc.text}</p>
        <div class="flex items-center gap-3">
          <button id="cc-accept" class="inline-flex items-center rounded-md px-3 py-2 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-yellow-500" style={`background:${site.theme.buttons.primary.bg};color:${site.theme.buttons.primary.text}`}>{cc.acceptLabel}</button>
          <button id="cc-manage" class="text-sm text-neutral-700 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-white">{cc.manageLabel}</button>
        </div>
      </div>
    </div>
    <script>
      const KEY = 'cc_sonnenblume';
      const bar = document.getElementById('cookie-consent');
      const accept = document.getElementById('cc-accept');
      const manage = document.getElementById('cc-manage');
      try {
        if (localStorage.getItem(KEY) === 'accepted') {
          bar?.remove();
        }
      } catch (e) {}
      accept?.addEventListener('click', () => {
        try { localStorage.setItem(KEY, 'accepted'); } catch (e) {}
        bar?.remove();
      });
      manage?.addEventListener('click', () => {
        alert('Es werden nur essentielle Cookies verwendet.');
      });
    </script>
  </div>
)}
