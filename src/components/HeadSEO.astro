---
const {
  title = "Gylsere Januzi Krieg – Online Marketing Office",
  description = "Premium Online‑Marketing. Souverän. Messbar. Klar.",
  url = "https://example.com/",
  image = "https://example.com/images/hero-bg.webp",
  canonical = url,
  type = "website"
} = Astro.props;
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Gylsere Januzi Krieg – Online Marketing Office" />
<meta property="og:locale" content="de_DE" />
<meta property="og:image" content={image} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
