---
export interface Props { name: string; url: string; }
const { name, url } = Astro.props;
const SVC = {
  "@context":"https://schema.org",
  "@type":"Service",
  "name": name,
  "url": `https://kriegperformance.de${url}`,
  "serviceType": name,
  "areaServed":{"@type":"AdministrativeArea","name":"Baden‑Württemberg"},
  "provider":{"@id":"https://kriegperformance.de/#organization"}
};
---
<script type="application/ld+json">{JSON.stringify(SVC)}</script>
