---
const id = 'lp-particles';
---
<section class="hero container--wide" style="position:relative;isolation:isolate;background:radial-gradient(1200px 600px at 80% 20%, rgba(22,196,127,0.10), transparent 60%), radial-gradient(800px 400px at 10% 70%, rgba(22,196,127,0.06), transparent 60%)">
  <div id={id} aria-hidden="true" style="position:absolute;inset:0;z-index:-1"></div>
  <div class="container" style="padding-block:clamp(64px,10vw,144px)">
    <div class="badge badge--brand mb-4">
      <svg width="16" height="16" aria-hidden="true"><use href="#icon-location"/></svg>
      Schwäbisch Gmünd · Ostalbkreis · Stuttgart
    </div>
    <h1>Mehr Sichtbarkeit. Mehr Anrufe. Mehr Umsatz – lokal und messbar.</h1>
    <p class="text-muted" style="max-width:70ch">ListingProfis – Timo Krieg. Ihre Digitalagentur in Schwäbisch Gmünd für Local SEO, schnelle Astro‑Websites und starke Online‑Präsenzen.</p>
    <div class="mt-4" style="display:flex;gap:12px;flex-wrap:wrap">
      <a href="tel:+491604365363" class="btn btn--primary btn--lg" aria-label="Jetzt anrufen: +49 160 4365363">
        <svg width="18" height="18" aria-hidden="true"><use href="#icon-phone"/></svg>
        Jetzt anrufen
      </a>
      <a href="/kontakt/" class="btn btn--ghost btn--lg">Kostenloses Erstgespräch</a>
    </div>
  </div>
</section>

<script type="module" client:idle>
  const prefersReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const el = document.getElementById('lp-particles');
  if (!el) return;
  if (prefersReduce) {
    // Fallback: statischer Verlauf (bereits im Section-Style)
  } else {
    (async () => {
      const { tsParticles } = await import('tsparticles-engine');
      const { loadSlim } = await import('tsparticles-slim');
      await loadSlim(tsParticles);
      const isMobile = matchMedia('(max-width: 640px)').matches;
      const density = isMobile ? 30 : 70;
      const container = await tsParticles.load('lp-particles', {
        fpsLimit: 60,
        background: { color: 'transparent' },
        fullScreen: { enable: false },
        detectRetina: true,
        pauseOnBlur: true,
        pauseOnOutsideViewport: true,
        particles: {
          number: { value: density, density: { enable: true, area: 800 } },
          color: { value: ['#16C47F','#0FA56B','#A2EEC9'] },
          shape: { type: 'circle' },
          opacity: { value: 0.22, random: { enable: true, minimumValue: 0.12 } },
          size: { value: { min: 1, max: 3 } },
          links: { enable: true, color: '#16C47F', opacity: 0.12, width: 1, distance: 140 },
          move: { enable: true, speed: { min: 0.3, max: 1.0 }, outModes: { default: 'out' }, attract: { enable: true, rotateX: 2000, rotateY: 1200 } }
        },
        interactivity: {
          detectsOn: 'window',
          events: { onHover: { enable: true, mode: 'repulse' }, resize: true },
          modes: { repulse: { distance: 80, duration: 0.4 } }
        }
      });
      const io = new IntersectionObserver(entries => {
        entries.forEach(e => { if (e.isIntersecting) container?.play(); else container?.pause(); });
      }, { threshold: 0.05 });
      io.observe(el);
    })();
  }
</script>
