---
import { metricsUSPS } from "../data/site";
---
<section class="py-16 border-top border-white/10">
  <div class="max-w-7xl mx-auto px-4">
    <!-- Banner Metrics -->
    <ul class="grid grid-cols-2 sm:grid-cols-4 gap-3" role="list">
      {metricsUSPS.banner_metrics.map((m, i) => (
        <li class="rounded-xl border border-white/10 p-4 text-center bg-brand-card/50">
          <p class={`text-2xl font-extrabold ${i % 3 === 0 ? 'text-brand-orange' : i % 3 === 1 ? 'text-brand-green' : 'text-brand-pink'}`}>{m.number}</p>
          <p class="text-sm text-brand-muted">{m.label}</p>
        </li>
      ))}
    </ul>

    <!-- USPs -->
    <div class="mt-12">
      <span class="text-brand-pink font-bold text-sm tracking-widest uppercase">{metricsUSPS.usps_section.kicker_label}</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold mt-2">{metricsUSPS.usps_section.headline_h2}</h2>
      <ul class="mt-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4" role="list">
        {metricsUSPS.usps_section.cards.map((c, i) => (
          <li class="rounded-xl border border-white/10 p-5 bg-brand-card/50 group will-change-transform transition hover:border-white/30">
            <div class="text-2xl" aria-hidden="true">{c.icon}</div>
            <h3 class={`text-lg font-bold mt-2 transition ${i % 3 === 0 ? 'group-hover:text-brand-orange' : i % 3 === 1 ? 'group-hover:text-brand-green' : 'group-hover:text-brand-pink'}`}>{c.title}</h3>
            <p class="text-sm text-brand-muted mt-1">{c.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
