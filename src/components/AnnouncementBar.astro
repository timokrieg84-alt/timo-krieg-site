---
interface Props {
  enabled?: boolean;
  message: string;
  linkAnchor?: string; // e.g. #menu
  style?: 'primary' | 'accent';
}
const { enabled = true, message, linkAnchor = '#hero', style = 'accent' } = Astro.props as Props;
const bg = style === 'accent' ? '#C62828' : '#2E7D32';
const text = '#FFFFFF';
const storageKey = 'announcementBar:dismissed:' + btoa(encodeURIComponent(message)).slice(0, 16);
---
{enabled && (
  <div id="announcement" class={`w-full text-center px-4 py-2`} style={`background:${bg};color:${text}`}
    set:html={`<style>#announcement a{color:${text};text-decoration:underline}</style>`}
  >
    <div class="mx-auto max-w-[1200px] flex items-center justify-center gap-3">
      <span class="text-sm md:text-base">{message}</span>
      <a href={linkAnchor} class="text-sm md:text-base font-medium underline underline-offset-2">Mehr Infos</a>
      <button id="announcement-close" type="button" aria-label="Schließen" class="ml-2 rounded px-2 py-0.5 text-sm hover:opacity-80 focus:outline-none focus:ring-2 focus:ring-white/70">×</button>
    </div>
  </div>
)}
<script is:inline>
  (function(){
    try {
      const key = '{storageKey}';
      const dismissed = localStorage.getItem(key);
      const el = document.getElementById('announcement');
      const btn = document.getElementById('announcement-close');
      if (dismissed && el) { el.style.display = 'none'; }
      if (btn) {
        btn.addEventListener('click', function(){
          try { localStorage.setItem(key, Date.now().toString()); } catch {}
          const el = document.getElementById('announcement');
          if (el) el.style.display = 'none';
        });
      }
    } catch {}
  })();
</script>
