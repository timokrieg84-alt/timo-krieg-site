---
import siteConfig from "../site-config";
const { features } = siteConfig;

interface Props { pageId?: string }
const { pageId } = Astro.props as Props;

const announcements = features.announcements.filter((a) => {
  const now = new Date();
  const from = new Date(a.activeFrom);
  const until = new Date(a.activeUntil);
  const inRange = now >= from && now <= until;
  const pageOk = pageId ? a.showOnPages?.includes(pageId) : true;
  return a.type === 'modal' && inRange && pageOk;
});
---
{announcements.map((a) => (
  <div id={`ann-${a.id}`} class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 p-4" aria-modal="true" role="dialog">
    <div class="w-full max-w-lg rounded-lg bg-white p-6 shadow-xl ring-1 ring-black/5 dark:bg-gray-900">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white">{a.title}</h2>
          <p class="mt-2 text-sm text-gray-700 dark:text-gray-300">{a.message}</p>
        </div>
        {a.dismissible && (
          <button class="ml-2 inline-flex h-8 w-8 items-center justify-center rounded-md text-gray-500 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800" aria-label="Schließen" data-close={`ann-${a.id}`}>
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        )}
      </div>
      {a.cta && a.cta.external && (
        <div class="mt-4">
          <a href={a.cta.external} target="_blank" rel="noopener" class="inline-flex items-center rounded-md bg-[#C6A667] px-4 py-2 text-sm font-semibold text-[#0F2B46] hover:bg-[#A78B52]">{a.cta.label}</a>
        </div>
      )}
    </div>
    <script>
      const root = document.getElementById('{`ann-${a.id}`}');
      root?.addEventListener('click', (e) => {
        const target = e.target;
        if (target?.dataset?.close === 'ann-{a.id}' || target === root) {
          root.remove();
        }
      });
      const btn = root?.querySelector('[data-close]');
      btn?.addEventListener('click', () => root?.remove());
    </script>
  </div>
))}
