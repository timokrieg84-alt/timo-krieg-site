---
import { siteConfig } from "../../config/site";
const cfg = siteConfig.popups.vacationNotice;
if (!cfg?.enabled) {
  /* no render */
}
---
{cfg?.enabled && (
  <div id="vacation-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/40"></div>
    <div class="relative w-full max-w-lg rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-2xl p-6">
      <div class="flex items-start gap-3">
        <div class="h-10 w-10 rounded-full bg-yellow-100 text-yellow-700 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5"><path d="M12 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1z"/><path d="M4 9a4 4 0 014-4h8a4 4 0 014 4v2H4V9z"/></svg>
        </div>
        <div class="flex-1">
          <h3 class="text-xl font-semibold text-zinc-900 dark:text-zinc-100">{cfg.content.title}</h3>
          <p class="mt-1 text-zinc-700 dark:text-zinc-300">{cfg.content.message}</p>
        </div>
      </div>
      <div class="mt-6 flex justify-end gap-2">
        {cfg.content.buttons.map((b) => (
          b.action === 'dismiss' ? (
            <button data-action="dismiss" class={`px-4 py-2 rounded-md ${b.variant === 'ghost' ? 'bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-100' : 'bg-yellow-400 text-zinc-900'}`}>{b.label}</button>
          ) : (
            <a href={b.target} class={`px-4 py-2 rounded-md ${b.variant === 'primary' ? 'bg-yellow-400 text-zinc-900' : 'bg-zinc-100 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-100'}`}>{b.label}</a>
          )
        ))}
      </div>
    </div>
  </div>
)}
<script>
  (function(){
    const modal = document.getElementById('vacation-modal');
    if (!modal) return;
    const key = 'vacation-dismissed-v1';
    const cfg = %s;

    const now = new Date();
    const start = new Date(cfg.display.showFrom + 'T00:00:00');
    const scheduleStart = new Date(cfg.schedule.start + 'T00:00:00');
    const scheduleEnd = new Date(cfg.schedule.end + 'T23:59:59');

    const pathOk = cfg.display.showOnPages.includes(window.location.pathname);

    try {
      if (localStorage.getItem(key)) return; // dismissed
    } catch (e) {}

    if (now >= start && now <= scheduleEnd && pathOk) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }

    modal.addEventListener('click', (e) => {
      const target = e.target;
      if (target.id === 'vacation-modal' || target.dataset.action === 'dismiss') {
        try { localStorage.setItem(key, '1'); } catch (e) {}
        modal.remove();
      }
    });
  })();
</script>
