---
import { siteConfig } from "../config/site";
const about = siteConfig.content.about;
const spacingY = siteConfig.layout.sectionSpacing.y;
---
<section id={about.id} class="py-16 sm:py-20" style={`padding-top:${spacingY}px;padding-bottom:${spacingY}px`}>
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
    <div>
      <h2 class="text-3xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">{about.title}</h2>
      <p class="mt-3 text-lg text-zinc-700 dark:text-zinc-300">{about.intro}</p>
      <p class="mt-4 text-zinc-600 dark:text-zinc-400">{about.text}</p>

      <ul class="mt-6 space-y-3">
        {about.values.map((v) => (
          <li class="flex items-start gap-3">
            <span class="mt-1 inline-flex h-5 w-5 items-center justify-center rounded-full bg-yellow-100 text-yellow-700">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4"><path d="M9 12l2 2 4-4"/></svg>
            </span>
            <div>
              <p class="font-medium text-zinc-800 dark:text-zinc-200">{v.title}</p>
              <p class="text-sm text-zinc-600 dark:text-zinc-400">{v.detail}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="relative">
      <img src={about.image} alt="Außenbereich des Cafés" class="w-full rounded-2xl shadow-[var(--shadow-elevated)] object-cover" loading="lazy" />
      <div class="pointer-events-none absolute inset-0 rounded-2xl ring-1 ring-inset ring-white/40 dark:ring-white/10"></div>
    </div>
  </div>
</section>
