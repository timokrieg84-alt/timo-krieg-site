---
const { id, title, intro } = Astro.props;
---
<section id={id} class="py-16 md:py-24">
  <div class="container">
    {title && <h2 class="h2 reveal-up">{title}</h2>}
    {intro && <p class="lead mt-3 max-w-[70ch] reveal-up">{intro}</p>}
    <div class="mt-10">
      <slot />
    </div>
  </div>
</section>
