---
const nav = [
  { href: '/leistungen', label: 'Leistungen' },
  { href: '/ueber-uns', label: 'Über uns' },
  { href: '/referenzen', label: 'Referenzen' },
  { href: '/kontakt', label: 'Kontakt' }
];
---
<header class="site-header" role="banner">
  <div class="container">
    <a class="brand" href="/" aria-label="Startseite">
      <img
        class="brand__logo"
        src="/images/logo-gjk.webp"
        alt="Gylsere Januzi Krieg Online Marketing Office – Logo"
        width="180"
        height="120"
        decoding="async"
      />
      <span class="brand__name">Gylsere Januzi Krieg Online Marketing Office</span>
    </a>

    <input id="nav-toggle" type="checkbox" class="nav-toggle" aria-label="Menü öffnen/schließen" />
    <label for="nav-toggle" class="burger" aria-hidden="true">
      <span></span><span></span><span></span>
    </label>

    <nav class="nav" aria-label="Hauptnavigation">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
      <a class="btn btn--primary" href="/kontakt">Kontakt aufnehmen</a>
    </nav>
  </div>
</header>
