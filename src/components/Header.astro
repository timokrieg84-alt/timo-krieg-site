---
import { brand, nav } from "../data/site";
const { logoText } = brand;
---
<header class="sticky top-0 z-50 border-b border-[#F1F5F9] bg-[#FFFFFF]/90 backdrop-blur supports-[backdrop-filter]:bg-[#FFFFFF]/70">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <a href="/" class="flex items-center gap-2" aria-label="Startseite">
        <span class="text-lg font-extrabold tracking-tight text-[#0F172A]">{logoText}</span>
      </a>
      <nav aria-label="Hauptnavigation" class="hidden md:flex items-center gap-6">
        {nav.main
          .filter((item) => item.label !== "Leistungen")
          .map((item) => (
            <a
              href={item.href}
              class="text-sm font-medium text-[#0F172A] hover:text-[#06B6D4] transition-colors"
            >
              {item.label}
            </a>
          ))}
        <div class="relative group">
          <button class="inline-flex items-center gap-1 text-sm font-medium text-[#0F172A] hover:text-[#06B6D4] transition-colors">
            Leistungen
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg>
          </button>
          <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 transition duration-150 absolute right-0 mt-3 w-72 rounded-lg border border-[#F1F5F9] bg-[#FFFFFF] p-2 shadow-xl">
            <div class="grid grid-cols-1 gap-1">
              {nav.services.map((s) => (
                <a href={s.href} class="rounded-md px-3 py-2 text-sm text-[#0F172A] hover:bg-[#F1F5F9] hover:text-[#06B6D4]">
                  {s.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      </nav>
      <div class="md:hidden">
        <details class="group relative">
          <summary class="list-none inline-flex items-center gap-2 px-3 py-2 rounded-md border border-[#F1F5F9] text-[#0F172A] hover:text-[#06B6D4] hover:border-[#06B6D4] cursor-pointer select-none">
            Menü
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg>
          </summary>
          <div class="absolute right-0 mt-2 w-64 rounded-lg border border-[#F1F5F9] bg-[#FFFFFF] p-2 shadow-xl">
            <div class="px-2 py-1 text-xs font-semibold text-[#1E293B]">Navigation</div>
            {nav.main.map((item) => (
              <a
                href={item.href}
                class="block rounded-md px-3 py-2 text-sm text-[#0F172A] hover:bg-[#F1F5F9] hover:text-[#06B6D4]"
              >
                {item.label}
              </a>
            ))}
            <div class="mt-2 px-2 py-1 text-xs font-semibold text-[#1E293B]">Leistungen</div>
            {nav.services.map((s) => (
              <a
                href={s.href}
                class="block rounded-md px-3 py-2 text-sm text-[#0F172A] hover:bg-[#F1F5F9] hover:text-[#06B6D4]"
              >
                {s.label}
              </a>
            ))}
          </div>
        </details>
      </div>
    </div>
  </div>
</header>
