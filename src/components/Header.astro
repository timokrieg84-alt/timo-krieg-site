---
import { site } from "../config/site";
const nav = site.navigation.primary;
const cta = site.navigation.cta;
---
<header class="sticky top-0 z-40 bg-white/80 dark:bg-[#151513]/80 backdrop-blur border-b border-[#E8DFC8] dark:border-[#2a281f]">
  <div class="max-w-[1140px] mx-auto px-4">
    <div class="flex items-center justify-between h-16">
      <a href="#hero" class="flex items-center gap-2 font-semibold text-[#2F2A1F] dark:text-[#f6f0e0] focus:outline-none focus:ring-2 focus:ring-[#F6C945] rounded-md px-1">
        <span class="inline-flex h-6 w-6 rounded-full bg-[#F6C945] ring-2 ring-[#C99E15]" aria-hidden="true"></span>
        <span class="text-base">{site.brand.name}</span>
      </a>
      <nav aria-label="Hauptnavigation" class="hidden md:flex items-center gap-6">
        {nav.map((item) => (
          <a href={item.target} class="text-sm font-medium text-[#8A7F6A] hover:text-[#2F2A1F] dark:text-[#b7ad98] dark:hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-[#F6C945] rounded-md px-1">
            {item.label}
          </a>
        ))}
      </nav>
      <div class="flex items-center gap-2">
        <a href={cta.target} class="hidden sm:inline-flex btn btn-secondary px-3 py-2 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-[#F6C945]">
          {cta.label}
        </a>
        <button id="theme-toggle" type="button" aria-label="Darstellung umschalten" title="Darstellung umschalten" class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-[#E8DFC8] dark:border-[#2a281f] bg-white/60 dark:bg-[#111]/60 text-[#2F2A1F] dark:text-[#f6f0e0] hover:bg-white dark:hover:bg-[#1a1a18] focus:outline-none focus:ring-2 focus:ring-[#F6C945]">
          <svg class="h-5 w-5 block dark:hidden" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3.75a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0V4.5A.75.75 0 0 1 12 3.75Zm0 13.5a3.75 3.75 0 1 0 0-7.5 3.75 3.75 0 0 0 0 7.5ZM5.47 5.47a.75.75 0 0 1 1.06 0l1.06 1.06a.75.75 0 1 1-1.06 1.06L5.47 6.53a.75.75 0 0 1 0-1.06Zm10.94 10.94a.75.75 0 0 1 1.06 0l1.06 1.06a.75.75 0 1 1-1.06 1.06l-1.06-1.06a.75.75 0 0 1 0-1.06ZM3.75 12a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 0 1.5H4.5A.75.75 0 0 1 3.75 12Zm13.5 0a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 0 1.5h-1.5a.75.75 0 0 1-.75-.75ZM6.53 16.53a.75.75 0 0 1 0 1.06l-1.06 1.06a.75.75 0 1 1-1.06-1.06l1.06-1.06a.75.75 0 0 1 1.06 0Zm10.94-10.94a.75.75 0 0 1 0 1.06l-1.06 1.06a.75.75 0 1 1-1.06-1.06l1.06-1.06a.75.75 0 0 1 1.06 0ZM12 18.75a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0V19.5a.75.75 0 0 1 .75-.75Z"/></svg>
          <svg class="h-5 w-5 hidden dark:block" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.752 15.002A9.718 9.718 0 0 1 12.75 21c-5.385 0-9.75-4.365-9.75-9.75a9.718 9.718 0 0 1 5.998-9.002.75.75 0 0 1 .977.95A8.25 8.25 0 0 0 20.8 14.025a.75.75 0 0 1 .951.977Z"/></svg>
        </button>
        <button id="mobile-toggle" class="md:hidden inline-flex h-9 w-9 items-center justify-center rounded-md border border-[#E8DFC8] dark:border-[#2a281f] bg-white/60 dark:bg-[#111]/60 text-[#2F2A1F] dark:text-[#f6f0e0] focus:outline-none focus:ring-2 focus:ring-[#F6C945]" aria-label="Menü öffnen">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>
    <div id="mobile-menu" class="md:hidden hidden pb-4">
      <nav class="flex flex-col gap-2">
        {nav.map((item) => (
          <a href={item.target} class="px-2 py-2 rounded-md text-sm font-medium text-[#8A7F6A] hover:text-[#2F2A1F] dark:text-[#b7ad98] dark:hover:text-white focus:outline-none focus:ring-2 focus:ring-[#F6C945]">
            {item.label}
          </a>
        ))}
        <a href={cta.target} class="btn btn-secondary px-3 py-2 text-sm shadow-sm w-fit">{cta.label}</a>
      </nav>
    </div>
  </div>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const t = document.getElementById('theme-toggle');
      if (t) t.addEventListener('click', () => {
        const root = document.documentElement;
        const isDark = root.classList.toggle('dark');
        try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (e) {}
      });
      const mt = document.getElementById('mobile-toggle');
      const menu = document.getElementById('mobile-menu');
      if (mt && menu) mt.addEventListener('click', () => menu.classList.toggle('hidden'));
      if (menu) menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => menu.classList.add('hidden')));
    });
  </script>
</header>
