---
const telHref = 'tel:+491604365363';
---
<header data-header class="sticky top-0 z-50 border-b border-white/10 bg-brand.surface/70 backdrop-blur-md">
  <div class="container flex items-center justify-between py-3">
    <a href="/" class="flex items-center gap-3 focus-ring" aria-label="Startseite">
      <img src="/assets/logo.svg" alt="Timo Krieg – Digitalagentur Logo" class="w-8 h-8" width="32" height="32" />
      <span class="font-semibold tracking-tight">Timo Krieg</span>
      <span class="text-brand.muted hidden sm:inline">— Digitalagentur</span>
    </a>
    <nav aria-label="Hauptnavigation" class="hidden md:flex items-center gap-6">
      <a href="/" class="focus-ring">Startseite</a>
      <a href="/leistungen" class="focus-ring">Leistungen</a>
      <a href="/ueber-uns" class="focus-ring">Über uns</a>
      <a href="/kontakt" class="focus-ring">Kontakt</a>
    </nav>
    <div class="flex items-center gap-2">
      <a href={telHref} class="btn btn-secondary hidden sm:inline-flex" aria-label="Jetzt anrufen unter +49 160 4365363">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.86 19.86 0 0 1-8.63-3.07A19.5 19.5 0 0 1 3.15 8.81 19.86 19.86 0 0 1 .08 0 2 2 0 0 1 2.05 0h3a2 2 0 0 1 2 1.72c.12.9.32 1.78.59 2.63a2 2 0 0 1-.45 2.11L6.1 7.91a16 16 0 0 0 6 6l1.45-1.09a2 2 0 0 1 2.11-.45c.85.27 1.73.47 2.63.59A2 2 0 0 1 22 16.92z"/></svg>
        Jetzt anrufen
      </a>
      <a href="/kontakt" class="btn btn-primary">Erstgespräch vereinbaren</a>
    </div>
  </div>
</header>
