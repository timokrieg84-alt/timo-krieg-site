---
import site from "@/config/site";
const nav = site.navigation;
const brand = site.brand;
---
<header class="sticky top-0 z-40 backdrop-blur supports-[backdrop-filter]:bg-white/70 bg-white/90 dark:bg-neutral-950/80 border-b border-neutral-100 dark:border-neutral-800">
  <div class="mx-auto max-w-[1200px] px-6">
    <div class="flex h-16 items-center justify-between">
      <a href="/" class="flex items-center gap-2 text-neutral-900 dark:text-white">
        <div class="h-7 w-7 rounded-full" style={`background:${brand.colors.sunflower}`}></div>
        <span class="font-serif font-bold tracking-tight" style="font-family: Merriweather, ui-serif, Georgia, Cambria, Times New Roman, Times, serif;">{brand.logoText}</span>
      </a>
      <nav class="hidden md:flex items-center gap-6">
        {nav.primary.map((item) => (
          <a href={item.href} class="text-sm text-neutral-700 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-white transition-colors">{item.label}</a>
        ))}
        {nav.cta && (
          <a href={nav.cta.href} class="inline-flex items-center rounded-md px-4 py-2 text-sm font-semibold shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-yellow-500"
            style={`background:${site.theme.buttons.primary.bg};color:${site.theme.buttons.primary.text}`}
            onMouseOver={`this.style.background='${site.theme.buttons.primary.hoverBg}'`}
            onMouseOut={`this.style.background='${site.theme.buttons.primary.bg}'`}>
            {nav.cta.label}
          </a>
        )}
        <button id="theme-toggle" class="ml-2 p-2 rounded-md text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800" aria-label="Theme umschalten">
          <svg class="h-5 w-5 hidden dark:block" viewBox="0 0 24 24" fill="currentColor"><path d="M21.64 13A9 9 0 1 1 11 2.36 7 7 0 0 0 21.64 13z"/></svg>
          <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="currentColor"><path d="M6.76 4.84l-1.8-1.79-1.41 1.41 1.79 1.8 1.42-1.42zM1 13h3v-2H1v2zm10 9h2v-3h-2v3zm9-9v-2h-3v2h3zm-2.05 7.95l1.41-1.41-1.79-1.8-1.41 1.41 1.79 1.8zM12 4a1 1 0 0 0 1-1V0h-2v3a1 1 0 0 0 1 1zm-7.95 7.95H1v2h3v-2z"/></svg>
        </button>
      </nav>
      <button class="md:hidden p-2 rounded-md text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800" aria-label="Menü öffnen" onClick="document.getElementById('mobile-nav')?.classList.toggle('hidden')">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>
  <div id="mobile-nav" class="md:hidden hidden border-t border-neutral-100 dark:border-neutral-800 bg-white dark:bg-neutral-950">
    <div class="mx-auto max-w-[1200px] px-6 py-4 space-y-2">
      {nav.primary.map((item) => (
        <a href={item.href} class="block px-2 py-2 rounded-md text-neutral-800 dark:text-neutral-200 hover:bg-neutral-100 dark:hover:bg-neutral-800">{item.label}</a>
      ))}
      {nav.cta && (
        <a href={nav.cta.href} class="mt-2 inline-flex items-center rounded-md px-4 py-2 text-sm font-semibold shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-yellow-500"
          style={`background:${site.theme.buttons.primary.bg};color:${site.theme.buttons.primary.text}`}
          onMouseOver={`this.style.background='${site.theme.buttons.primary.hoverBg}'`}
          onMouseOut={`this.style.background='${site.theme.buttons.primary.bg}'`}>
          {nav.cta.label}
        </a>
      )}
    </div>
  </div>
  <script>
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (e) {}
    });
  </script>
</header>
