---
import { brand, nav, services, colors, contact } from '../data/site';
const pathname = Astro.url.pathname;
---
<header class="sticky top-0 z-50 border-b border-[#94A3B8] bg-[#0B1220]/95 backdrop-blur supports-[backdrop-filter]:bg-[#0B1220]/80 text-[#F8FAFC]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-12 items-center justify-between text-xs text-[#94A3B8]">
      <div class="hidden md:flex gap-6">
        <span class="hover:text-[#F8FAFC] transition-colors">{contact.openingHours}</span>
      </div>
      <div class="flex gap-4 items-center">
        <a href={`tel:${contact.phone.replace(/\s+/g, '')}`} class="hover:text-[#F8FAFC] transition-colors">{contact.phone}</a>
        <a href={`mailto:${contact.email}`} class="hidden sm:inline hover:text-[#F8FAFC] transition-colors">{contact.email}</a>
      </div>
    </div>
  </div>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <a href="/" class="flex items-center gap-3 group">
        <div class="h-8 w-8 rounded bg-[#22D3EE] ring-4 ring-[#22D3EE]/20 group-hover:ring-[#22D3EE]/30 transition"></div>
        <span class="text-lg font-semibold tracking-tight text-[#F8FAFC]">{brand.logoText}</span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-6">
        {nav.main.map((item) => (
          <a href={item.href} class={`text-sm hover:text-[#22D3EE] transition-colors ${pathname === item.href ? 'text-[#22D3EE]' : 'text-[#F8FAFC]/90'}`}>{item.label}</a>
        ))}
        <details class="relative group">
          <summary class="list-none cursor-pointer text-sm text-[#F8FAFC]/90 hover:text-[#22D3EE] transition-colors flex items-center gap-2">
            Leistungen
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.188l3.71-3.957a.75.75 0 111.08 1.04l-4.24 4.52a.75.75 0 01-1.08 0l-4.24-4.52a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg>
          </summary>
          <div class="invisible opacity-0 group-open:visible group-open:opacity-100 transition opacity duration-150 absolute right-0 mt-3 w-[28rem] rounded-xl border border-[#94A3B8]/40 bg-[#1B2A4A] p-3 shadow-2xl">
            <div class="grid grid-cols-2 gap-2">
              {services.map((s) => (
                <a href={`/leistungen/${s.slug}`} class="group/item rounded-lg p-3 hover:bg-[#0B1220]/30 transition-colors">
                  <div class="text-sm font-medium text-[#F8FAFC] group-hover/item:text-[#22D3EE]">{s.title}</div>
                  <div class="text-xs text-[#94A3B8]">{s.short}</div>
                </a>
              ))}
            </div>
          </div>
        </details>
        <a href="#kontakt" class="inline-flex items-center gap-2 rounded-full bg-[#22D3EE] px-4 py-2 text-sm font-semibold text-[#0B1220] hover:bg-[#22D3EE]/90 transition-colors">
          Kostenloses Erstgespräch
        </a>
      </nav>

      <!-- Mobile Hamburger -->
      <details class="lg:hidden">
        <summary class="list-none cursor-pointer text-[#F8FAFC]/90 hover:text-[#F8FAFC]">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-7 w-7">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </summary>
        <div class="mt-3 rounded-xl border border-[#94A3B8]/40 bg-[#1B2A4A] p-4 shadow-xl">
          <nav class="flex flex-col gap-3">
            {nav.main.map((item) => (
              <a href={item.href} class={`text-sm rounded px-3 py-2 hover:bg-[#0B1220]/40 transition-colors ${pathname === item.href ? 'text-[#22D3EE]' : 'text-[#F8FAFC]/90'}`}>{item.label}</a>
            ))}
            <div class="pt-2 text-xs uppercase tracking-wide text-[#94A3B8]">Leistungen</div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
              {services.map((s) => (
                <a href={`/leistungen/${s.slug}`} class="rounded px-3 py-2 text-sm text-[#F8FAFC]/90 hover:bg-[#0B1220]/40 hover:text-[#22D3EE] transition-colors">{s.title}</a>
              ))}
            </div>
            <a href="#kontakt" class="mt-2 inline-flex items-center justify-center gap-2 rounded-full bg-[#22D3EE] px-4 py-2 text-sm font-semibold text-[#0B1220] hover:bg-[#22D3EE]/90 transition-colors">Kostenloses Erstgespräch</a>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>
