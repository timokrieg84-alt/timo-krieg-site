---
import { siteConfig } from "../config/site";
const nav = siteConfig.navigation;
const logo = siteConfig.branding.logo;
---
<header class="sticky top-0 z-50 backdrop-blur bg-white/70 dark:bg-zinc-900/70 border-b border-zinc-200/60 dark:border-zinc-800">
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <a href="/" class="flex items-center gap-3 group">
        <img src={logo.src} alt={logo.alt} width="36" height="36" class="h-9 w-9" />
        <span class="font-semibold tracking-tight text-zinc-800 dark:text-zinc-100 group-hover:text-yellow-600 transition-colors">{siteConfig.project.name}</span>
      </a>

      <nav class="hidden lg:flex items-center gap-8" aria-label="Hauptnavigation">
        {nav.main.map((item) => (
          <a href={item.href} class="text-[15px] text-zinc-700 dark:text-zinc-300 hover:text-zinc-900 hover:underline underline-offset-4 transition-colors">{item.label}</a>
        ))}
      </nav>

      <div class="hidden lg:block">
        <a href={nav.cta.href} class="inline-flex items-center gap-2 rounded-md bg-yellow-400 hover:bg-yellow-500 text-zinc-900 font-medium px-4 py-2 shadow-sm transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5"><path d="M12 22s8-4.5 8-10a8 8 0 10-16 0c0 5.5 8 10 8 10zm0-9a3 3 0 110-6 3 3 0 010 6z"/></svg>
          {nav.cta.label}
        </a>
      </div>

      <!-- Mobile -->
      <div class="lg:hidden">
        <details class="relative">
          <summary class="list-none cursor-pointer inline-flex items-center justify-center rounded-md border border-zinc-200 dark:border-zinc-700 p-2 hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors" aria-label="Menü öffnen">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-zinc-700 dark:text-zinc-300"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6h16.5M3.75 12h16.5m-16.5 6h16.5" /></svg>
          </summary>
          <div class="absolute right-0 mt-2 w-56 rounded-md border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 shadow-lg p-2">
            {nav.main.map((item) => (
              <a href={item.href} class="block px-3 py-2 rounded-md text-[15px] text-zinc-700 dark:text-zinc-300 hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors">{item.label}</a>
            ))}
            <a href={nav.cta.href} class="mt-2 block w-full text-center rounded-md bg-yellow-400 hover:bg-yellow-500 text-zinc-900 font-medium px-4 py-2 shadow-sm transition-colors">{nav.cta.label}</a>
          </div>
        </details>
      </div>
    </div>
  </div>
</header>
