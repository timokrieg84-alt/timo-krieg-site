---
const {
  title = 'Digitalagentur Schwäbisch Gmünd | Local SEO & schnelle Websites',
  description = 'ListingProfis: Lokales SEO, Google Business Profile, Listings & schnelle Astro‑Websites für Schwäbisch Gmünd, Ostalbkreis & Stuttgart. Jetzt anrufen: +49 160 4365363.',
  ogImage = '/assets/og/listingprofis.jpg'
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
---
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:opsz,wght@8..144,400..800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/design-system.css" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website">
    <meta property="og:locale" content="de_DE">
    <meta property="og:site_name" content="ListingProfis – Digitalagentur & Online‑Marketing">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>
    {canonical && <link rel="canonical" href={canonical} />}
    <slot name="head" />
  </head>
  <body>
    <slot name="icons" />
    <slot name="header" />
    <slot />
    <slot name="footer" />
  </body>
</html>
