---
interface Props { title?: string; description?: string }
const { title = 'Gylsere Januzi Krieg Online Marketing Office', description = 'Online-Marketing, SEO, GEO, Ads, Webdesign & mehr.' } = Astro.props;
---
<html lang="de" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="/" />
    <script>try{if(window.matchMedia('(prefers-color-scheme: light)').matches){document.documentElement.classList.remove('dark')}}catch(e){}</script>
    <style is:global>
      :root { --bg: #0b0c10; --fg:#e5e7eb; --muted:#94a3b8; --line:#1f2937; }
      html.dark body{ background:#0b0c10; color:var(--fg); }
      .container{ max-width:1200px; margin:0 auto; padding:2rem 1rem; }
      a{ color:#93c5fd; }
    </style>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap">
    <style is:global>
      body{ font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji","Segoe UI Emoji"; }
      h1{ font-size:2rem; font-weight:700; margin:0 0 1rem; }
      h2{ font-size:1.5rem; font-weight:700; margin:0 0 .5rem; }
      p{ color:var(--fg); opacity:.9 }
    </style>
    <link rel="stylesheet" href="/src/styles/tailwind.css" />
  </head>
  <body>
    <header class="container" role="banner">
      <nav class="flex items-center justify-between">
        <a href="/" class="text-white font-semibold">Gylsere Januzi Krieg</a>
        <div class="flex gap-6 text-sm">
          <a href="/leistungen">Leistungen</a>
          <a href="/kontakt">Kontakt</a>
        </div>
      </nav>
    </header>
    <main role="main">
      <slot />
    </main>
    <footer class="container">
      <p class="muted">© {new Date().getFullYear()} Gylsere Januzi Krieg Online Marketing Office</p>
    </footer>
  </body>
</html>
