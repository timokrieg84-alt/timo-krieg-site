---
import "../styles/tailwind.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Gylsere Januzi Krieg Online Marketing Office",
  description = "Online-Marketing, SEO, GEO, Ads, Webdesign, Social & mehr."
} = Astro.props as Props;
---

<!doctype html>
<html lang="de" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.ico" />
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />}
  </head>
  <body class="bg-slate-950 text-slate-300 antialiased min-h-screen">
    <header class="border-b border-slate-800">
      <div class="mx-auto max-w-7xl px-4 py-4 flex items-center justify-between">
        <a href="/" class="text-white font-semibold tracking-tight">Gylsere Januzi Krieg</a>
        <nav class="hidden md:flex items-center gap-6">
          <a href="/leistungen" class="text-slate-300 hover:text-white">Leistungen</a>
          <a href="/kontakt" class="text-slate-300 hover:text-white">Kontakt</a>
        </nav>
      </div>
    </header>

    <main id="main" class="mx-auto max-w-7xl px-4 py-10">
      <slot />
    </main>

    <footer class="border-t border-slate-800">
      <div class="mx-auto max-w-7xl px-4 py-10 text-sm text-slate-500">
        © {new Date().getFullYear()} Gylsere Januzi Krieg Online Marketing Office
      </div>
    </footer>
  </body>
</html>
