---
export interface Props {
  title?: string;
  description?: string;
  path?: string;
  ogImage?: string;
  jsonLd?: any[];
}
const { title, description, path = "/", ogImage, jsonLd = [] } = Astro.props;
const canonical = new URL(path, Astro.site);
---
<!doctype html>
<html lang="de-DE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? "Timo Krieg – Online Marketingbüro"}</title>
    <meta name="description" content={description ?? "Online‑Marketing: SEO, Google Ads, Landingpages, CRO & Analytics – klar, messbar, senior."} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Timo Krieg – Online Marketingbüro" />
    <meta property="og:title" content={title ?? "Timo Krieg – Online Marketingbüro"} />
    <meta property="og:description" content={description ?? "SEO, SEA, Webdesign & Analytics für KMU."} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage ?? "https://www.example.com/images/og-default.jpg"} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Manrope:wght@600;700&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/design-system.css" />
    {jsonLd?.map((obj) => <script type="application/ld+json">{JSON.stringify(obj)}</script>)}
  </head>
  <body>
    <a class="sr-only" href="#main">Zum Inhalt springen</a>
    <import Header from "../components/Header.astro" />
    <Header />
    <main id="main">
      <slot />
    </main>
    <import Footer from "../components/Footer.astro" />
    <Footer />
  </body>
</html>
