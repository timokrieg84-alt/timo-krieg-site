---
export interface Props { title?: string; description?: string }
const { title = "Gylsere Januzi Krieg Online Marketing Office", description = "" } = Astro.props as Props;
---
<html lang="de" class="h-full" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossOrigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style is:global>
      :root{--bg:#0b0b0e;--fg:#f8fafc}
      html,body{height:100%}
      body{margin:0;background:var(--bg);color:var(--fg);font-family:Inter,system-ui,Segoe UI,Roboto,Helvetica,Arial,sans-serif;}
    </style>
    <link rel="stylesheet" href="/src/styles/tailwind.css" />
  </head>
  <body class="min-h-full antialiased">
    <header class="container-px py-6">
      <nav class="flex items-center justify-between gap-4">
        <a href="/" class="font-semibold tracking-tight">Gylsere Januzi Krieg</a>
        <ul class="flex items-center gap-5 text-sm text-zinc-300">
          <li><a href="/leistungen" class="hover:text-white">Leistungen</a></li>
          <li><a href="/kontakt" class="hover:text-white">Kontakt</a></li>
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="container-px py-10 text-sm text-zinc-400">© {new Date().getFullYear()} Gylsere Januzi Krieg Online Marketing Office</footer>
  </body>
</html>
