---
import siteConfig from "../site-config";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AnnouncementBar from "../components/AnnouncementBar.astro";
import CookieConsent from "../components/CookieConsent.astro";
import "../styles/global.css";

const { seo, site } = siteConfig;
const title = seo?.title ?? site?.name;
const description = seo?.description ?? site?.tagline;
const og = seo?.openGraph ?? {};
---
<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={(seo?.keywords || []).join(", ")} />
    <meta property="og:type" content={og.type || 'website'} />
    <meta property="og:site_name" content={og.siteName || site.name} />
    <meta property="og:locale" content={og.locale || 'de_DE'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#F2C94C" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+Pro:wght@600;700&display=swap" rel="stylesheet" />

    <script is:inline>
      const stored = localStorage.getItem('theme');
      const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (stored === 'dark' || (!stored && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen font-[Inter] text-[var(--color-text)] bg-[var(--color-surface)] antialiased">
    {siteConfig.features?.announcementBar?.enabled && (
      <AnnouncementBar />
    )}
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    {siteConfig.features?.cookieConsent?.enabled && (
      <CookieConsent />
    )}
  </body>
</html>
