---
import { site } from "../config/site";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SkipLinks from "../components/SkipLinks.astro";

const heroSection = site.sections.find((s: any) => s.id === "hero") as any;
const heroSrc = heroSection?.content?.media?.src ?? null;
const preloadHero = site.features.performance.preloadHeroMedia && heroSrc;
---
<!DOCTYPE html>
<html lang={site.meta.language} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.meta.title}</title>
    <meta name="description" content={site.meta.description} />
    <meta name="keywords" content={site.meta.keywords.join(", ")} />
    <link rel="canonical" href={site.meta.canonicalPath} />

    <meta property="og:title" content={site.meta.og.title} />
    <meta property="og:description" content={site.meta.og.description} />
    {site.meta.og.image && <meta property="og:image" content={site.meta.og.image} />}
    <meta name="theme-color" content={site.theme.colors.primary} />

    {preloadHero && (
      <link rel="preload" as="image" href={heroSrc} imagesrcset={heroSrc} fetchpriority="high" />
    )}

    <style is:global>{`
      :root {
        --color-primary: ${site.theme.colors.primary};
        --color-primary-dark: ${site.theme.colors.primaryDark};
        --color-secondary: ${site.theme.colors.secondary};
        --color-accent: ${site.theme.colors.accent};
        --color-bg: ${site.theme.colors.background};
        --color-surface: ${site.theme.colors.surface};
        --color-text: ${site.theme.colors.text};
        --color-muted: ${site.theme.colors.muted};
        --color-border: ${site.theme.colors.border};
        --radius-sm: ${site.theme.radius.sm}px;
        --radius-md: ${site.theme.radius.md}px;
        --radius-lg: ${site.theme.radius.lg}px;
        --radius-xl: ${site.theme.radius.xl}px;
        --shadow-sm: ${site.theme.shadows.sm};
        --shadow-md: ${site.theme.shadows.md};
        --shadow-lg: ${site.theme.shadows.lg};
        --container-w: ${site.theme.layout.containerWidth}px;
        --section-space: ${site.theme.layout.sectionSpacing}px;
        --grid-gap: ${site.theme.layout.gridGap}px;
      }
      html { color-scheme: light dark; }
      body { font-family: ${site.theme.typography.fontFamily}; font-size: ${site.theme.typography.baseSize}px; line-height: ${site.theme.typography.lineHeights.body}; background: var(--color-bg); color: var(--color-text); }
      .container { max-width: var(--container-w); margin-inline: auto; padding-inline: 1rem; }
      .section { padding-block: calc(var(--section-space) * 1px); }
      .card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); }
      .btn { display: inline-flex; align-items: center; gap: .5rem; font-weight: 600; border-radius: var(--radius-md); transition: all .2s ease; }
      .btn-primary { background: ${site.theme.buttons.primary.bg}; color: ${site.theme.buttons.primary.text}; }
      .btn-primary:hover { background: ${site.theme.buttons.primary.hoverBg}; }
      .btn-secondary { background: ${site.theme.buttons.secondary.bg}; color: ${site.theme.buttons.secondary.text}; }
      .btn-secondary:hover { background: ${site.theme.buttons.secondary.hoverBg}; }
      .focus-ring:focus-visible { outline: 2px solid ${site.theme.colors.primaryDark}; outline-offset: 2px; }
      .tag { border: 1px solid var(--color-border); padding: .125rem .5rem; border-radius: 9999px; font-size: 0.75rem; color: var(--color-muted); }
      @media (prefers-color-scheme: dark) {
        :root:not(.force-light) {
          --color-bg: #0b0b0a;
          --color-surface: #151513;
          --color-text: #f6f0e0;
          --color-muted: #b7ad98;
          --color-border: #2a281f;
          --shadow-sm: 0 1px 2px rgba(0,0,0,.5);
          --shadow-md: 0 6px 16px rgba(0,0,0,.55);
          --shadow-lg: 0 12px 28px rgba(0,0,0,.6);
        }
      }
      .prose-custom :where(h1,h2,h3){ line-height: ${site.theme.typography.lineHeights.heading}; }
    `}</style>

    <script is:inline>{`
      (function(){
        try {
          const stored = localStorage.getItem('theme');
          const useDark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (useDark) document.documentElement.classList.add('dark');
        } catch(e) {}
      })();
    `}</script>
  </head>
  <body class="antialiased selection:bg-[#F6C945]/40 selection:text-[#2F2A1F]">
    {site.accessibility.skipLinks && <SkipLinks />}
    <Header />
    <main id="main" class="min-h-[60vh]">
      <slot />
    </main>
    <Footer />
  </body>
</html>
