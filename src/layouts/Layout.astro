---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { brand, nav, projectInfo } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}
const { title = projectInfo.tagline, description = projectInfo.tagline } = Astro.props as Props;
---
<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} – {brand.logoText}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossOrigin="" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-[#FFFFFF] text-[#0F172A] antialiased [font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,'Apple Color Emoji','Segoe UI Emoji']">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 bg-[#06B6D4] text-[#FFFFFF] px-3 py-2 rounded">Zum Inhalt springen</a>
    <Header />
    <main id="main" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <slot />
    </main>
    <Footer />
    <script>
      // Kleine Erweiterung: Schließen des mobilen Menüs bei Navigation
      document.addEventListener('click', (e) => {
        const details = document.querySelector('header details');
        if (!details) return;
        const target = e.target;
        if (target instanceof HTMLElement && target.tagName === 'A' && details.open) {
          details.open = false;
        }
      });
    </script>
  </body>
</html>
