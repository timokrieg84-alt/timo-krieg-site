---
import { brand, colors, nav, sections, services, projectInfo } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = `${projectInfo.name} – ${projectInfo.tagline}` , description = projectInfo.tagline } = Astro.props as Props;
---
<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={colors.primary} />
  </head>
  <body class="min-h-screen bg-[#F8FAFC] text-[#1F2937] antialiased">
    <a href={`/#${sections.content?.id ?? sections.leistungen.id}`} class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 z-[100] bg-white px-3 py-2 rounded-md border border-[#E5E7EB] shadow">Zum Inhalt springen</a>

    <header class="sticky top-0 z-50 w-full border-b border-[#E5E7EB] bg-white/80 backdrop-blur supports-[backdrop-filter]:bg-white/60">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between">
          <a href="/" class="flex items-center gap-2 font-semibold tracking-tight text-lg sm:text-xl text-[#0F172A] hover:text-[#0A84FF] transition-colors" aria-label={brand.logoText}>
            <span class="inline-flex h-8 w-8 items-center justify-center rounded bg-[#0A84FF] text-white font-bold">N</span>
            <span class="whitespace-nowrap">{brand.logoText}</span>
          </a>

          <nav class="hidden lg:flex items-center gap-8" aria-label="Hauptnavigation">
            {nav.main.map((item) => (
              <a href={item.href} class="text-sm font-medium text-[#1F2937] hover:text-[#0A84FF] transition-colors">{item.label}</a>
            ))}
            <div class="relative group">
              <button class="text-sm font-medium text-[#1F2937] hover:text-[#0A84FF] transition-colors inline-flex items-center gap-2" aria-haspopup="true" aria-expanded="false">
                Leistungen
                <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.25a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z" clip-rule="evenodd"/></svg>
              </button>
              <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-150 absolute left-1/2 -translate-x-1/2 mt-3 w-[44rem] max-w-[90vw] rounded-xl border border-[#E5E7EB] bg-white shadow-xl p-6 grid grid-cols-2 gap-4">
                {services.map((s) => (
                  <div class="flex flex-col gap-2">
                    <a href={`/leistungen/${s.slug}`} class="font-semibold text-[#0F172A] hover:text-[#0A84FF]">{s.name}</a>
                    <p class="text-sm text-[#374151]">{s.teaser}</p>
                    <div class="flex gap-3">
                      <a href={`/#${s.anchor}`} class="text-xs font-medium text-[#0A84FF] hover:underline">Zum Überblick</a>
                      <a href={`/leistungen/${s.slug}`} class="text-xs font-medium text-[#0A84FF] hover:underline">Zur Detailseite</a>
                    </div>
                  </div>
                ))}
              </div>
            </div>
            <a href={`/#${sections.contact.id}`} class="inline-flex items-center justify-center rounded-md bg-[#0A84FF] px-4 py-2 text-sm font-semibold text-white shadow hover:bg-[#0A84FF]/90 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0A84FF] focus-visible:ring-offset-2">Kontakt</a>
          </nav>

          <div class="lg:hidden">
            <button id="menu-btn" class="inline-flex items-center justify-center rounded-md border border-[#E5E7EB] bg-white p-2 text-[#0F172A] hover:bg-[#F8FAFC] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0A84FF]" aria-label="Menü öffnen" aria-controls="mobile-menu" aria-expanded="false">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
            </button>
          </div>
        </div>
      </div>

      <div id="mobile-menu" class="lg:hidden hidden border-t border-[#E5E7EB] bg-white">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-4 space-y-4">
          <div class="grid grid-cols-1 gap-2">
            {nav.main.map((item) => (
              <a href={item.href} class="block rounded-md px-3 py-2 text-base font-medium text-[#1F2937] hover:bg-[#F8FAFC]">{item.label}</a>
            ))}
          </div>
          <div class="pt-2 border-t border-[#E5E7EB]">
            <p class="px-3 py-1 text-xs font-semibold uppercase tracking-wide text-[#6B7280]">Leistungen</p>
            <div class="mt-2 grid grid-cols-1 gap-1">
              {services.map((s) => (
                <div class="flex items-center justify-between rounded-md px-3 py-2 hover:bg-[#F8FAFC]">
                  <a href={`/#${s.anchor}`} class="text-sm font-medium text-[#0F172A]">{s.name}</a>
                  <a href={`/leistungen/${s.slug}`} class="text-xs font-semibold text-[#0A84FF] hover:underline">Details</a>
                </div>
              ))}
            </div>
          </div>
          <a href={`/#${sections.contact.id}`} class="inline-flex w-full items-center justify-center rounded-md bg-[#0A84FF] px-4 py-2 text-sm font-semibold text-white shadow hover:bg-[#0A84FF]/90">Kontakt</a>
        </div>
      </div>
    </header>

    <main id="main" class="relative">
      <slot />
    </main>

    <footer class="mt-24 border-t border-[#E5E7EB] bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
        <div class="space-y-4">
          <a href="/" class="flex items-center gap-2 font-semibold tracking-tight text-lg text-[#0F172A] hover:text-[#0A84FF]">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded bg-[#0A84FF] text-white font-bold">N</span>
            <span>{brand.logoText}</span>
          </a>
          <p class="text-sm text-[#374151] max-w-xs">{projectInfo.tagline}</p>
          <div class="text-sm text-[#374151]">
            <p>{projectInfo.owner}</p>
            <p>{projectInfo.street}</p>
            <p>{projectInfo.zip} {projectInfo.city}</p>
          </div>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-[#0F172A]">Seiten</h3>
          <ul class="mt-4 space-y-2">
            {nav.main.map((item) => (
              <li><a href={item.href} class="text-sm text-[#1F2937] hover:text-[#0A84FF]">{item.label}</a></li>
            ))}
          </ul>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-[#0F172A]">Leistungen</h3>
          <ul class="mt-4 space-y-2">
            {services.map((s) => (
              <li class="flex items-center gap-3">
                <a href={`/#${s.anchor}`} class="text-sm text-[#1F2937] hover:text-[#0A84FF]">{s.name} – Überblick</a>
                <a href={`/leistungen/${s.slug}`} class="text-xs font-semibold text-[#0A84FF] hover:underline">Details</a>
              </li>
            ))}
          </ul>
        </div>

        <div class="space-y-3">
          <h3 class="text-sm font-semibold text-[#0F172A]">Kontakt</h3>
          <p class="text-sm text-[#374151]">{projectInfo.email}<br />{projectInfo.phone}</p>
          <a href={`/#${sections.contact.id}`} class="inline-flex items-center justify-center rounded-md bg-[#0A84FF] px-4 py-2 text-sm font-semibold text-white shadow hover:bg-[#0A84FF]/90">Projekt anfragen</a>
          <div class="pt-4 text-xs text-[#6B7280]">
            <a href="/impressum" class="hover:text-[#0A84FF]">Impressum</a>
            <span class="px-2">•</span>
            <a href="/datenschutz" class="hover:text-[#0A84FF]">Datenschutz</a>
          </div>
        </div>
      </div>
      <div class="border-t border-[#E5E7EB] bg-[#F8FAFC]">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#6B7280]">
          <p>© {new Date().getFullYear()} {projectInfo.owner}. Alle Rechte vorbehalten.</p>
          <div class="flex items-center gap-4">
            <a href="/impressum" class="hover:text-[#0A84FF]">Impressum</a>
            <a href="/datenschutz" class="hover:text-[#0A84FF]">Datenschutz</a>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const btn = document.getElementById('menu-btn');
        const menu = document.getElementById('mobile-menu');
        if (btn && menu) {
          btn.addEventListener('click', () => {
            menu.classList.toggle('hidden');
            const expanded = btn.getAttribute('aria-expanded') === 'true';
            btn.setAttribute('aria-expanded', (!expanded).toString());
          });
        }
      });
    </script>
  </body>
</html>
