---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { brand, colors, nav, sections } from "../data/site";
const { title = brand.logoText, description = brand.logoText } = Astro.props as {
  title?: string;
  description?: string;
};
---
<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='0.9em' font-size='90'%3E%F0%9F%8C%84%3C/text%3E%3C/svg%3E" />
  </head>
  <body class="min-h-screen bg-[#FFFFFF] text-[#0F172A] antialiased">
    <Header />
    <main id={sections.hero} class="relative">
      <slot />
    </main>
    <Footer />
  </body>
</html>
