---
import { brand, colors, nav, services } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}
const { title = brand.name + " – " + brand.tagline, description = brand.tagline } = Astro.props as Props;
const allServices = services;
---
<html lang="de" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={colors.primary} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class={`min-h-screen bg-[${colors.background}] text-[${colors.text}] antialiased`} style={`font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, Apple Color Emoji, Segoe UI Emoji;`}>
    <header class="sticky top-0 z-50 backdrop-blur supports-[backdrop-filter]:bg-white/60 bg-white/90 border-b border-[${colors.muted}]/20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between">
          <a href="/" class="flex items-center gap-3 group" aria-label={brand.name}>
            <div class={`h-8 w-8 rounded bg-[${colors.primary}] ring-2 ring-[${colors.gold}] transition-transform group-hover:rotate-6`}></div>
            <div class="flex flex-col leading-tight">
              <span class={`text-sm tracking-[0.2em] font-semibold text-[${colors.primary}]`}>{brand.logoText}</span>
              <span class={`text-xs text-[${colors.muted}]`}>{brand.tagline}</span>
            </div>
          </a>
          <nav class="hidden lg:flex items-center gap-8" aria-label="Hauptnavigation">
            {nav.main.map((item) => (
              <a href={item.href} class={`text-sm font-medium text-[${colors.text}]/80 hover:text-[${colors.text}] transition-colors`}>{item.label}</a>
            ))}
            <div class="relative group">
              <button class={`text-sm font-medium text-[${colors.text}]/80 hover:text-[${colors.text}] transition-colors inline-flex items-center gap-2`} aria-haspopup="true" aria-expanded="false">
                Leistungen
                <svg width="16" height="16" viewBox="0 0 20 20" fill="none" class={`text-[${colors.muted}]`}><path d="M5 7l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <div class={`invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all absolute left-1/2 -translate-x-1/2 mt-3 w-[720px] max-w-[90vw] bg-white border border-[${colors.muted}]/20 shadow-xl rounded-xl p-4 grid grid-cols-2 md:grid-cols-3 gap-2`}>
                {allServices.map((s) => (
                  <a href={`/leistungen/${s.slug}`} class={`rounded-lg px-3 py-2 hover:bg-[${colors.background}] focus:bg-[${colors.background}] transition-colors text-sm text-[${colors.text}]/80 hover:text-[${colors.text}]`}>{s.title}</a>
                ))}
              </div>
            </div>
            <a href="/#kontakt" class={`inline-flex items-center gap-2 rounded-full bg-[${colors.primary}] px-4 py-2 text-white text-sm font-semibold shadow hover:shadow-md transition-shadow border border-[${colors.gold}]`}>Kontakt</a>
          </nav>
          <button id="mobileMenuBtn" class={`lg:hidden inline-flex items-center justify-center rounded-md p-2 text-[${colors.text}]/70 hover:text-[${colors.text}] hover:bg-[${colors.background}] focus:outline-none focus:ring-2 focus:ring-[${colors.gold}]`} aria-controls="mobileMenu" aria-expanded="false">
            <span class="sr-only">Menü öffnen</span>
            <svg class="h-6 w-6" stroke="currentColor" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
        </div>
      </div>
      <div id="mobileMenu" class={`lg:hidden origin-top scale-y-0 opacity-0 pointer-events-none transition-all duration-200 border-t border-[${colors.muted}]/20 bg-white`}>
        <div class="space-y-1 px-4 py-4">
          {nav.main.map((item) => (
            <a href={item.href} class={`block rounded-md px-3 py-2 text-base font-medium text-[${colors.text}]/80 hover:bg-[${colors.background}] hover:text-[${colors.text}]`}>{item.label}</a>
          ))}
          <details class="group">
            <summary class={`cursor-pointer rounded-md px-3 py-2 text-base font-medium text-[${colors.text}]/80 hover:bg-[${colors.background}] hover:text-[${colors.text}]`}>Leistungen</summary>
            <div class="mt-2 grid grid-cols-1 gap-1">
              {allServices.map((s) => (
                <a href={`/leistungen/${s.slug}`} class={`block rounded-md px-3 py-2 text-sm text-[${colors.text}]/80 hover:bg-[${colors.background}] hover:text-[${colors.text}]`}>{s.title}</a>
              ))}
            </div>
          </details>
          <a href="/#kontakt" class={`mt-2 inline-flex items-center gap-2 rounded-full bg-[${colors.primary}] px-4 py-2 text-white text-sm font-semibold border border-[${colors.gold}]`}>Kontakt</a>
        </div>
      </div>
    </header>

    <main class="min-h-[60vh]">
      <slot />
    </main>

    <footer class={`mt-24 border-t border-[${colors.muted}]/20 bg-white`}>
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16 grid grid-cols-1 md:grid-cols-4 gap-12">
        <div class="space-y-3">
          <div class="flex items-center gap-3">
            <div class={`h-8 w-8 rounded bg-[${colors.primary}] ring-2 ring-[${colors.gold}]`}></div>
            <div class="flex flex-col leading-tight">
              <span class={`text-sm tracking-[0.2em] font-semibold text-[${colors.primary}]`}>{brand.logoText}</span>
              <span class={`text-xs text-[${colors.muted}]`}>{brand.tagline}</span>
            </div>
          </div>
          <p class={`text-sm text-[${colors.muted}]`}>© {new Date().getFullYear()} {brand.name}. Alle Rechte vorbehalten.</p>
        </div>
        <div>
          <h3 class={`text-xs font-semibold uppercase tracking-wider text-[${colors.muted}]`}>Seiten</h3>
          <ul class="mt-3 space-y-2">
            {nav.main.map((item) => (
              <li><a href={item.href} class={`text-sm text-[${colors.text}]/80 hover:text-[${colors.text}]`}>{item.label}</a></li>
            ))}
            {nav.legal.map((item) => (
              <li><a href={item.href} class={`text-sm text-[${colors.text}]/80 hover:text-[${colors.text}]`}>{item.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class={`text-xs font-semibold uppercase tracking-wider text-[${colors.muted}]`}>Leistungen</h3>
          <ul class="mt-3 grid grid-cols-1 gap-2">
            {allServices.map((s) => (
              <li><a href={`/leistungen/${s.slug}`} class={`text-sm text-[${colors.text}]/80 hover:text-[${colors.text}]`}>{s.title}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class={`text-xs font-semibold uppercase tracking-wider text-[${colors.muted}]`}>Kontakt</h3>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a href="/#kontakt" class={`hover:text-[${colors.text}] text-[${colors.text}]`}>Formular</a></li>
            <li><a href="tel:+491756372395" class={`hover:text-[${colors.text}] text-[${colors.text}]`}>+49 175 6372395</a></li>
            <li><a href="mailto:gjanuzikrieg@gmail.com" class={`hover:text-[${colors.text}] text-[${colors.text}]`}>gjanuzikrieg@gmail.com</a></li>
          </ul>
        </div>
      </div>
    </footer>

    <script is:inline>
      const btn = document.getElementById('mobileMenuBtn');
      const menu = document.getElementById('mobileMenu');
      if (btn && menu) {
        btn.addEventListener('click', () => {
          const expanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', (!expanded).toString());
          menu.classList.toggle('opacity-0');
          menu.classList.toggle('pointer-events-none');
          menu.classList.toggle('scale-y-0');
        });
      }
    </script>
  </body>
</html>
