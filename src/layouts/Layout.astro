---
const { title = "Gylsere Januzi - online marketing office", description = "Online Marketing Office – Sichtbarkeit bei Google, ChatGPT und Social. Messbar, persönlich, ohne Blabla.", url = Astro.url.pathname } = Astro.props;
const canonical = new URL(url, Astro.site).toString();
---
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Gylsere Januzi - Online Marketing Office" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/src/styles/global.css" />
    <script type="application/ld+json">
      {JSON.stringify({
        "@context":"https://schema.org",
        "@type":"Organization",
        "name":"Gylsere Januzi - Online Marketing Office",
        "url": Astro.site?.origin || "https://timo-krieg-site.vercel.app",
        "telephone":"+49 175 6372395",
        "sameAs":[
          "tel:+491756372395"
        ]
      })}
    </script>
  </head>
  <body>
    <slot name="header" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
