---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Section from "@/components/Section.astro";
import Card from "@/components/Card.astro";
import CTA from "@/components/CTA-Bar.astro";
import Footer from "@/components/Footer.astro";
import HeadSEO from "@/components/HeadSEO.astro";
const meta = {
  title: "Prozess & Methode | Von Audit zu Wachstum in 90 Tagen",
  description: "Klarer Fahrplan: Audit, Roadmap, Setup, Sprints. Transparente KPIs, sauberes Tracking, schneller ROI für KMU, Praxen & B2B.",
  url: "https://example.com/prozess/",
  canonical: "https://example.com/prozess/",
  image: "/images/hero-bg.webp",
  type: "article"
};
---
<html lang="de" class="dark">
  <head>
    <HeadSEO {...meta} />
  </head>
  <body>
    <Layout title={meta.title} description={meta.description}>
      <Fragment slot="nav"><Navbar /></Fragment>
      <Section id="prozess" title="In 6 Schritten zu mehr Sichtbarkeit, Anfragen und Wachstum" intro="Strukturiert, transparent, skalierbar.">
        <div class="grid md:grid-cols-3 gap-6">
          <Card title="1) Analyse & Zielbild" text="Geschäftsmodell, Zielgruppen, Wettbewerb, Status‑Quo. Messbare Ziele: Leads, Termine, Anfragen." />
          <Card title="2) Strategie & Fahrplan" text="Positionierung, Angebotsstruktur, SEO‑/Content‑Plan. Roadmap über alle Kanäle." />
          <Card title="3) UX & Design" text="Nutzerführung für Conversion: klare Wege, klare Botschaften. Barrierearm, mobil‑optimiert." />
          <Card title="4) Entwicklung mit Astro" text="High‑Performance‑Setup, saubere Codebasis, Core Web Vitals. Headless‑/CMS‑Integration." />
          <Card title="5) Tracking, DSGVO & Launch" text="Consent‑Management, Data Layer, Events, KPIs. Qualitätssicherung und Go‑Live." />
          <Card title="6) Skalierung & Reporting" text="SEO‑Feintuning, Performance‑Kampagnen, A/B‑Tests. Monatliche Reports, Maßnahmenpläne." />
        </div>
      </Section>
      <CTA />
      <Fragment slot="footer"><Footer /></Fragment>
    </Layout>
  </body>
</html>
