---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Prozess from '../components/ProzessTimeline.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
const title = 'Prozess | Messbares Performance‑Marketing | GJK';
const description = 'Von Audit bis Skalierung: klarer Prozess für SEO, Local SEO, Google Ads, GEO & E‑Com. Tracking DSGVO‑konform.';
const canonical = 'https://online-marketing-office.de/prozess';
---
<Base {title} {description} {canonical}>
  <Header />
  <main id="main">
    <section class="section container flow">
      <h1>Prozess</h1>
      <p class="text-muted">Strukturiert. Transparent. Effizient.</p>
    </section>
    <Prozess />
    <Contact />
  </main>
  <Footer />
</Base>
