---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/Section.astro";
---
<Layout title="Gylsere Januzi - online marketing office">
  <Fragment slot="header"><Header /></Fragment>
  <section class="py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <h1 class="text-4xl font-bold text-white tracking-tight">Exzellenz & Digitale Präsenz</h1>
    <p class="text-gray-400 mt-4 max-w-2xl">Wir arbeiten strukturiert, messbar und ohne Buzzwords.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/kontakt" class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-[#FF6A00] text-white font-medium hover:bg-[#FF6A00]/90 transition-colors">Kostenloses Erstgespräch</a>
      <a href="tel:+491756372395" class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-[#00C853] text-gray-950 font-semibold hover:bg-[#00C853]/90 transition-colors">+49 175 6372395</a>
    </div>
  </section>
  <Fragment slot="footer"><Footer /></Fragment>
</Layout>
