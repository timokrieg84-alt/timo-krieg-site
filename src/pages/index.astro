---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ResultsAndWorkflow from '../components/ResultsAndWorkflow.astro';
import Funnel from '../components/Funnel.astro';
import Footer from '../components/Footer.astro';

const services = [
  { id: "seo", title: "SEO", desc: "Technisches SEO, Content-Strategie und Backlinks – damit Ihre Kunden Sie finden.", url: "/leistungen/seo" },
  { id: "seo-regio", title: "SEO-Regio (Umland-Dominanz)", desc: "50 Satelliten-Websites für absolute Umland-Dominanz ohne Ihre Hauptseite anzutasten. (250 € mtl.)", url: "/leistungen/seo-regio" },
  { id: "google-ads", title: "Google Ads", desc: "Position 1 auf Google mit exklusivem Klickschutz gegen Mitbewerber-Fehlklicks.", url: "/leistungen/google-ads" },
  { id: "geo", title: "GEO (AI-Search & ChatGPT)", desc: "Präsenz in ChatGPT, Perplexity & Google AI Overviews durch Entity-SEO.", url: "/leistungen/geo" },
  { id: "webdesign", title: "Webdesign & E-Commerce", desc: "High-Speed Plattformen, Verkaufspsychologie und Core Web Vitals Performance.", url: "/leistungen/webdesign" },
  { id: "terminbuchung", title: "Online-Terminvereinbarungen", desc: "Schlüsselfertige Integration von Jameda & Doctolib für 24/7 Buchungen.", url: "/leistungen/terminbuchung" },
  { id: "marketing", title: "Marketing", desc: "Ganzheitliche Strategien aus Content, Performance und Analytics.", url: "/leistungen/marketing" },
  { id: "ai-automation", title: "AI & Automation", desc: "Custom-AI-Agenten und automatisierte n8n Workflows für deinen Betrieb.", url: "/leistungen/ai-automation" },
  { id: "branding", title: "Branding", desc: "Brand DNA, Logo-Design und durchdachte Markenstrategien.", url: "/leistungen/branding" },
  { id: "social-media", title: "Social Media", desc: "Content-Produktion und Paid Ads auf Instagram, TikTok & LinkedIn.", url: "/leistungen/social-media" },
  { id: "reputation", title: "Reputation & Bewertungen", desc: "Automatisierte 5-Sterne-Bewertungen und aktiver Lösch-Schutz gegen Rufmord.", url: "/leistungen/reputation" },
  { id: "praxis-tv", title: "Praxis-TV / Display-Systeme", desc: "Visuelle Wartezimmer-Präsentationen zur iGeL-Förderung für Ärzte.", url: "/leistungen/praxis-tv" },
  { id: "programmierung", title: "Code-Exzellenz & Programmierung", desc: "Custom Software, APIs, Logos und maßgeschneiderte Programmierungen.", url: "/leistungen/programmierung" },
  { id: "factoring", title: "Premium-Factoring", desc: "100% Insolvenzschutz und Geld auf dem Konto innerhalb von 24–48 Stunden.", url: "/leistungen/factoring" }
];
---

<Layout title="Gylsere Januzi | Digitale Exzellenz Schwäbisch Gmünd">
  <Header />

  <section class="py-24 max-w-7xl mx-auto px-4 text-center" data-animate="rise">
    <span class="text-emerald-400 font-bold text-sm tracking-widest uppercase">— FACHBETRIEB & DIGITAL-PRÄSENZ SCHWÄBISCH GMÜND</span>
    <h1 class="text-5xl sm:text-7xl font-black tracking-tight mt-4 mb-6">Die richtige Prise <span class="text-emerald-400">Perfektion</span></h1>
    <p class="text-xl text-brand-muted max-w-2xl mx-auto mb-10">Wir machen dein Unternehmen sichtbar – bei Google, bei ChatGPT, auf Instagram. Messbar, persönlich, ohne Agentur-Blabla.</p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="#kontakt" class="bg-emerald-400 text-black px-8 py-4 rounded-xl font-bold text-lg hover:bg-opacity-90 transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400" aria-label="Kostenloses Erstgespräch starten">Erstgespräch buchen</a>
      <a href="tel:+491756372395" class="border-2 border-emerald-400 text-emerald-400 px-8 py-4 rounded-xl font-bold text-lg hover:bg-emerald-400 hover:text-black transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400" aria-label="Direkt anrufen: +49 175 6372395">Direkt anrufen</a>
    </div>
  </section>

  <section class="py-20 max-w-7xl mx-auto px-4 relative">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 opacity-30">
      <div class="absolute top-10 left-1/2 -translate-x-1/2 w-[720px] h-[200px] blur-3xl rounded-full" style="background: radial-gradient(60% 60% at 50% 50%, rgba(16,185,129,.18), transparent 70%);"></div>
    </div>

    <div class="mb-12" data-animate="rise">
      <span class="text-emerald-400 font-bold text-sm tracking-widest uppercase">— LEISTUNGEN</span>
      <h2 class="text-4xl font-extrabold mt-2">Was wir für dich tun.</h2>
    </div>

    <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" role="list">
      {services.map((s, i) => (
        <li class="will-change-transform" data-animate="rise" style={`--i:${i}`}>
          <a href={s.url} class="block bg-brand-card p-6 rounded-2xl border border-white/10 hover:border-white/30 transition group focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-400" aria-label={`${s.title} – ${s.desc}`}>
            <div class="inline-block px-3 py-1 rounded-full border text-xs font-bold mb-4 border-emerald-400 text-emerald-400">{s.title}</div>
            <h3 class="text-xl font-bold mb-2 group-hover:text-emerald-400 transition">{s.title}</h3>
            <p class="text-brand-muted text-sm leading-relaxed mb-4">{s.desc}</p>
            <span class="text-xs font-bold uppercase tracking-wider text-white group-hover:underline">Mehr erfahren →</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <ResultsAndWorkflow />
  <Funnel />
  <Footer />
</Layout>

<script is:raw>
(() => {
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const els = document.querySelectorAll('[data-animate="rise"]');
  els.forEach(el => { el.style.opacity = '0'; el.style.transform = 'translateY(8px)'; });
  const io = new IntersectionObserver((entries, obs) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.style.transition='opacity .5s ease, transform .5s ease'; e.target.style.opacity='1'; e.target.style.transform='translateY(0)'; obs.unobserve(e.target);} });
  }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
  els.forEach(el => io.observe(el));
})();
</script>
