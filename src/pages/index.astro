---
import BaseLayout from "../layouts/BaseLayout.astro";
import SchemaOrg from "../components/SchemaOrg.astro";
const title = "Internetagentur Schwäbisch Gmünd | Online‑Marketing & Webdesign | KRIEG PERFORMANCE";
const description = "SEO, Google Ads, Landingpages, CRO & Analytics. Senior‑Know‑how, klare KPIs, schnelle Umsetzung. Aus Schwäbisch Gmünd für BW & DACH.";
const jsonLd = [{ "@context":"https://schema.org","@type":"WebSite","@id":"https://kriegperformance.de/#website","url":"https://kriegperformance.de/","name":"KRIEG PERFORMANCE – Online Marketingbüro","publisher":{"@id":"https://kriegperformance.de/#organization"},"inLanguage":"de-DE" }];
---
<BaseLayout title={title} description={description} path="/" jsonLd={jsonLd}>
  <SchemaOrg />
  <section class="section">
    <div class="container hero">
      <div>
        <div class="hero__eyebrow">Internetagentur · Schwäbisch Gmünd</div>
        <h1 class="h1 reveal" data-reveal="up">Online‑Marketing, das wirkt. Für KMU, Start‑ups und B2B.</h1>
        <p class="lead reveal" data-reveal="fade">Planbar mehr Anfragen und Umsatz – mit klarer Strategie, sauberem Tracking und fokussierter Umsetzung.</p>
        <div class="hero__cta">
          <a class="btn btn--primary" href="/kontakt/">Kostenloses Erstgespräch</a>
          <a class="btn btn--outline" href="/referenzen/">Case Studies ansehen</a>
        </div>
        <div class="hero__kpis">
          <div class="kpi"><div class="kpi__value">+42%</div><div class="kpi__label">mehr qualifizierte Leads [bitte bestätigen]</div></div>
          <div class="kpi"><div class="kpi__value">-28%</div><div class="kpi__label">niedrigerer CPA [bitte bestätigen]</div></div>
        </div>
      </div>
      <div class="reveal" data-reveal="fade">
        <picture>
          <source type="image/avif" srcset="/images/hero@1440.avif 1440w, /images/hero@1024.avif 1024w" sizes="(min-width:1024px) 50vw, 100vw" />
          <source type="image/webp" srcset="/images/hero@1440.webp 1440w, /images/hero@1024.webp 1024w" sizes="(min-width:1024px) 50vw, 100vw" />
          <img src="/images/hero@1024.jpg" width="1024" height="768" alt="Timo Krieg im Beratungsgespräch" loading="eager" decoding="async" />
        </picture>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container"><h2 class="h2">Leistungen</h2>
      <div class="grid" style="--cols: 1">
        <article class="card service-card reveal" data-reveal="up"><h3>SEO</h3><p>Sichtbarkeit lokal & national. Technisch sauber, inhaltlich stark.</p><ul><li>Audit</li><li>Onpage</li><li>Content & Local</li></ul><a class="btn btn--ghost" href="/leistungen/seo/">Details</a></article>
        <article class="card service-card reveal" data-reveal="up"><h3>Google Ads (SEA)</h3><p>Such‑, Shopping‑, PMax‑Kampagnen mit klarer Rendite.</p><ul><li>Audit</li><li>Setup</li><li>Skalierung</li></ul><a class="btn btn--ghost" href="/leistungen/google-ads/">Details</a></article>
        <article class="card service-card reveal" data-reveal="up"><h3>Webdesign/Landingpages</h3><p>Seiten, die konvertieren. Schnell, klar, mobile‑first.</p><ul><li>Wireframes & Copy</li><li>Build</li><li>Tests</li></ul><a class="btn btn--ghost" href="/leistungen/landingpages/">Details</a></article>
        <article class="card service-card reveal" data-reveal="up"><h3>Social Ads</h3><p>Meta, LinkedIn, TikTok – datengetrieben & kreativ.</p><ul><li>Funnel</li><li>Setup</li><li>Creative‑Testing</li></ul><a class="btn btn--ghost" href="/leistungen/social-ads/">Details</a></article>
        <article class="card service-card reveal" data-reveal="up"><h3>CRO</h3><p>Mehr Abschlüsse ohne mehr Traffic. Testbasiert.</p><ul><li>Audit</li><li>A/B‑Tests</li><li>Research</li></ul><a class="btn btn--ghost" href="/leistungen/cro/">Details</a></article>
        <article class="card service-card reveal" data-reveal="up"><h3>Analytics/Tracking</h3><p>GA4 & GTM – verlässliche Daten & Dashboards.</p><ul><li>Audit</li><li>Implementierung</li><li>Reporting</li></ul><a class="btn btn--ghost" href="/leistungen/analytics-tracking/">Details</a></article>
      </div>
    </div>
  </section>
  <section class="section"><div class="container">
    <h2 class="h2">Ablauf in 3 Schritten</h2>
    <div class="grid" style="--cols: 3">
      <article class="card reveal" data-reveal="up"><h3>1) Analyse & Zielbild</h3><p>Ist‑Status, Potenziale, KPIs.</p></article>
      <article class="card reveal" data-reveal="up"><h3>2) Strategie & Setup</h3><p>Priorisierte Roadmap, sauberes Tracking.</p></article>
      <article class="card reveal" data-reveal="up"><h3>3) Betrieb & Optimierung</h3><p>Testing, Reporting, Learnings.</p></article>
    </div>
  </div></section>
  <section class="section"><div class="container">
    <div class="card" style="display:flex;gap:16px;align-items:center;justify-content:space-between;flex-wrap:wrap;">
      <div><h3 class="h3">Bereit für messbares Wachstum?</h3><p class="help">Gratis Erstgespräch (30 Min.). Klare Potenziale & nächste Schritte.</p></div>
      <a class="btn btn--primary" href="/kontakt/">Erstgespräch buchen</a>
    </div>
  </div></section>
</BaseLayout>
