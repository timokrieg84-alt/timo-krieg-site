---
import BaseLayout from "../layouts/BaseLayout.astro";
import SchemaOrg from "../components/SchemaOrg.astro";
import LogoStrip from "../components/LogoStrip.astro";
import TestimonialSlider from "../components/TestimonialSlider.astro";
import KPIs from "../components/KPIs.astro";
const title = "Reinigungsfirma Zürich | Novo Reinigungen AG";
const description = "Professionelle Reinigungen für Büro, Praxis & Wohnung in Zürich. Allpura-Mitglied, faire Preise. Offerte: +41 44 491 91 91.";
---
<BaseLayout title={title} description={description} path="/" ogImage="/images/og-home.jpg">
  <SchemaOrg slot="head" />
  <section class="hero">
    <div class="container grid grid-12">
      <div style="grid-column:1 / -1;">
        <div class="kicker" data-animate="hero-kicker">Zürich · B2B & B2C</div>
        <h1 class="title display" data-animate="hero-title">
          <span>Novo Reinigungen Zürich</span> <span>– präzise gepflegt,</span> <span>verlässlich sauber</span>
        </h1>
        <p class="lead" data-animate="hero-copy">Ihre Reinigungsfirma für Büros, Praxen, Wohnungen und Umzüge. Schweizer Qualität, diskret im Auftritt, spürbar im Ergebnis.</p>
        <div class="actions" data-animate="hero-cta">
          <a href="/kontakt/" class="btn btn--lg">Offerte anfordern</a>
          <a href="/kontakt/" class="btn btn--lg btn--ghost">Gratis-Besichtigung vereinbaren</a>
          <a href="tel:+41444919191" class="btn btn--lg btn--ghost">Jetzt telefonisch beraten lassen</a>
        </div>
      </div>
      <div style="grid-column:1 / -1; margin-top: var(--space-8);" class="hero-visual" data-parallax data-speed="0.18">
        <img src="/images/hero.webp" alt="Modernes, lichtdurchflutetes Büro in Zürich, frisch gereinigt" width="1600" height="900" loading="eager" decoding="async" />
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>Leistungen</h2>
    <div class="service-grid">
      <article class="card-service">
        <div class="icon" aria-hidden="true">🏢</div>
        <h3>Büroreinigung</h3>
        <p>Saubere Arbeitsplätze. Klare Prozesse. Planbare Unterhaltsreinigung in Zürich und Umgebung.</p>
        <a class="link" href="/leistungen/bueroreinigung/">Zur Detailseite <span class="arrow">→</span></a>
      </article>
      <article class="card-service">
        <div class="icon" aria-hidden="true">🏥</div>
        <h3>Praxisreinigung</h3>
        <p>Hygienische Sauberkeit nach klaren Standards – für Arztpraxen, Therapie- und Behandlungsräume.</p>
        <a class="link" href="/leistungen/praxisreinigung/">Zur Detailseite <span class="arrow">→</span></a>
      </article>
      <article class="card-service">
        <div class="icon" aria-hidden="true">🏠</div>
        <h3>Wohnungsreinigung</h3>
        <p>Gründlich, schonend, pünktlich – für bewohnte Objekte und Zwischenreinigungen.</p>
        <a class="link" href="/leistungen/wohnungsreinigung/">Zur Detailseite <span class="arrow">→</span></a>
      </article>
      <article class="card-service">
        <div class="icon" aria-hidden="true">🚚</div>
        <h3>Umzugsreinigung mit Abgabegarantie</h3>
        <p>Stressfrei abgeben. Wir reinigen, Sie erhalten die Schlüsselrückgabe mit Garantie.</p>
        <a class="link" href="/leistungen/umzugsreinigung/">Zur Detailseite <span class="arrow">→</span></a>
      </article>
      <article class="card-service">
        <div class="icon" aria-hidden="true">🪟</div>
        <h3>Fensterreinigung</h3>
        <p>Streifenfrei bis in die Ecken – Fenster, Wintergärten und Glasfassaden.</p>
        <a class="link" href="/leistungen/fensterreinigung/">Zur Detailseite <span class="arrow">→</span></a>
      </article>
    </div>
  </section>

  <section class="section container">
    <h2>Qualität, die trägt</h2>
    <div class="grid grid-3">
      <div>
        <h3>Schweizer Zuverlässigkeit</h3>
        <p>Vereinbarte Qualität. Verbindliche Termine.</p>
      </div>
      <div>
        <h3>Feste Teams</h3>
        <p>Geschult, diskret, sorgfältig.</p>
      </div>
      <div>
        <h3>Kontrollierte Prozesse</h3>
        <p>Checklisten, Vier-Augen-Kontrollen, dokumentierte Übergaben.</p>
      </div>
      <div>
        <h3>Nachhaltig gedacht</h3>
        <p>Effiziente Verfahren, ökologisch abgestimmte Reinigungsmittel.</p>
      </div>
      <div>
        <h3>Fair und korrekt</h3>
        <p>Transparente Offerten, klare Leistungspakete, keine versteckten Kosten.</p>
      </div>
    </div>
  </section>

  <LogoStrip />
  <TestimonialSlider />
  <KPIs />

  <section class="section container">
    <h2>Reinigungsmittel & Verantwortung</h2>
    <p>Wir setzen auf professionelle, materialschonende Produkte, dosiert nach Bedarf. Wo sinnvoll, nutzen wir umweltfreundliche Mittel und Mehrwegsysteme. Sicherheit für Mensch, Material und Umwelt steht im Fokus.</p>
    <figure class="hero-visual" style="margin-top: var(--space-6);">
      <img src="/images/cleaning-supplies.webp" alt="Professionelle Reinigungstücher und dosierte Reinigungsmittel" width="1400" height="900" loading="lazy" decoding="async" />
    </figure>
  </section>

  <section class="section container">
    <div class="cta-band">
      <div class="accent-badge" aria-hidden="true"></div>
      <h3 class="title">Sprechen wir über Ihr Objekt</h3>
      <p>Kostenlose Beratung und Gratis-Besichtigung in Zürich und Umgebung.</p>
      <div class="actions">
        <a href="/kontakt/" class="btn btn--light">Offerte erhalten</a>
        <a href="tel:+41444919191" class="btn btn--ghost">+41 44 491 91 91</a>
      </div>
    </div>
  </section>
</BaseLayout>
