---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CTAButton from "../components/CTAButton.astro";
import Section from "../components/Section.astro";
const title = "Gylsere Januzi - Online Marketing Office";
const desc = "Wir machen dein Unternehmen sichtbar – bei Google, bei ChatGPT, auf Instagram. Messbar, persönlich, ohne Agentur-Blabla.";
---
<Layout title={title} description={desc} url="/">
  <Fragment slot="header"><Header /></Fragment>

  <section class="relative overflow-hidden">
    <div class="container py-24 sm:py-28">
      <div class="max-w-2xl">
        <h1 class="text-4xl sm:text-5xl font-semibold leading-tight">Die richtige Prise Perfektion</h1>
        <p class="text-textc-muted mt-4">
          Wir machen dein Unternehmen sichtbar – bei Google, bei ChatGPT, auf Instagram. Messbar, persönlich, ohne Agentur-Blabla.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <CTAButton href="/kontakt" label="Kostenloses Erstgespräch" />
          <CTAButton href="tel:+491756372395" kind="secondary" label="Direkt durchstellen" />
        </div>
      </div>
    </div>
  </section>

  <Section id="leistungen" title="Leistungen" intro="Unsere Leistungen im Überblick.">
    <!-- TODO: Inhalte 1:1 von Live-Domain einsetzen. Bitte hier im Chat posten, damit ich sie exakt übernehme. -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <article class="card p-6">
        <h3 class="font-semibold mb-2">Leistung 1</h3>
        <p class="text-textc-muted">Platzhalter – wird 1:1 durch Inhalte der Live-Domain ersetzt.</p>
      </article>
      <article class="card p-6">
        <h3 class="font-semibold mb-2">Leistung 2</h3>
        <p class="text-textc-muted">Platzhalter – wird 1:1 durch Inhalte der Live-Domain ersetzt.</p>
      </article>
      <article class="card p-6">
        <h3 class="font-semibold mb-2">Leistung 3</h3>
        <p class="text-textc-muted">Platzhalter – wird 1:1 durch Inhalte der Live-Domain ersetzt.</p>
      </article>
    </div>
    <div class="mt-8">
      <CTAButton href="/leistungen" label="Alle Leistungen ansehen" kind="ghost" />
    </div>
  </Section>

  <Fragment slot="footer"><Footer /></Fragment>
</Layout>
