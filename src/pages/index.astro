---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Leistungen from '../components/Leistungen.astro';
import Prozess from '../components/ProzessTimeline.astro';
import Counters from '../components/Counters.astro';
import Testimonials from '../components/Testimonials.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
const title = 'Online‑Marketing Agentur Schwäbisch Gmünd | GJK';
const description = 'Premium Performance‑Marketing: SEO, Local SEO, Google Ads, GEO, Webdesign/E‑Com & AI – DSGVO‑konform. Angebot anfragen.';
const canonical = 'https://online-marketing-office.de/';
---
<Base {title} {description} {canonical} ogImage="/images/hero-office-dusk.webp">
  <Header />
  <main id="main">
    <Hero />
    <Leistungen />
    <Prozess />
    <Counters />
    <Testimonials />
    <Contact />
  </main>
  <Footer />
</Base>
