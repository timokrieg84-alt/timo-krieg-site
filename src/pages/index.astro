---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/Section.astro";
---
<Layout title="Gylsere Januzi – Online Marketing Office" description="Digitale Präsenz, die messbar wirkt.">
  <Fragment slot="header"><Header /></Fragment>

  <section class="bg-surface border-b border-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white mb-4">
        Digitale Präsenz, die messbar wirkt.
      </h1>
      <p class="text-lg text-gray-400 max-w-3xl">
        Wir bringen Ihr Unternehmen nach vorn – bei Google, in KI-Antworten und auf Social Media. Klar, strukturiert, ohne Umwege.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/kontakt" class="inline-flex items-center justify-center px-5 py-3 rounded-lg bg-[#FF6A00] text-white font-semibold hover:bg-[#FF6A00]/90 transition-colors">Erstgespräch buchen</a>
        <a href="mailto:gjanuzikrieg@gmail.com" class="inline-flex items-center justify-center px-5 py-3 rounded-lg border border-[#FF2D9A] text-[#FF2D9A] font-semibold hover:bg-[#FF2D9A] hover:text-white transition-colors">E-Mail</a>
        <a href="tel:+491756372395" class="inline-flex items-center justify-center px-5 py-3 rounded-lg bg-[#00C853] text-gray-950 font-semibold hover:bg-[#00C853]/90 transition-colors">+49 175 6372395</a>
      </div>
    </div>
  </section>

  <Section intro="Exzellenz & Digitale Präsenz. Wir arbeiten strukturiert, messbar und ohne Buzzwords.">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <article class="bg-[#131b2e] border border-gray-800 p-6 rounded-xl flex flex-col justify-between">
        <div>
          <span class="inline-block px-2.5 py-1 text-xs font-semibold rounded bg-[#00C853]/10 text-[#00C853] mb-3">SEO</span>
          <h3 class="text-xl font-bold text-white mb-2">Sichtbar werden, wenn es zählt.</h3>
          <p class="text-sm text-gray-400 mb-4">Technisches SEO, Content-Strategie und Backlinks – damit Ihre Kunden Sie finden, bevor es Ihre Wettbewerber tun.</p>
        </div>
        <div>
          <div class="flex flex-wrap gap-1.5 mb-6 text-xs text-gray-400">
            <span class="bg-gray-800 px-2 py-1 rounded">Technisches SEO</span>
            <span class="bg-gray-800 px-2 py-1 rounded">Content & Keywords</span>
            <span class="bg-gray-800 px-2 py-1 rounded">Backlink-Aufbau</span>
            <span class="bg-gray-800 px-2 py-1 rounded">Local SEO</span>
          </div>
          <a href="/leistungen" class="text-sm font-semibold text-[#FF2D9A] hover:underline">MEHR ERFAHREN &rarr;</a>
        </div>
      </article>

      <article class="bg-[#131b2e] border border-gray-800 p-6 rounded-xl flex flex-col justify-between">
        <div>
          <span class="inline-block px-2.5 py-1 text-xs font-semibold rounded bg-[#00C853]/10 text-[#00C853] mb-3">Google Ads</span>
          <h3 class="text-xl font-bold text-white mb-2">Jeder Klick mit Absicht.</h3>
          <p class="text-sm text-gray-400 mb-4">Performance Max, Search, YouTube – mit messbarem ROAS und ohne Budgetverschwendung.</p>
        </div>
        <div>
          <div class="flex flex-wrap gap-1.5 mb-6 text-xs text-gray-400">
            <span class="bg-gray-800 px-2 py-1 rounded">Search & PMax</span>
            <span class="bg-gray-800 px-2 py-1 rounded">Conversion Tracking</span>
            <span class="bg-gray-800 px-2 py-1 rounded">Klickschutz</span>
            <span class="bg-gray-800 px-2 py-1 rounded">Retargeting</span>
          </div>
          <a href="/leistungen" class="text-sm font-semibold text-[#FF2D9A] hover:underline">MEHR ERFAHREN &rarr;</a>
        </div>
      </article>

      <article class="bg-[#131b2e] border border-gray-800 p-6 rounded-xl flex flex-col justify-between">
        <div>
          <span class="inline-block px-2.5 py-1 text-xs font-semibold rounded bg-[#00C853]/10 text-[#00C853] mb-3">GEO</span>
          <h3 class="text-xl font-bold text-white mb-2">Sichtbar in ChatGPT & Google AI.</h3>
          <p class="text-sm text-gray-400 mb-4">Generative Engine Optimization – LLM-crawlbare Inhalte, Entity-SEO und Citation-Ready Content.</p>
        </div>
        <div>
          <a href="/leistungen" class="text-sm font-semibold text-[#FF2D9A] hover:underline">MEHR ERFAHREN &rarr;</a>
        </div>
      </article>
    </div>
  </Section>

  <Fragment slot="footer"><Footer /></Fragment>
</Layout>
