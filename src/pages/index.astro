---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Digitale Präsenz, die messbar wirkt. | Gylsere Januzi Online Marketing Office" description="Wir bringen Ihr Unternehmen nach vorn – bei Google, in KI‑Antworten und auf Social Media. Klar, strukturiert, ohne Umwege.">
  <main class="max-w-7xl mx-auto px-4 py-16 text-gray-200">
    <section class="text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-white">Digitale Präsenz, die messbar wirkt.</h1>
      <p class="mt-4 text-lg md:text-xl text-gray-300">Wir bringen Ihr Unternehmen nach vorn – bei Google, in KI‑Antworten und auf Social Media. Klar, strukturiert, ohne Umwege.</p>
    </section>

    <section class="mt-16">
      <h2 class="sr-only">Leistungs‑Vorschau</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <article class="bg-[#131b2e] rounded-xl p-6 border border-white/10 hover:border-white/20 transition-colors">
          <span class="inline-flex text-xs font-semibold px-2 py-1 rounded bg-[#FF2D9A]/15 text-[#FF2D9A] mb-3">Local SEO</span>
          <h3 class="text-white text-lg font-semibold">Google My Business & Local SEO</h3>
          <p class="mt-2 text-gray-300">Optimierung des Google‑Unternehmensprofils, lokale Keywords, Reviews, Top‑Platzierung im Google Local Pack und Verknüpfung zur regionalen SEO‑Dominanz.</p>
        </article>
        <article class="bg-[#131b2e] rounded-xl p-6 border border-white/10 hover:border-white/20 transition-colors">
          <span class="inline-flex text-xs font-semibold px-2 py-1 rounded bg-[#FF6A00]/15 text-[#FF6A00] mb-3">SEO</span>
          <h3 class="text-white text-lg font-semibold">SEO & Content</h3>
          <p class="mt-2 text-gray-300">Technik, Inhalte und Autorität – sauber umgesetzt für stabile Rankings und messbares Wachstum.</p>
        </article>
        <article class="bg-[#131b2e] rounded-xl p-6 border border-white/10 hover:border-white/20 transition-colors">
          <span class="inline-flex text-xs font-semibold px-2 py-1 rounded bg-[#00C853]/15 text-[#00C853] mb-3">Ads</span>
          <h3 class="text-white text-lg font-semibold">Google Ads</h3>
          <p class="mt-2 text-gray-300">Performance‑Kampagnen mit klarer Struktur, Conversion‑Tracking und kontinuierlichem Testing.</p>
        </article>
      </div>
      <div class="text-center mt-10">
        <a href="/leistungen" class="inline-flex items-center justify-center px-5 py-3 rounded-lg bg-[#FF6A00] text-white font-semibold hover:bg-[#FF6A00]/90 transition-colors">Alle Leistungen ansehen</a>
      </div>
    </section>
  </main>
</Layout>
