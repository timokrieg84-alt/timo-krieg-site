---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/Section.astro";
---
<Layout title="Gylsere Januzi – Online Marketing Office" description="Wir machen dein Unternehmen sichtbar – bei Google, bei ChatGPT, auf Instagram. Messbar, persönlich, ohne Agentur-Blabla.">
  <Fragment slot="header"><Header /></Fragment>

  <section class="relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28">
      <div class="max-w-2xl">
        <h1 class="text-4xl sm:text-5xl font-bold leading-tight">Die richtige Prise Perfektion</h1>
        <p class="text-gray-400 mt-4">
          Wir machen dein Unternehmen sichtbar – bei Google, bei ChatGPT, auf Instagram. Messbar, persönlich, ohne Agentur-Blabla.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/kontakt" class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-[#FF6A00] text-white font-medium hover:bg-[#FF6A00]/90 transition-colors">Kostenloses Erstgespräch</a>
          <a href="tel:+491756372395" class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-[#00C853] text-gray-950 font-semibold hover:bg-[#00C853]/90 transition-colors">Direkt durchstellen</a>
        </div>
      </div>
    </div>
  </section>

  <Section title="Leistungen" intro="Unsere Leistungen im Überblick.">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <article class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur"><h3 class="font-semibold mb-2">Leistung 1</h3><p class="text-gray-400">Wird 1:1 aus Live übernommen.</p></article>
      <article class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur"><h3 class="font-semibold mb-2">Leistung 2</h3><p class="text-gray-400">Wird 1:1 aus Live übernommen.</p></article>
      <article class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur"><h3 class="font-semibold mb-2">Leistung 3</h3><p class="text-gray-400">Wird 1:1 aus Live übernommen.</p></article>
    </div>
    <div class="mt-8"><a href="/leistungen" class="inline-flex items-center justify-center px-4 py-2 rounded-lg border border-[#FF6A00] text-[#FF6A00] hover:bg-[#FF6A00]/10 transition-colors">Alle Leistungen ansehen</a></div>
  </Section>

  <Fragment slot="footer"><Footer /></Fragment>
</Layout>
