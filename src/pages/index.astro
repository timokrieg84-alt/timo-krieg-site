---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/Section.astro";
---
<Layout title="Gylsere Januzi - online marketing office">
  <Fragment slot="header"><Header /></Fragment>

  <section class="py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-white">Die richtige Prise Perfektion</h1>
    <p class="mt-4 text-lg text-gray-400 max-w-2xl">Wir machen dein Unternehmen sichtbar – bei Google, bei ChatGPT, auf Instagram. Messbar, persönlich, ohne Agentur-Blabla.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/kontakt" class="inline-flex items-center justify-center px-5 py-3 rounded-lg bg-[#FF6A00] text-white font-semibold hover:bg-[#FF6A00]/90">Kostenloses Erstgespräch</a>
      <a href="tel:+491756372395" class="inline-flex items-center justify-center px-5 py-3 rounded-lg bg-[#00C853] text-gray-950 font-semibold hover:bg-[#00C853]/90">Direkt durchstellen</a>
    </div>
  </section>

  <Section title="Leistungen" intro="Unser vollständiges Portfolio für Ihren digitalen Erfolg.">
    <div class="mt-2">
      <a href="/leistungen" class="text-sm font-semibold text-[#FF2D9A] hover:underline">Alle Leistungen ansehen →</a>
    </div>
  </Section>

  <Fragment slot="footer"><Footer /></Fragment>
</Layout>
