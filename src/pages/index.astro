---
import Layout from "../layouts/Layout.astro";
import CTAButton from "../components/CTAButton.astro";
import { brand, services, sections, contact, projectInfo } from "../data/site";
---
<Layout title={projectInfo.name} description={projectInfo.tagline}>
  {/* Hero */}
  <section id={sections.hero} class="pt-16 sm:pt-24 lg:pt-28 pb-16">
    <div class="mx-auto max-w-3xl text-center">
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-[#0F172A]">
        {projectInfo.tagline}
      </h1>
      <p class="mt-5 text-base sm:text-lg text-[#1E293B]">
        {brand.logoText} entwickelt ultraschnelle, markenstarke Websites mit Fokus auf Klarheit, Usability und Conversion.
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <CTAButton href={`/#${sections.kontakt}`} ariaLabel="Kontakt aufnehmen">
          {contact.cta}
        </CTAButton>
        <CTAButton href={`/#${sections.leistungen}`} variant="secondary" ariaLabel="Zu unseren Leistungen">
          Leistungen ansehen
        </CTAButton>
      </div>
      <div class="mt-8 text-sm text-[#1E293B]">
        <a class="text-[#C026D3] hover:text-[#06B6D4] font-semibold" href={`/#${sections.leistungen}`}>Direkt zu den Leistungen</a>
      </div>
    </div>
  </section>

  {/* Leistungen Übersicht */}
  <section id={sections.leistungen} class="py-10 sm:py-16 lg:py-20 border-t border-[#F1F5F9]">
    <div class="mb-10 text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0F172A]">Leistungen</h2>
      <p class="mt-3 text-[#1E293B]">Alles, was Sie für performante Web Experiences brauchen – strategisch vernetzt.</p>
    </div>
    <div class="grid gap-6 sm:gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <section id={s.id} class="group rounded-2xl border border-[#F1F5F9] bg-[#FFFFFF] p-6 hover:border-[#06B6D4] transition-colors">
          <h3 class="text-xl font-bold text-[#0F172A]">{s.name}</h3>
          <p class="mt-2 text-sm text-[#1E293B]">{s.excerpt}</p>
          <ul class="mt-4 space-y-2 text-sm text-[#1E293B] list-disc list-inside">
            {s.features.slice(0,3).map((f) => (<li>{f}</li>))}
          </ul>
          <div class="mt-6 flex items-center gap-3">
            <CTAButton href={`/leistungen/${s.slug}`} ariaLabel={`Mehr über ${s.name} erfahren`}>
              Mehr erfahren
            </CTAButton>
            <a href={`/#${sections.kontakt}`} class="text-sm font-semibold text-[#C026D3] hover:text-[#06B6D4]">Angebot anfragen</a>
          </div>
          <div class="mt-4 text-xs text-[#1E293B]">
            <a class="hover:text-[#06B6D4]" href={`/#${sections.leistungen}`}>Alle Leistungen</a>
            <span class="mx-2">·</span>
            <a class="hover:text-[#06B6D4]" href="/">Startseite</a>
          </div>
        </section>
      ))}
    </div>
  </section>

  {/* Über uns */}
  <section id={sections.about} class="py-16 lg:py-24 border-t border-[#F1F5F9]">
    <div class="grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0F172A]">Über uns</h2>
        <p class="mt-4 text-[#1E293B]">
          Wir sind {projectInfo.name} – ein spezialisiertes Team für Frontend, Design und SEO. Wir vereinen Ästhetik mit harter Performance und bauen Systeme statt Einzelstücke.
        </p>
      </div>
      <div class="lg:col-span-7 grid sm:grid-cols-2 gap-6">
        <div class="rounded-xl border border-[#F1F5F9] p-6">
          <h3 class="text-base font-semibold text-[#0F172A]">Anspruch</h3>
          <p class="mt-2 text-sm text-[#1E293B]">Premium-Qualität, die messbar wirkt – in Design, Code und Prozess.</p>
        </div>
        <div class="rounded-xl border border-[#F1F5F9] p-6">
          <h3 class="text-base font-semibold text-[#0F172A]">Stack</h3>
          <p class="mt-2 text-sm text-[#1E293B]">Astro, React, Tailwind & TypeScript. Schnell, zugänglich, wartbar.</p>
        </div>
        <div class="rounded-xl border border-[#F1F5F9] p-6">
          <h3 class="text-base font-semibold text-[#0F172A]">Arbeitsweise</h3>
          <p class="mt-2 text-sm text-[#1E293B]">Klarer Scope, kurze Feedback-Loops, fokussierte Sprints und saubere Handover.</p>
        </div>
        <div class="rounded-xl border border-[#F1F5F9] p-6">
          <h3 class="text-base font-semibold text-[#0F172A]">Transparenz</h3>
          <p class="mt-2 text-sm text-[#1E293B]">Offene Roadmaps, nachvollziehbare Entscheidungen und Reporting statt Bauchgefühl.</p>
        </div>
      </div>
    </div>
  </section>

  {/* Prozess */}
  <section id={sections.prozess} class="py-16 lg:py-24 border-t border-[#F1F5F9]">
    <div class="mb-8">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0F172A]">Unser Prozess</h2>
      <p class="mt-3 text-[#1E293B]">Strukturiert, kollaborativ, effizient – für verlässliche Ergebnisse.</p>
    </div>
    <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <li class="rounded-xl border border-[#F1F5F9] p-6">
        <h3 class="font-semibold text-[#0F172A]">1. Discovery</h3>
        <p class="mt-2 text-sm text-[#1E293B]">Ziele, Nutzer, Wettbewerb und Rahmen klären. Risiken erkennen, Chancen priorisieren.</p>
      </li>
      <li class="rounded-xl border border-[#F1F5F9] p-6">
        <h3 class="font-semibold text-[#0F172A]">2. Design</h3>
        <p class="mt-2 text-sm text-[#1E293B]">Informationsarchitektur, Wireframes, UI-Komponenten und States – zugänglich und markenkonsistent.</p>
      </li>
      <li class="rounded-xl border border-[#F1F5F9] p-6">
        <h3 class="font-semibold text-[#0F172A]">3. Build</h3>
        <p class="mt-2 text-sm text-[#1E293B]">Astro-Templates, Tailwind, semantisches HTML – Performance und SEO im Fokus.</p>
      </li>
      <li class="rounded-xl border border-[#F1F5F9] p-6">
        <h3 class="font-semibold text-[#0F172A]">4. Launch & Iterate</h3>
        <p class="mt-2 text-sm text-[#1E293B]">Deploy, Messen, Verbessern. Roadmap für Iterationen und Wachstum.</p>
      </li>
    </ol>
  </section>

  {/* Kontakt */}
  <section id={sections.kontakt} class="py-16 lg:py-24 border-t border-[#F1F5F9]">
    <div class="grid lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-7">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#0F172A]">Lassen Sie uns starten</h2>
        <p class="mt-3 text-[#1E293B]">Kurzer Call, klare Einschätzung und ein konkreter Vorschlag für das weitere Vorgehen.</p>
        <div class="mt-6 flex flex-col sm:flex-row gap-4 items-center">
          <CTAButton href={`mailto:${contact.email}`} ariaLabel="E-Mail schreiben">E-Mail schreiben</CTAButton>
          <CTAButton href={`tel:${contact.phone.replace(/\s/g,'')}`} variant="secondary" ariaLabel="Anrufen">Anrufen</CTAButton>
        </div>
        <p class="mt-4 text-sm text-[#1E293B]">Erreichbar: {contact.availability} · {contact.address}</p>
      </div>
      <div class="lg:col-span-5 rounded-2xl border border-[#F1F5F9] p-6">
        <h3 class="text-base font-semibold text-[#0F172A]">Direktlinks</h3>
        <ul class="mt-3 space-y-2 text-sm text-[#1E293B]">
          <li><a class="text-[#C026D3] hover:text-[#06B6D4]" href="/">Startseite</a></li>
          <li><a class="text-[#C026D3] hover:text-[#06B6D4]" href={`/#${sections.leistungen}`}>Leistungen</a></li>
          <li><a class="text-[#C026D3] hover:text-[#06B6D4]" href={`/#${sections.about}`}>Über uns</a></li>
          <li><a class="text-[#C026D3] hover:text-[#06B6D4]" href={`/#${sections.prozess}`}>Prozess</a></li>
          <li><a class="text-[#C026D3] hover:text-[#06B6D4]" href="/impressum">Impressum</a></li>
          <li><a class="text-[#C026D3] hover:text-[#06B6D4]" href="/datenschutz">Datenschutz</a></li>
        </ul>
      </div>
    </div>
  </section>
</Layout>
