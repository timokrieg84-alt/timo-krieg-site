---
import site from "../config/site";
import GoldenMasterLayout from "../layouts/GoldenMasterLayout.astro";
import RenderSections from "../components/RenderSections.astro";

const page = site.pages.find((p) => p.path === "/");
---
<GoldenMasterLayout title={site.seo.defaultTitle} description={site.seo.defaultDescription} ogImage={site.brand.images.defaultOg} variant="default">
  <RenderSections ids={page?.sections || []} />
</GoldenMasterLayout>
