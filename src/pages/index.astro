---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/Section.astro";
---
<Layout title="Gylsere Januzi - online marketing office">
  <Fragment slot="header"><Header /></Fragment>
  
  <Section intro="Exzellenz & Digitale Präsenz. Wir arbeiten strukturiert, messbar und ohne Buzzwords.">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      
      <article class="bg-[#131b2e] border border-gray-800 p-6 rounded-xl flex flex-col justify-between">
        <div>
          <span class="inline-block px-2.5 py-1 text-xs font-semibold rounded bg-[#00C853]/10 text-[#00C853] mb-3">SEO</span>
          <h3 class="text-xl font-bold text-white mb-2">Sichtbar werden, wenn es zählt.</h3>
          <p class="text-sm text-gray-400 mb-4">Technisches SEO, Content-Strategie und Backlinks – damit ihre Kunden Sie finden, bevor es Ihre Wettbewerber tun.</p>
        </div>
        <div>
          <div class="flex flex-wrap gap-1.5 mb-6 text-xs text-gray-400">
            <span class="bg-gray-800 px-2 py-1 rounded">Technisches SEO</span>
