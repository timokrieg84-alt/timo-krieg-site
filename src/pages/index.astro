---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
const services = site.services;
---
<Layout>
  <section class="relative isolate overflow-hidden">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-16 sm:pt-24 lg:pt-28 pb-20">
      <div class="grid lg:grid-cols-2 gap-10 items-center">
        <div>
          <div class="text-xs uppercase tracking-wider text-[#123D2A]">{site.sections.hero.eyebrow}</div>
          <h1 class="mt-3 text-3xl sm:text-5xl font-semibold text-[#1A1A1A]">{site.sections.hero.headline}</h1>
          <p class="mt-4 text-lg text-[#1A1A1A]/80 max-w-xl">{site.sections.hero.subheadline}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={site.sections.hero.ctaPrimary.href} class="inline-flex items-center gap-2 rounded-full bg-[#123D2A] px-5 py-3 text-[#F5F1E9] hover:bg-[#C8501E] transition-colors">{site.sections.hero.ctaPrimary.label}</a>
            <a href={site.sections.hero.ctaSecondary.href} class="inline-flex items-center gap-2 rounded-full border border-[#123D2A]/20 bg-[#F5F1E9] px-5 py-3 text-[#123D2A] hover:border-[#C8501E] hover:text-[#C8501E] transition-colors">{site.sections.hero.ctaSecondary.label}</a>
          </div>
          <ul class="mt-10 grid gap-2 text-sm text-[#6B7280]">
            {site.sections.hero.trust.map((t) => (
              <li class="flex items-start gap-3"><span class="mt-1 h-1.5 w-1.5 rounded-full bg-[#C8A24B]"></span>{t}</li>
            ))}
          </ul>
        </div>
        <div class="relative">
          <div class="aspect-[4/3] rounded-2xl border border-[#123D2A]/10 bg-[#F5F1E9] shadow-[0_10px_40px_-12px_rgba(18,61,42,0.25)]"></div>
          <div class="absolute -bottom-6 -left-6 hidden sm:block w-28 h-28 rounded-2xl bg-[#E58AA0]/20 blur-xl"></div>
        </div>
      </div>
    </div>
  </section>

  <section id="services" class="py-20 sm:py-24 lg:py-28 bg-[#F5F1E9] border-y border-[#123D2A]/10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between gap-6">
        <div>
          <h2 class="text-2xl sm:text-4xl font-semibold text-[#1A1A1A]">Leistungen</h2>
          <p class="mt-2 text-[#1A1A1A]/70 max-w-2xl">Strategie, Umsetzung und laufende Optimierung – jede Leistung mit klarer Verantwortung und Messpunkten.</p>
        </div>
        <a href="#contact" class="hidden sm:inline-flex items-center gap-2 rounded-full bg-[#123D2A] px-5 py-3 text-[#F5F1E9] hover:bg-[#C8501E] transition-colors">Projekt anfragen</a>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s)=> (
          <article id={s.slug} class="group rounded-2xl border border-[#123D2A]/10 bg-[#F5F1E9] p-6 shadow-sm hover:shadow-md transition-shadow flex flex-col">
            <div class="text-xs uppercase tracking-wide text-[#123D2A]">{s.subtitle}</div>
            <h3 class="mt-1 text-xl font-semibold text-[#1A1A1A]">{s.title}</h3>
            <p class="mt-2 text-[#1A1A1A]/70">{s.shortDescription}</p>
            <ul class="mt-4 space-y-1 text-sm text-[#1A1A1A]/70 list-disc list-inside">
              {s.features.slice(0,4).map((f)=> (<li>{f}</li>))}
            </ul>
            <div class="mt-6 flex-1"></div>
            <div class="mt-6 flex items-center gap-3">
              <a href={`/leistungen/${s.slug}`} class="inline-flex items-center gap-2 rounded-full bg-[#123D2A] px-4 py-2 text-[#F5F1E9] hover:bg-[#C8501E] transition-colors">Mehr erfahren</a>
              <a href={`/#contact`} class="text-sm text-[#123D2A] hover:text-[#C8501E]">Angebot anfragen</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="about" class="py-20 sm:py-24 lg:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 grid gap-10 lg:grid-cols-2 items-start">
      <div>
        <h2 class="text-2xl sm:text-4xl font-semibold text-[#1A1A1A]">{site.sections.about.title}</h2>
        <p class="mt-4 text-[#1A1A1A]/80 max-w-prose">{site.sections.about.text}</p>
        <ul class="mt-6 grid gap-3">
          {site.sections.about.bullets.map((b)=> (
            <li class="flex items-start gap-3 text-[#1A1A1A]/80"><span class="mt-1 h-1.5 w-1.5 rounded-full bg-[#123D2A]"></span>{b}</li>
          ))}
        </ul>
      </div>
      <div class="grid grid-cols-3 gap-4">
        {site.sections.about.metrics.map((m)=> (
          <div class="rounded-xl border border-[#123D2A]/10 bg-[#F5F1E9] p-4 text-center">
            <div class="text-lg font-semibold text-[#123D2A]">{m.value}</div>
            <div class="text-xs text-[#6B7280]">{m.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="process" class="py-20 sm:py-24 lg:py-28 bg-[#F5F1E9] border-y border-[#123D2A]/10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-4xl font-semibold text-[#1A1A1A]">{site.sections.process.title}</h2>
      <ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {site.sections.process.steps.map((step, i)=> (
          <li class="relative rounded-2xl border border-[#123D2A]/10 bg-[#F5F1E9] p-6">
            <div class="absolute -top-3 -left-3 h-8 w-8 rounded-full bg-[#C8A24B] text-[#1A1A1A] grid place-items-center font-semibold">{i+1}</div>
            <h3 class="text-lg font-semibold text-[#1A1A1A]">{step.title}</h3>
            <p class="mt-2 text-[#1A1A1A]/70">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="contact" class="py-20 sm:py-24 lg:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 grid gap-10 lg:grid-cols-2 items-start">
      <div>
        <h2 class="text-2xl sm:text-4xl font-semibold text-[#1A1A1A]">{site.sections.contact.title}</h2>
        <p class="mt-4 text-[#1A1A1A]/80">{site.sections.contact.intro}</p>
        <div class="mt-6 text-sm text-[#1A1A1A]/70">
          <div>{site.sections.contact.address.company}</div>
          <div>{site.sections.contact.address.street}, {site.sections.contact.address.zip} {site.sections.contact.address.city}</div>
          <div>Tel. <a class="underline hover:text-[#123D2A]" href={`tel:${site.sections.contact.address.phone.replace(/\s/g,'')}`}>{site.sections.contact.address.phone}</a></div>
          <div>Mail <a class="underline hover:text-[#123D2A]" href={`mailto:${site.sections.contact.address.email}`}>{site.sections.contact.address.email}</a></div>
        </div>
      </div>
      <form action="#" method="post" class="rounded-2xl border border-[#123D2A]/10 bg-[#F5F1E9] p-6 shadow-sm">
        <div class="grid gap-4">
          {site.sections.contact.form.fields.map((f)=> (
            f.type === 'textarea' ? (
              <div>
                <label for={f.name} class="block text-sm font-medium text-[#1A1A1A]">{f.label}{f.required && ' *'}</label>
                <textarea id={f.name} name={f.name} required={f.required} class="mt-1 w-full rounded-md border border-[#123D2A]/20 bg-[#F5F1E9] px-3 py-2 text-[#1A1A1A] placeholder:text-[#6B7280] focus:outline-none focus:ring-2 focus:ring-[#123D2A] min-h-[120px]"></textarea>
              </div>
            ) : f.type === 'checkbox' ? (
              <div class="flex items-start gap-3">
                <input id={f.name} name={f.name} type="checkbox" required={f.required} class="mt-1 h-4 w-4 rounded border-[#123D2A]/30 text-[#123D2A] focus:ring-[#123D2A]" />
                <label for={f.name} class="text-sm text-[#1A1A1A]/80">{f.label}</label>
              </div>
            ) : (
              <div>
                <label for={f.name} class="block text-sm font-medium text-[#1A1A1A]">{f.label}{f.required && ' *'}</label>
                <input id={f.name} name={f.name} type={f.type} required={f.required} class="mt-1 w-full rounded-md border border-[#123D2A]/20 bg-[#F5F1E9] px-3 py-2 text-[#1A1A1A] placeholder:text-[#6B7280] focus:outline-none focus:ring-2 focus:ring-[#123D2A]" />
              </div>
            )
          ))}
          <p class="text-xs text-[#6B7280]">{site.sections.contact.form.gdprNote}</p>
          <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-full bg-[#123D2A] px-5 py-3 text-[#F5F1E9] hover:bg-[#C8501E] transition-colors">{site.sections.contact.form.submitLabel}</button>
          <p aria-live="polite" class="sr-only">{site.sections.contact.form.successMessage}</p>
        </div>
      </form>
    </div>
  </section>
</Layout>
