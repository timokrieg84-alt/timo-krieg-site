---
import Layout from "../../layouts/Layout.astro";
import { services } from "../../data/site";
const current = services.find((s) => s.slug === "seo")!;
const others = services.filter((s) => s.slug !== "seo");
---
<Layout>
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    <nav aria-label="Breadcrumb" class="text-sm text-[#64748B]">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="hover:text-[#0B1221]">Start</a></li>
        <li>/</li>
        <li><a href="/#leistungen" class="hover:text-[#0B1221]">Leistungen</a></li>
        <li>/</li>
        <li class="text-[#0B1221]">{current.title}</li>
      </ol>
    </nav>

    <header class="mt-6">
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-[#0B1221]">{current.title}</h1>
      <p class="mt-4 text-lg text-[#64748B] max-w-3xl">Wir verbinden technisches SEO mit Content-Architektur und nutzerzentrierter Information. Von Crawlbarkeit und strukturieren Daten bis hin zu suchintention-genauem Content – für stabile Rankings und organisches Wachstum.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="#contact" class="inline-flex items-center rounded-md bg-[#0B1221] px-5 py-2.5 text-sm font-medium text-[#FFFFFF] hover:bg-[#0EA5E9]">Beratung anfragen</a>
        <a href="/" class="inline-flex items-center rounded-md border border-[#E2E8F0] px-5 py-2.5 text-sm font-medium text-[#0B1221] hover:border-[#0B1221]">Zur Startseite</a>
        <a href="/leistungen/performance" class="inline-flex items-center rounded-md border border-[#E2E8F0] px-5 py-2.5 text-sm font-medium text-[#0B1221] hover:border-[#0B1221]">Performance</a>
      </div>
    </header>

    <div class="mt-12 grid gap-8 lg:grid-cols-12">
      <article class="lg:col-span-8">
        <section class="prose max-w-none">
          <h2 class="text-2xl font-bold text-[#0B1221]">Mehr Sichtbarkeit durch System</h2>
          <p class="mt-3 text-[#0B1221]/90">Erfolg in der Suche ist kein Zufall. Wir entwickeln Informationsarchitekturen, die Themenfelder klar strukturieren, interne Verlinkung stärken und Suchintention präzise bedienen. Technische Hygiene trifft hier auf relevanten Content.</p>
          <h3 class="mt-8 text-xl font-semibold text-[#0B1221]">Leistungspakete</h3>
          <ul class="mt-3 grid gap-3 sm:grid-cols-2">
            <li class="rounded-lg border border-[#E2E8F0] bg-[#FFFFFF] p-4"><strong>Technik-Audit</strong><br/><span class="text-[#64748B]">Crawlbarkeit, Logfiles, strukturierte Daten, Indexierung.</span></li>
            <li class="rounded-lg border border-[#E2E8F0] bg-[#FFFFFF] p-4"><strong>Content-Plan</strong><br/><span class="text-[#64748B]">Keyword-Mapping, Suchintention, Autorität und Tiefe.</span></li>
            <li class="rounded-lg border border-[#E2E8F0] bg-[#FFFFFF] p-4"><strong>OnPage-Setup</strong><br/><span class="text-[#64748B]">Meta, Headings, interne Links, Medienoptimierung.</span></li>
            <li class="rounded-lg border border-[#E2E8F0] bg-[#FFFFFF] p-4"><strong>Monitoring</strong><br/><span class="text-[#64748B]">Dashboards, Alerts und kontinuierliche Iteration.</span></li>
          </ul>
          <p class="mt-6 text-[#0B1221]">SEO wirkt besonders stark in Kombination mit <a href="/leistungen/content" class="text-[#0EA5E9] hover:underline">Content-Design</a> und <a href="/leistungen/analytics" class="text-[#0EA5E9] hover:underline">Analytics</a>.</p>
        </section>
      </article>
      <aside class="lg:col-span-4">
        <div class="rounded-xl border border-[#E2E8F0] bg-[#F8FAFC] p-5">
          <h2 class="text-sm font-semibold text-[#0B1221]">Weitere Leistungen</h2>
          <ul class="mt-3 space-y-2">
            {others.map((s) => (
              <li><a href={s.href} class="text-sm text-[#64748B] hover:text-[#0B1221]">{s.title}</a></li>
            ))}
          </ul>
          <div class="mt-5 border-t border-[#E2E8F0] pt-4">
            <a href="/#leistungen" class="text-sm text-[#0EA5E9] hover:underline">Zur Übersicht</a>
          </div>
        </div>
      </aside>
    </div>

    <section class="mt-16 rounded-2xl border border-[#E2E8F0] bg-[#FFFFFF] p-8 text-center">
      <h2 class="text-2xl font-bold text-[#0B1221]">Organisches Wachstum starten</h2>
      <p class="mt-2 text-[#64748B]">Jetzt Potenziale identifizieren und priorisieren – wir unterstützen pragmatisch und messbar.</p>
      <div class="mt-5 flex justify-center gap-3">
        <a href="/#contact" class="inline-flex items-center rounded-md bg-[#0B1221] px-5 py-2.5 text-sm font-medium text-[#FFFFFF] hover:bg-[#0EA5E9]">Kontakt aufnehmen</a>
        <a href="/" class="inline-flex items-center rounded-md border border-[#E2E8F0] px-5 py-2.5 text-sm font-medium text-[#0B1221] hover:border-[#0B1221]">Startseite</a>
      </div>
    </section>
  </section>
</Layout>
