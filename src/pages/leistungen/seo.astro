---
import Layout from '../../layouts/Layout.astro';
import { brand, services, contact } from '../../data/site';
const service = services.find(s => s.slug === 'seo');
const others = services.filter(s => s.slug !== 'seo');
---
<Layout title={service?.seo.title ?? `${brand.name} – SEO & Local SEO`} description={service?.seo.description}>
  <section class="relative bg-[#0B1220] text-white">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(34,211,238,0.15),transparent_40%)]"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
      <nav class="text-xs text-white/70"><a href="/" class="hover:text-white">Start</a> · <span>SEO & Local SEO</span></nav>
      <h1 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight">SEO & Local SEO</h1>
      <p class="mt-2 max-w-3xl text-white/80">{service?.short}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="#kontakt" class="inline-flex items-center gap-2 rounded-full bg-[#22D3EE] px-5 py-3 text-[#0B1220] font-semibold hover:bg-[#22D3EE]/90 transition-colors">Kostenloses SEO‑Erstgespräch</a>
        <a href="/" class="inline-flex items-center gap-2 rounded-full border border-white/20 px-5 py-3 text-white hover:bg-white/10 transition-colors">Zur Startseite</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14 grid grid-cols-1 lg:grid-cols-3 gap-10">
    <div class="lg:col-span-2">
      <h2 class="text-xl font-semibold">Warum SEO mit ListingProfis?</h2>
      <p class="mt-3 text-[#475569]">Wir kombinieren präzise technische Optimierung mit suchintention‑starkem Content und hochwertigem Linkaufbau. Für lokale Unternehmen bauen wir zusätzlich belastbare Local‑Signale auf – vom perfektionierten Google Business Profil bis zu konsistenten Citations in über 30 Branchenportalen.</p>

      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="rounded-xl border border-[#94A3B8]/40 bg-white p-5">
          <div class="text-sm font-semibold">Technisches Fundament</div>
          <p class="mt-1 text-sm text-[#475569]">Crawl‑Budget, Indexierung, interne Verlinkung und Strukturierte Daten – wir beseitigen Bremsklötze und schaffen eine skalierbare Architektur.</p>
        </div>
        <div class="rounded-xl border border-[#94A3B8]/40 bg-white p-5">
          <div class="text-sm font-semibold">Content, der konvertiert</div>
          <p class="mt-1 text-sm text-[#475569]">Redaktionspläne auf Intent‑Ebene, SERP‑Reverse‑Engineering und UX‑Patterns, die Leads messbar steigern.</p>
        </div>
        <div class="rounded-xl border border-[#94A3B8]/40 bg-white p-5">
          <div class="text-sm font-semibold">Authority & Digital PR</div>
          <p class="mt-1 text-sm text-[#475569]">Sauberer Linkaufbau, Erwähnungen und lokale Signale – Qualität statt Masse für nachhaltige Rankings.</p>
        </div>
        <div class="rounded-xl border border-[#94A3B8]/40 bg-white p-5">
          <div class="text-sm font-semibold">Local SEO Exzellenz</div>
          <p class="mt-1 text-sm text-[#475569]">Optimiertes GBP, NAP‑Konsistenz und hyperlokale Landingpages für Top‑Platzierungen in der Map‑Pack.</p>
        </div>
      </div>

      <h3 class="mt-10 text-lg font-semibold">Leistungsumfang</h3>
      <ul class="mt-3 space-y-2 text-sm text-[#0B1220]">
        {(service?.features ?? []).map((f) => (
          <li class="flex items-start gap-2"><span class="mt-2 h-1.5 w-1.5 rounded-full bg-[#22D3EE]"></span><span>{f}</span></li>
        ))}
        <li class="flex items-start gap-2"><span class="mt-2 h-1.5 w-1.5 rounded-full bg-[#22D3EE]"></span><span>Tracking, Reporting & klare Zielmetriken</span></li>
      </ul>

      <h3 class="mt-10 text-lg font-semibold">Vorgehensmodell</h3>
      <ol class="mt-3 space-y-3">
        <li class="rounded-xl border border-[#94A3B8]/40 bg-white p-5"><strong>1. Audit & Strategie:</strong> Technische Analyse, Keyword‑Landschaft, Wettbewerber und Roadmap.</li>
        <li class="rounded-xl border border-[#94A3B8]/40 bg-white p-5"><strong>2. Quick Wins & Setup:</strong> Technische Fixes, OnPage‑Optimierung, Content‑Blueprints, GBP‑Optimierung.</li>
        <li class="rounded-xl border border-[#94A3B8]/40 bg-white p-5"><strong>3. Content & Authority:</strong> Veröffentlichung, interne Verlinkung, Digital PR, lokale Signale.</li>
        <li class="rounded-xl border border-[#94A3B8]/40 bg-white p-5"><strong>4. Skalierung & Tests:</strong> Themencluster ausbauen, Tests und kontinuierliche Verbesserung.</li>
      </ol>

      <div class="mt-10 rounded-2xl border border-[#94A3B8]/40 bg-[#0B1220] p-6 text-white">
        <div class="text-lg font-semibold">Lassen Sie uns starten</div>
        <p class="mt-1 text-white/80">In 30 Minuten klären wir Ziele, Potenziale und den nächsten sinnvollen Schritt.</p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href={`tel:${contact.phone.replace(/\s+/g, '')}`} class="inline-flex items-center gap-2 rounded-full bg-[#22D3EE] px-5 py-3 font-semibold text-[#0B1220] hover:bg-[#22D3EE]/90 transition-colors">Jetzt anrufen</a>
          <a href={`mailto:${contact.email}`} class="inline-flex items-center gap-2 rounded-full border border-white/20 px-5 py-3 text-white hover:bg-white/10 transition-colors">E‑Mail schreiben</a>
        </div>
      </div>
    </div>

    <aside class="lg:col-span-1">
      <div class="rounded-2xl border border-[#94A3B8]/40 bg-white p-6">
        <div class="text-sm font-semibold">Weitere Leistungen</div>
        <nav class="mt-3 grid grid-cols-1 gap-2">
          {others.map((o) => (
            <a href={`/leistungen/${o.slug}`} class="text-sm text-[#1B2A4A] hover:text-[#22D3EE] transition-colors">{o.title}</a>
          ))}
        </nav>
        <a href="/" class="mt-4 inline-block text-xs text-[#475569] hover:text-[#0B1220]">← Zur Startseite</a>
      </div>
    </aside>
  </section>

  <section id="kontakt" class="scroll-mt-24 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-16">
    <div class="rounded-2xl border border-[#94A3B8]/40 bg-white p-8">
      <h2 class="text-xl font-semibold">Kostenloses Erstgespräch</h2>
      <p class="mt-2 text-[#475569]">Wir zeigen transparent, wie wir Ihre SEO‑Sichtbarkeit steigern – lokal und deutschlandweit.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href={`tel:${contact.phone.replace(/\s+/g, '')}`} class="inline-flex items-center gap-2 rounded-full bg-[#22D3EE] px-5 py-3 font-semibold text-[#0B1220] hover:bg-[#22D3EE]/90 transition-colors">Anrufen</a>
        <a href={`mailto:${contact.email}`} class="inline-flex items-center gap-2 rounded-full border border-[#1B2A4A]/20 px-5 py-3 font-semibold text-[#1B2A4A] hover:bg-[#1B2A4A]/5 transition-colors">E‑Mail</a>
      </div>
    </div>
  </section>
</Layout>
