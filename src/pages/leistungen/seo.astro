---
import Layout from "../../layouts/Layout.astro";
import { brand, colors, services } from "../../data/site";
const service = services.find(s => s.slug === 'seo');
const others = services.filter(s => s.slug !== 'seo');
---
<Layout title={`${service?.title} – ${brand.name}`} description={service?.shortDescription ?? brand.tagline}>
  <section class={`bg-white border-b border-[${colors.muted}]/20`}>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-16 pb-10">
      <nav class="text-sm"><a href="/" class={`text-[${colors.primary}] hover:text-[${colors.secondary}]`}>Start</a> <span class="text-black/40">/</span> <a href="/#leistungen" class={`text-[${colors.primary}] hover:text-[${colors.secondary}]`}>Leistungen</a> <span class="text-black/40">/</span> <span class="text-black/60">{service?.title}</span></nav>
      <h1 class={`mt-4 text-3xl md:text-5xl font-semibold text-[${colors.text}]`}>{service?.title}</h1>
      {service?.subtitle && <p class={`mt-3 text-lg text-[${colors.muted}]`}>{service.subtitle}</p>}
      {service?.shortDescription && <p class={`mt-6 max-w-3xl text-[${colors.text}]/80`}>{service.shortDescription}</p>}
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/#kontakt" class={`inline-flex items-center rounded-full bg-[${colors.primary}] px-5 py-2.5 text-white text-sm font-semibold border border-[${colors.gold}]`}>Kostenloses Erstgespräch</a>
        <a href="/#leistungen" class={`inline-flex items-center rounded-full border border-[${colors.primary}]/30 px-5 py-2.5 text-sm font-semibold text-[${colors.primary}] hover:border-[${colors.primary}]`}>Alle Leistungen</a>
      </div>
    </div>
  </section>

  <section class={`bg-[${colors.background}]`}>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 grid grid-cols-1 lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2">
        <div class={`prose max-w-none prose-headings:text-[${colors.text}] prose-p:text-[${colors.text}]/90 prose-li:text-[${colors.text}]/90`}>
          <h2>Wachstum durch Suchintention</h2>
          <p>SEO ist kein Zufall, sondern das Ergebnis einer klaren Informationsarchitektur, präziser Keyword-Cluster und technischer Exzellenz. Wir verbinden Technik, Content und Autorität zu einem System, das planbar Sichtbarkeit in relevanten Suchmomenten erzeugt.</p>
          <h3>Unser Ansatz</h3>
          <ul>
            <li>Technik-Fundament: Performance, Crawlbarkeit, Indexierung und CWV auf Agenturstandard.</li>
            <li>Content-Engine: Suchintention-optimierte Inhalte mit sauberer Struktur und interner Verlinkung.</li>
            <li>Autorität: Qualitäts-Backlinks, Citations und konsistente NAP-Daten für lokale Stärke.</li>
            <li>Local SEO: Google Business Profil inkl. Posts, Angebote und Pflege – sichtbar in Maps.</li>
          </ul>
          <h3>Leistungsbausteine</h3>
          {service?.features && (
            <ul>
              {service.features.map((f) => (<li>{f}</li>))}
            </ul>
          )}
          <h3>Liefergegenstände</h3>
          <ul>
            <li>Technik-Audit inkl. Maßnahmenplan und Quick-Wins</li>
            <li>Keyword-Strategie, Seitenarchitektur und Content-Briefings</li>
            <li>Onpage-Optimierung, Schema Markup und interne Verlinkung</li>
            <li>Local-Listings in >30 Portalen, GBP-Redaktionsplan und Postings</li>
            <li>Monatliches Reporting mit Rankings, Leads, Sichtbarkeit und KPIs</li>
          </ul>
          <h3>Warum jetzt?</h3>
          <p>Organische Sichtbarkeit senkt Ihre Akquisekosten nachhaltig. Wer in Ihrer Nische Autorität aufbaut, profitiert langfristig von stabilen Rankings und planbaren Anfragen – unabhängig von Tagesbudgets.</p>
        </div>
        <div class={`mt-10 rounded-2xl border border-[${colors.muted}]/20 bg-white p-6`}>
          <h3 class={`text-base font-semibold text-[${colors.primary}]`}>Nächster Schritt</h3>
          <p class="mt-2 text-sm text-black/80">In 20 Minuten klären wir Ziele, Status und Hebel. Sie erhalten eine ehrliche Ersteinschätzung mit konkreten Maßnahmen.</p>
          <a href="/#kontakt" class={`mt-4 inline-flex items-center rounded-full bg-[${colors.secondary}] px-5 py-2.5 text-white text-sm font-semibold`}>Gespräch buchen</a>
        </div>
      </div>
      <aside class="lg:col-span-1">
        <div class={`rounded-2xl border border-[${colors.muted}]/20 bg-white p-6`}>
          <h3 class={`text-sm font-semibold text-[${colors.muted}] uppercase tracking-wide`}>Weitere Leistungen</h3>
          <ul class="mt-3 space-y-2">
            {others.map((o) => (
              <li>
                <a href={`/leistungen/${o.slug}`} class={`block rounded-md px-3 py-2 text-sm text-[${colors.primary}] hover:bg-[${colors.background}]`}>
                  <span class="font-medium">{o.title}</span>
                  {o.shortDescription && <span class="block text-[${colors.muted}]">{o.shortDescription}</span>}
                </a>
              </li>
            ))}
          </ul>
          <a href="/" class={`mt-4 inline-flex text-sm text-[${colors.text}]/70 hover:text-[${colors.text}]`}>Zur Startseite</a>
        </div>
      </aside>
    </div>
  </section>
</Layout>
