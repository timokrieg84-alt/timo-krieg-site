---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Section from "@/components/Section.astro";
import CTA from "@/components/CTA-Bar.astro";
import Footer from "@/components/Footer.astro";
import HeadSEO from "@/components/HeadSEO.astro";
const meta = {
  title: "Online‑Terminbuchung für Praxen | DSGVO & PVS‑fähig",
  description: "Weniger Telefonlast, mehr Planbarkeit: Buchungsstrecke, Kalender, Erinnerungen. Integrationen zu gängigen Praxis‑Systemen.",
  url: "https://example.com/leistungen/online-terminbuchung/",
  canonical: "https://example.com/leistungen/online-terminbuchung/",
  image: "/images/hero-bg.webp",
  type: "article"
};
---
<html lang="de" class="dark">
  <head>
    <HeadSEO {...meta} />
    <script type="application/ld+json">
      {JSON.stringify({"@context":"https://schema.org","@type":"Service","@id":"https://example.com/leistungen/online-terminbuchung/#service","name":"Online‑Terminbuchung für Praxen","serviceType":"Online Appointment Booking (Healthcare)","provider":{"@id":"https://example.com/#organization"},"areaServed":[{"@type":"Country","name":"Germany"}],"audience":{"@type":"MedicalAudience","audienceType":"Healthcare Practices"}})}
    </script>
  </head>
  <body>
    <Layout title={meta.title} description={meta.description}>
      <Fragment slot="nav"><Navbar /></Fragment>
      <Section id="intro" title="Termine rund um die Uhr per Klick." intro="Reibungslose Online‑Terminvergabe – integriert in Website und Portale, vollständig automatisiert und messbar.">
        <div class="grid md:grid-cols-2 gap-8">
          <article class="card p-6">
            <h3 class="h3">Leistungspaket</h3>
            <ul class="mt-3 text-txt-2 grid gap-2">
              <li>• Jameda & Doctolib‑Integration</li>
              <li>• Echtzeit‑API‑Anbindung an PVS</li>
              <li>• Suchmaschinen & Portaleinbindung</li>
              <li>• Erinnerungen, Warteliste, Ausfälle reduzieren</li>
            </ul>
            <div class="mt-6 flex gap-3">
              <a href="/projekt-anfragen" class="btn btn-primary btn-glare">Angebot anfragen</a>
              <a href="/kontakt" class="btn btn-secondary">Beratung buchen</a>
            </div>
          </article>
          <article class="card p-6">
            <h3 class="h3">Messpunkte</h3>
            <ul class="mt-3 text-txt-2 grid gap-2">
              <li>• Online‑Terminquote vs. Telefon</li>
              <li>• No‑Show‑Rate & Auslastung</li>
              <li>• Bearbeitungszeit & Patientenzufriedenheit</li>
              <li>• Conversion‑Rate der Buchungsstrecke</li>
            </ul>
          </article>
        </div>
      </Section>
      <CTA />
      <Fragment slot="footer"><Footer /></Fragment>
    </Layout>
  </body>
</html>
