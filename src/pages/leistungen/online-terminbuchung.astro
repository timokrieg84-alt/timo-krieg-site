---
import Layout from "../../layouts/Layout.astro";
import { brand, colors, services } from "../../data/site";
const service = services.find(s => s.slug === 'online-terminbuchung');
const others = services.filter(s => s.slug !== 'online-terminbuchung');
---
<Layout title={`${service?.title} – ${brand.name}`} description={service?.shortDescription ?? brand.tagline}>
  <section class={`bg-[${colors.background}] border-b border-[${colors.muted}]/20`}>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-16 pb-10">
      <nav class="text-sm"><a href="/" class={`text-[${colors.primary}] hover:text-[${colors.secondary}]`}>Start</a> <span class={`text-[${colors.text}]/40`}>/</span> <a href="/#leistungen" class={`text-[${colors.primary}] hover:text-[${colors.secondary}]`}>Leistungen</a> <span class={`text-[${colors.text}]/40`}>/</span> <span class={`text-[${colors.text}]/60`}>{service?.title}</span></nav>
      <h1 class={`mt-4 text-3xl md:text-5xl font-semibold text-[${colors.text}]`}>{service?.title}</h1>
      {service?.subtitle && <p class={`mt-3 text-lg text-[${colors.muted}]`}>{service.subtitle}</p>}
      {service?.shortDescription && <p class={`mt-6 max-w-3xl text-[${colors.text}]/80`}>{service.shortDescription}</p>}
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/#kontakt" class={`inline-flex items-center rounded-full bg-[${colors.primary}] px-5 py-2.5 text-[${colors.background}] text-sm font-semibold border border-[${colors.gold}]`}>Projekt starten</a>
        <a href="/#leistungen" class={`inline-flex items-center rounded-full border border-[${colors.primary}]/30 px-5 py-2.5 text-sm font-semibold text-[${colors.primary}] hover:border-[${colors.primary}] hover:bg-[${colors.accent}]/10`}>Alle Leistungen</a>
      </div>
    </div>
  </section>

  <section class={`bg-[${colors.background}]`}>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 grid grid-cols-1 lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2">
        <div>
          <h2 class={`text-2xl font-semibold text-[${colors.text}]`}>24/7-Terminvergabe ohne Mehraufwand</h2>
          <p class={`mt-4 text-[${colors.text}]/90`}>Wir integrieren smarte Terminbuchungssysteme direkt in Ihre Website und in relevante Portale. Buchungen, Verschiebungen und Stornierungen laufen automatisiert – mit Erinnerungen, Regeln und nahtloser Kalender-Anbindung.</p>
          <h3 class={`mt-8 text-xl font-semibold text-[${colors.text}]`}>Vorgehen</h3>
          <ul class="mt-3 space-y-2 text-sm text-[${colors.text}]/90">
            <li>Systemauswahl (z. B. Doctolib/Jameda) auf Basis Ihrer Anforderungen</li>
            <li>Echtzeit-API-Anbindung an Kalender, E-Mail und SMS</li>
            <li>No-Show-Reduktion durch smarte Erinnerungen und Zeitfensterlogik</li>
            <li>DSGVO-konformes Setup inkl. Einwilligungen und Auftragsverarbeitung</li>
          </ul>
          <h3 class={`mt-8 text-xl font-semibold text-[${colors.text}]`}>Leistungsbausteine</h3>
          {service?.features && (
            <ul class="mt-3 space-y-2 text-sm text-[${colors.text}]/90">
              {service.features.map((f) => (<li>{f}</li>))}
            </ul>
          )}
          <h3 class={`mt-8 text-xl font-semibold text-[${colors.text}]`}>Ergebnis</h3>
          <p class={`mt-3 text-[${colors.text}]/90`}>Ihre Praxis oder Ihr Betrieb ist rund um die Uhr buchbar. Die Auslastung steigt, Rückfragen sinken – mit messbar weniger administrativem Aufwand.</p>
        </div>
        <div class={`mt-10 rounded-2xl border border-[${colors.muted}]/20 bg-[${colors.background}] p-6`}>
          <h3 class={`text-base font-semibold text-[${colors.primary}]`}>Nächster Schritt</h3>
          <p class={`mt-2 text-sm text-[${colors.text}]/80`}>In einem Kurz-Check klären wir System, Schnittstellen und Go-Live-Zeitplan.</p>
          <a href="/#kontakt" class={`mt-4 inline-flex items-center rounded-full bg-[${colors.secondary}] px-5 py-2.5 text-[${colors.background}] text-sm font-semibold`}>Gespräch buchen</a>
        </div>
      </div>
      <aside class="lg:col-span-1">
        <div class={`rounded-2xl border border-[${colors.muted}]/20 bg-[${colors.background}] p-6`}>
          <h3 class={`text-sm font-semibold text-[${colors.muted}] uppercase tracking-wide`}>Weitere Leistungen</h3>
          <ul class="mt-3 space-y-2">
            {others.map((o) => (
              <li>
                <a href={`/leistungen/${o.slug}`} class={`block rounded-md px-3 py-2 text-sm text-[${colors.primary}] hover:bg-[${colors.accent}]/10`}>
                  <span class="font-medium">{o.title}</span>
                  {o.shortDescription && <span class={`block text-[${colors.muted}]`}>{o.shortDescription}</span>}
                </a>
              </li>
            ))}
          </ul>
          <a href="/" class={`mt-4 inline-flex text-sm text-[${colors.text}]/70 hover:text-[${colors.text}]`}>Zur Startseite</a>
        </div>
      </aside>
    </div>
  </section>
</Layout>
