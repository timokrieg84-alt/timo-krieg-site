---
import '../../styles/global.css';
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Google Ads (SEA) & LinkedIn | Leistungen | Timo Krieg</title>
  <meta name="description" content="B2B-Performance mit Google Ads und LinkedIn: klares Targeting, präzise Botschaften, sauberes Conversion-Tracking." />
</head>
<body class="min-h-screen bg-slate-950 text-white font-sans">
  <header class="border-b border-white/10">
    <div class="container py-4 flex items-center justify-between">
      <a href="/" class="font-semibold">Timo Krieg</a>
      <nav class="hidden md:flex items-center gap-6">
        <a href="/leistungen/" class="underline">Leistungen</a>
        <a href="/ueber-uns">Über uns</a>
        <a href="/kontakt">Kontakt</a>
      </nav>
    </div>
  </header>

  <main class="py-16 md:py-24">
    <div class="container">
      <h1 class="text-3xl md:text-5xl font-semibold">Google Ads (SEA) & LinkedIn</h1>
      <p class="mt-4 text-slate-300 max-w-2xl">Planen, testen, skalieren – qualifizierte B2B-Leads mit Fokus auf Profitabilität.</p>
      <div class="mt-8 grid gap-6 md:grid-cols-2">
        <div class="card">
          <h2 class="text-xl font-semibold">Leistung</h2>
          <ul class="mt-3 list-disc pl-6 text-slate-300 space-y-1">
            <li>Präzises Targeting & klare Botschaften</li>
            <li>Saubere Kontostruktur, Quality Score</li>
            <li>Conversion-Tracking end-to-end</li>
          </ul>
        </div>
        <div class="card">
          <h2 class="text-xl font-semibold">Ergebnis</h2>
          <ul class="mt-3 list-disc pl-6 text-slate-300 space-y-1">
            <li>Planbare Leadkosten (CPL)</li>
            <li>Skalierbarer ROAS</li>
            <li>Transparente Dashboards</li>
          </ul>
        </div>
      </div>
      <div class="mt-8 flex gap-3">
        <a href="/kontakt" class="btn btn-primary">Kampagne starten</a>
        <a href="/leistungen/" class="btn btn-secondary">Zur Übersicht</a>
      </div>
    </div>
  </main>

  <footer class="mt-16 border-t border-white/10">
    <div class="container py-8 text-sm text-slate-400 flex items-center justify-between">
      <span>© {new Date().getFullYear()} Timo Krieg</span>
      <nav class="flex gap-4"><a class="underline" href="/impressum">Impressum</a><a class="underline" href="/datenschutz">Datenschutz</a></nav>
    </div>
  </footer>
</body>
</html>
