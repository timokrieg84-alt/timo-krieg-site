---
import '../../styles/global.css';
const title = 'Hosting & Wartung: Sichere, schnelle Websites | Astro/Headless | Timo Krieg';
const description = 'Proaktives Monitoring, Sicherheitsupdates, Backups & Performance‑Tuning. Hosting & Wartung für Astro, Headless & WordPress – DSGVO‑konform.';
const canonical = '/leistungen/hosting-wartung/';
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="/og-default.jpg" />
  <script type="application/ld+json">{JSON.stringify({
    '@context':'https://schema.org','@type':'Service',serviceType:'Hosting & Wartung',category:'https://schema.org/ProfessionalService',
    provider:{'@type':'LocalBusiness',name:'Timo Krieg',address:{'@type':'PostalAddress',postalCode:'73529',addressLocality:'Schwäbisch Gmünd',addressCountry:'DE'},areaServed:['DE','AT','CH']},
    url: canonical
  })}</script>
  <script type="application/ld+json">{JSON.stringify({
    '@context':'https://schema.org','@type':'WebPage', name:title, description, url: canonical, inLanguage:'de',
    breadcrumb:{'@type':'BreadcrumbList', itemListElement:[{'@type':'ListItem', position:1, name:'Start', item:'/'},{'@type':'ListItem', position:2, name:'Leistungen', item:'/leistungen/'},{'@type':'ListItem', position:3, name:'Hosting & Wartung', item: canonical}]}
  })}</script>
</head>
<body>
  <header class="border-b border-slate-200 bg-white/70 backdrop-blur sticky top-0 z-50">
    <div class="container py-4 flex items-center justify-between gap-4">
      <a href="/" class="font-semibold tracking-tight">Timo Krieg</a>
      <nav class="hidden md:flex items-center gap-6 text-sm">
        <a href="/leistungen/" class="nav-link">Leistungen</a>
        <a href="/ueber-uns" class="nav-link">Über uns</a>
        <a href="/kontakt" class="nav-link">Kontakt</a>
        <a href="tel:+491604365363" class="btn btn-primary">Jetzt anrufen</a>
      </nav>
      <a href="/kontakt" class="md:hidden btn btn-primary">Kontakt</a>
    </div>
  </header>

  <main>
    <section class="section">
      <div class="container grid gap-8 lg:grid-cols-2 items-start">
        <div>
          <h1 class="text-4xl md:text-5xl font-semibold tracking-tight">Sicher. Schnell. Sorglos.</h1>
          <p class="mt-4 text-lg text-slate-600">Hosting, Wartung und DSGVO‑Setups, die laufen – damit Ihr Marketing nicht ins Stocken gerät.</p>
          <div class="mt-6 flex gap-3">
            <a href="/kontakt" class="btn btn-primary">Betriebssicher werden</a>
            <a href="/leistungen/webentwicklung-astro-tailwind/" class="btn btn-secondary">Mit Webentwicklung kombinieren</a>
          </div>
        </div>
        <ul class="card space-y-2">
          <li>Performance‑Hosting & CDN, Monitoring, Uptime‑Alerts</li>
          <li>Updates, Backups, Sicherheitsmaßnahmen</li>
          <li>Consent‑Management, Cookie‑Banner, Datenschutz‑Doku</li>
          <li>Tracking‑Qualitätssicherung & Incident‑Response</li>
        </ul>
      </div>
    </section>

    <section class="section bg-slate-50">
      <div class="container">
        <h2 class="text-3xl md:text-4xl font-semibold tracking-tight">In 4 Schritten zum stabilen Betrieb</h2>
        <ol class="mt-8 grid gap-6 md:grid-cols-4">
          <li class="card"><h3 class="font-semibold">1) Setup</h3><p class="mt-1 text-slate-600">Infra, Domains, Zertifikate.</p></li>
          <li class="card"><h3 class="font-semibold">2) Absicherung</h3><p class="mt-1 text-slate-600">Backups, Policies, Rechte.</p></li>
          <li class="card"><h3 class="font-semibold">3) Betrieb</h3><p class="mt-1 text-slate-600">Monitoring, Updates, Performance.</p></li>
          <li class="card"><h3 class="font-semibold">4) Review</h3><p class="mt-1 text-slate-600">Quartalschecks & Optimierung.</p></li>
        </ol>
      </div>
    </section>

    <section class="section">
      <div class="container grid gap-6 md:grid-cols-2">
        <div class="card">
          <h2 class="text-2xl font-semibold">Vorteile für den Mittelstand</h2>
          <ul class="mt-3 list-disc pl-5 text-slate-600 space-y-1">
            <li>Weniger Risiko, klare Verantwortlichkeiten</li>
            <li>Schnelle Ladezeiten & stabile Verfügbarkeit</li>
            <li>Saubere Compliance als Wettbewerbsfaktor</li>
            <li>Ein Ansprechpartner für Technik & Marketing</li>
          </ul>
        </div>
        <div class="card">
          <h2 class="text-2xl font-semibold">FAQ</h2>
          <details class="mt-3 group rounded-xl border border-slate-200 bg-white p-5 hover:bg-slate-50 transition"><summary class="font-medium">Wo hosten Sie?</summary><div class="mt-2 text-slate-600">DSGVO‑konform, bevorzugt in der EU – je nach Projekt mit Edge‑CDN.</div></details>
          <details class="mt-3 group rounded-xl border border-slate-200 bg-white p-5 hover:bg-slate-50 transition"><summary class="font-medium">Ist Wechsel ohne Downtime möglich?</summary><div class="mt-2 text-slate-600">In der Regel ja – mit sauberer Planung.</div></details>
          <details class="mt-3 group rounded-xl border border-slate-200 bg-white p-5 hover:bg-slate-50 transition"><summary class="font-medium">Betreuen Sie Fremdseiten?</summary><div class="mt-2 text-slate-600">Ja, nach kurzem Technik‑Audit.</div></details>
          <details class="mt-3 group rounded-xl border border-slate-200 bg-white p-5 hover:bg-slate-50 transition"><summary class="font-medium">Wie läuft Consent‑Management?</summary><div class="mt-2 text-slate-600">Granular, dokumentiert, updatesicher.</div></details>
        </div>
      </div>
      <div class="container mt-8"><a href="/kontakt" class="btn btn-primary">Kostenloses Erstgespräch</a></div>
    </section>
  </main>

  <footer class="border-t border-slate-200">
    <div class="container py-8 text-sm text-slate-600 flex flex-col md:flex-row items-center justify-between gap-3">
      <span>© {new Date().getFullYear()} Timo Krieg – Performance Marketing</span>
      <nav class="flex items-center gap-4">
        <a class="underline decoration-slate-300 underline-offset-4 hover:decoration-slate-400" href="/impressum">Impressum</a>
        <a class="underline decoration-slate-300 underline-offset-4 hover:decoration-slate-400" href="/datenschutz">Datenschutz</a>
      </nav>
    </div>
  </footer>
</body>
</html>
