---
import Layout from "../../layouts/Layout.astro";
import { site } from "../../data/site";
const service = site.services.find((s)=> s.slug === 'google-ads')!;
const related = service.related.map((slug)=> site.services.find((s)=> s.slug === slug)!);
---
<Layout>
  <section class="py-16 sm:py-24 lg:py-28">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <a href="/" class="text-sm text-[var(--primary)] hover:text-[var(--secondary)]">← Zurück zur Startseite</a>
      <h1 class="mt-4 text-3xl sm:text-5xl font-semibold text-[var(--text)]">{service.title}</h1>
      <p class="mt-3 text-lg text-[var(--text)]/80">{service.subtitle}</p>
      <div class="mt-6 rounded-2xl border border-[var(--primary)]/10 bg-white p-6">
        <p class="text-[var(--text)]/80 whitespace-pre-line">{service.longDescription}</p>
        <h2 class="mt-8 text-xl font-semibold text-[var(--text)]">Kernmodule</h2>
        <ul class="mt-3 grid gap-2 list-disc list-inside text-[var(--text)]/80">
          {service.features.map((f)=> (<li>{f}</li>))}
        </ul>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/#contact" class="inline-flex items-center gap-2 rounded-full bg-[var(--primary)] px-5 py-3 text-white hover:bg-[var(--secondary)] transition-colors">Budget besprechen</a>
          <a href="/leistungen/seo" class="inline-flex items-center gap-2 rounded-full border border-[var(--primary)]/20 bg-white px-5 py-3 text-[var(--primary)] hover:border-[var(--secondary)] hover:text-[var(--secondary)] transition-colors">SEO kombinieren</a>
        </div>
      </div>

      <div class="mt-12">
        <h2 class="text-xl font-semibold text-[var(--text)]">Oft kombiniert mit</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {related.map((r)=> (
            <a href={`/leistungen/${r.slug}`} class="group rounded-2xl border border-[var(--primary)]/10 bg-white p-5 hover:shadow-md transition-shadow">
              <div class="text-xs uppercase tracking-wide text-[var(--primary)]">{r.subtitle}</div>
              <div class="mt-1 text-lg font-semibold text-[var(--text)]">{r.title}</div>
              <p class="mt-2 text-[var(--text)]/70">{r.shortDescription}</p>
              <span class="mt-3 inline-flex items-center gap-2 text-[var(--primary)] group-hover:text-[var(--secondary)]">Mehr erfahren →</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
