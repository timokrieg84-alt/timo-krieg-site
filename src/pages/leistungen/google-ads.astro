---
import BaseLayout from "../../layouts/BaseLayout.astro";
const title = "Google Ads Agentur Schwäbisch Gmünd | SEA‑Audit, Setup & Skalierung";
const description = "Such‑, Shopping‑, YouTube & PMax. Audit, Setup, Optimierung inkl. Tracking & Reporting.";
---
<BaseLayout title={title} description={description} path="/leistungen/google-ads/">
  <section class="section"><div class="container">
    <h1 class="h1">Google Ads mit Rendite – präzise, transparent, skalierbar.</h1>
    <p class="lead">Klare Ziel‑CPA/ROAS‑Steuerung, saubere Kontostruktur, transparente Reports.</p>
    <div class="grid" style="grid-template-columns:repeat(2,minmax(0,1fr));gap:24px">
      <div class="card"><h3>Pakete</h3><ul><li>Konto‑Audit</li><li>Setup (Search, PMax, Shopping)</li><li>Laufende Optimierung</li><li>B2B Lead‑Gen / E‑Commerce</li></ul></div>
      <div class="card"><h3>Prozess</h3><ol><li>Ziele & Zahlen</li><li>Aufbau</li><li>Optimierung</li></ol></div>
    </div>
    <h3 class="h3" style="margin-top:24px;">FAQ</h3>
    <details class="card"><summary>Funktioniert PMax für uns?</summary><div>Ja – mit sauberem Feed, klaren Signalen und Brand‑Schutz.</div></details>
    <details class="card"><summary>Übernehmen Sie bestehende Konten?</summary><div>Ja, inkl. Migrationsplan und Quick Wins.</div></details>
    <a class="btn btn--outline" href="/kontakt/" style="margin-top:16px;">Google Ads optimieren – Gespräch buchen</a>
  </div></section>
</BaseLayout>
