---
import Layout from "../../layouts/Layout.astro";
import { brand, colors, services } from "../../data/site";
const service = services.find(s => s.slug === 'google-ads');
const others = services.filter(s => s.slug !== 'google-ads');
---
<Layout title={`${service?.title} – ${brand.name}`} description={service?.shortDescription ?? brand.tagline}>
  <section class={`bg-[${colors.background}] border-b border-[${colors.muted}]/20`}>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-16 pb-10">
      <nav class="text-sm"><a href="/" class={`text-[${colors.primary}] hover:text-[${colors.secondary}]`}>Start</a> <span class={`text-[${colors.text}]/40`}>/</span> <a href="/#leistungen" class={`text-[${colors.primary}] hover:text-[${colors.secondary}]`}>Leistungen</a> <span class={`text-[${colors.text}]/40`}>/</span> <span class={`text-[${colors.text}]/60`}>{service?.title}</span></nav>
      <h1 class={`mt-4 text-3xl md:text-5xl font-semibold text-[${colors.text}]`}>{service?.title}</h1>
      {service?.subtitle && <p class={`mt-3 text-lg text-[${colors.muted}]`}>{service.subtitle}</p>}
      {service?.shortDescription && <p class={`mt-6 max-w-3xl text-[${colors.text}]/80`}>{service.shortDescription}</p>}
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/#kontakt" class={`inline-flex items-center rounded-full bg-[${colors.primary}] px-5 py-2.5 text-[${colors.background}] text-sm font-semibold border border-[${colors.gold}]`}>Beratung anfragen</a>
        <a href="/#leistungen" class={`inline-flex items-center rounded-full border border-[${colors.primary}]/30 px-5 py-2.5 text-sm font-semibold text-[${colors.primary}] hover:border-[${colors.primary}] hover:bg-[${colors.accent}]/10`}>Alle Leistungen</a>
      </div>
    </div>
  </section>

  <section class={`bg-[${colors.background}]`}>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 grid grid-cols-1 lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2">
        <div class={`prose max-w-none prose-headings:text-[${colors.text}] prose-p:text-[${colors.text}]/90 prose-li:text-[${colors.text}]/90`}>
          <h2>Absicht trifft Angebot</h2>
          <p>Google Ads performt, wenn Relevanz, Gebote und Zielseiten millimetergenau zusammenspielen. Wir bauen ein Setup, das Suchintention in qualifizierte Leads und Umsatz verwandelt – transparent, skalierbar und budgeteffizient.</p>
          <h3>Methodik</h3>
          <ul>
            <li>Fundierte Kontostruktur: Kampagnen nach Intent und Profit-Potenzial, klare Namenskonventionen.</li>
            <li>First-Party-Tracking: GA4, Consent-Setup und optional serverseitiges Tracking für robuste Daten.</li>
            <li>Kreative Varianten: Anzeigentexte und Assets, die testen, lernen und Gewinner zementieren.</li>
            <li>Conversion-getrimmte Landing Pages: Schnelle Ladezeiten, glasklare Botschaften, starke CTAs.</li>
          </ul>
          <h3>Leistungsbausteine</h3>
          {service?.features && (
            <ul>
              {service.features.map((f) => (<li>{f}</li>))}
            </ul>
          )}
          <h3>Liefergegenstände</h3>
          <ul>
            <li>Konto-Audit inkl. Quick-Wins und Roadmap</li>
            <li>Kampagnen-Setup (Search, PMax, YouTube) inkl. Feed-/Asset-Erstellung</li>
            <li>Conversion-Tracking, Consent-Check und Event-Mapping</li>
            <li>Landing-Page-Konzept und -Umsetzung inkl. A/B-Testplan</li>
            <li>Wöchentliches Monitoring, monatliches Reporting mit CPL/CPA & ROAS</li>
          </ul>
          <h3>Erfolgsmessung</h3>
          <p>Wir reporten nicht nur Klicks, sondern Pipeline-Qualität: Leads, Abschlüsse, Kosten je Abschluss und Deckungsbeiträge. Entscheidungen basieren auf realen Geschäftszahlen.</p>
          <h3>FAQ</h3>
          <p><strong>Wie hoch sollte das Startbudget sein?</strong><br/>Wir arbeiten ab 200 € mtl. Media-Spend sinnvoll – optimal sind 1.000–4.000 € je nach Markt.</p>
          <p><strong>Wie schnell gibt es Ergebnisse?</strong><br/>Erste belastbare Learnings nach 2–4 Wochen, stabile Performance nach 6–8 Wochen.</p>
          <p><strong>Übernehmt ihr bestehende Konten?</strong><br/>Ja. Wir migrieren sauber oder optimieren inkrementell – ohne Datenverlust.</p>
        </div>
        <div class={`mt-10 rounded-2xl border border-[${colors.muted}]/20 bg-[${colors.background}] p-6`}>
          <h3 class={`text-base font-semibold text-[${colors.primary}]`}>Nächster Schritt</h3>
          <p class={`mt-2 text-sm text-[${colors.text}]/80`}>Kostenloses Erstgespräch: Ziele, Status, Budgetrahmen. Wir skizzieren den Fahrplan – klar und pragmatisch.</p>
          <a href="/#kontakt" class={`mt-4 inline-flex items-center rounded-full bg-[${colors.secondary}] px-5 py-2.5 text-[${colors.background}] text-sm font-semibold`}>Gespräch buchen</a>
        </div>
      </div>
      <aside class="lg:col-span-1">
        <div class={`rounded-2xl border border-[${colors.muted}]/20 bg-[${colors.background}] p-6`}>
          <h3 class={`text-sm font-semibold text-[${colors.muted}] uppercase tracking-wide`}>Weitere Leistungen</h3>
          <ul class="mt-3 space-y-2">
            {others.map((o) => (
              <li>
                <a href={`/leistungen/${o.slug}`} class={`block rounded-md px-3 py-2 text-sm text-[${colors.primary}] hover:bg-[${colors.accent}]/10`}>
                  <span class="font-medium">{o.title}</span>
                  {o.shortDescription && <span class={`block text-[${colors.muted}]`}>{o.shortDescription}</span>}
                </a>
              </li>
            ))}
          </ul>
          <a href="/" class={`mt-4 inline-flex text-sm text-[${colors.text}]/70 hover:text-[${colors.text}]`}>Zur Startseite</a>
        </div>
      </aside>
    </div>
  </section>
</Layout>
