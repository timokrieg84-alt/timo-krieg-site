---
import Layout from "../../layouts/Layout.astro";
import { site } from "../../data/site";
const service = site.services.find((s)=> s.slug === 'ai-automation')!;
const related = service.related.map((slug)=> site.services.find((s)=> s.slug === slug)!);
---
<Layout>
  <section class="py-16 sm:py-24 lg:py-28">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <a href="/" class="text-sm text-[#123D2A] hover:text-[#C8501E]">← Zurück zur Startseite</a>
      <h1 class="mt-4 text-3xl sm:text-5xl font-semibold text-[#1A1A1A]">{service.title}</h1>
      <p class="mt-3 text-lg text-[#1A1A1A]/80">{service.subtitle}</p>
      <div class="mt-6 rounded-2xl border border-[#123D2A]/10 bg-[#F5F1E9] p-6">
        <p class="text-[#1A1A1A]/80 whitespace-pre-line">{service.longDescription}</p>
        <h2 class="mt-8 text-xl font-semibold text-[#1A1A1A]">Use Cases & Features</h2>
        <ul class="mt-3 grid gap-2 list-disc list-inside text-[#1A1A1A]/80">
          {service.features.map((f)=> (<li>{f}</li>))}
        </ul>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/#contact" class="inline-flex items-center gap-2 rounded-full bg-[#123D2A] px-5 py-3 text-[#F5F1E9] hover:bg-[#C8501E] transition-colors">Potential prüfen</a>
          <a href="/leistungen/programmierung" class="inline-flex items-center gap-2 rounded-full border border-[#123D2A]/20 bg-[#F5F1E9] px-5 py-3 text-[#123D2A] hover:border-[#C8501E] hover:text-[#C8501E] transition-colors">Mit Code verbinden</a>
        </div>
      </div>

      <div class="mt-12">
        <h2 class="text-xl font-semibold text-[#1A1A1A]">Verwandte Leistungen</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {related.map((r)=> (
            <a href={`/leistungen/${r.slug}`} class="group rounded-2xl border border-[#123D2A]/10 bg-[#F5F1E9] p-5 hover:shadow-md transition-shadow">
              <div class="text-xs uppercase tracking-wide text-[#123D2A]">{r.subtitle}</div>
              <div class="mt-1 text-lg font-semibold text-[#1A1A1A]">{r.title}</div>
              <p class="mt-2 text-[#1A1A1A]/70">{r.shortDescription}</p>
              <span class="mt-3 inline-flex items-center gap-2 text-[#123D2A] group-hover:text-[#C8501E]">Mehr erfahren →</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
