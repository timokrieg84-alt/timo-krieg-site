---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Section from "@/components/Section.astro";
import CTA from "@/components/CTA-Bar.astro";
import Footer from "@/components/Footer.astro";
import HeadSEO from "@/components/HeadSEO.astro";
const meta = {
  title: "AI & Automation | CRM, Workflows, Chatbots, Integrationen",
  description: "Wir automatisieren Marketing & Sales: Lead‑Routing, Scoring, E‑Mail, Bots – DSGVO‑konform, messbar, skalierbar.",
  url: "https://example.com/leistungen/ai-automation/",
  canonical: "https://example.com/leistungen/ai-automation/",
  image: "/images/hero-bg.webp",
  type: "article"
};
---
<html lang="de" class="dark">
  <head>
    <HeadSEO {...meta} />
    <script type="application/ld+json">
      {JSON.stringify({"@context":"https://schema.org","@type":"Service","@id":"https://example.com/leistungen/ai-automation/#service","name":"AI & Automation","serviceType":"Marketing Automation & AI","provider":{"@id":"https://example.com/#organization"},"areaServed":[{"@type":"Country","name":"Germany"}],"audience":{"@type":"BusinessAudience"}})}
    </script>
  </head>
  <body>
    <Layout title={meta.title} description={meta.description}>
      <Fragment slot="nav"><Navbar /></Fragment>
      <Section id="intro" title="Prozesse, die mitdenken." intro="Wir automatisieren wiederkehrende Aufgaben mit intelligenten Agenten, LLMs und integrierten Workflows – für echte Effizienzgewinne.">
        <div class="grid md:grid-cols-2 gap-8">
          <article class="card p-6">
            <h3 class="h3">Leistungspaket</h3>
            <ul class="mt-3 text-txt-2 grid gap-2">
              <li>• Custom AI Agents & Chatbots</li>
              <li>• LLM‑Integration in CRM/Tools</li>
              <li>• Workflow‑Automation (z. B. n8n, Make)</li>
              <li>• Governance & DSGVO‑Konzept</li>
            </ul>
            <div class="mt-6 flex gap-3">
              <a href="/projekt-anfragen" class="btn btn-primary btn-glare">Angebot anfragen</a>
              <a href="/kontakt" class="btn btn-secondary">Beratung buchen</a>
            </div>
          </article>
          <article class="card p-6">
            <h3 class="h3">Messpunkte</h3>
            <ul class="mt-3 text-txt-2 grid gap-2">
              <li>• Zeitersparnis je Prozess</li>
              <li>• Durchlaufzeit & Wartezeiten</li>
              <li>• Fehlerrate & Nacharbeit</li>
              <li>• Lead‑zu‑MQL‑Quote</li>
            </ul>
          </article>
        </div>
      </Section>
      <CTA />
      <Fragment slot="footer"><Footer /></Fragment>
    </Layout>
  </body>
</html>
