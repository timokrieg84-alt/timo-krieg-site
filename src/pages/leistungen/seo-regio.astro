---
import Layout from '../../layouts/Layout.astro';
import { brand, services, contact } from '../../data/site';
const service = services.find(s => s.slug === 'seo-regio');
const others = services.filter(s => s.slug !== 'seo-regio');
---
<Layout title={service?.seo.title ?? `${brand.name} – SEO‑Regio`} description={service?.seo.description}>
  <section class="relative bg-[#0B1220] text-white">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(34,211,238,0.14),transparent_45%)]"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
      <nav class="text-xs text-white/70"><a href="/" class="hover:text-white">Start</a> · <span>SEO‑Regio</span></nav>
      <h1 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight">SEO‑Regio: Umland dominieren</h1>
      <p class="mt-2 max-w-3xl text-white/80">{service?.short}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="#kontakt" class="inline-flex items-center gap-2 rounded-full bg-[#22D3EE] px-5 py-3 text-[#0B1220] font-semibold hover:bg-[#22D3EE]/90 transition-colors">Projekt anfragen</a>
        <a href="/" class="inline-flex items-center gap-2 rounded-full border border-white/20 px-5 py-3 text-white hover:bg-white/10 transition-colors">Zur Startseite</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14 grid grid-cols-1 lg:grid-cols-3 gap-10">
    <div class="lg:col-span-2">
      <h2 class="text-xl font-semibold">Warum SEO‑Regio wirkt</h2>
      <p class="mt-3 text-[#475569]">Für leistungsstarke regionale Sichtbarkeit braucht es mehr als eine einzige „Standortseite“. Wir schaffen eigenständige Ortschaften‑Webseiten mit individuellem, lokalem Content, technischer Trennung zur Hauptseite und starken Citations. So gewinnen Sie Suchanfragen aus dem gesamten Umland – ohne Ihre Hauptdomain zu verwässern.</p>

      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="rounded-xl border border-[#94A3B8]/40 bg-white p-5"><div class="text-sm font-semibold">Skalierbare Architektur</div><p class="mt-1 text-sm text-[#475569]">Wir planen 50+ Ortschaften sauber in Informationsarchitektur und interne Verlinkung ein – mit klarer Indexierungslogik.</p></div>
        <div class="rounded-xl border border-[#94A3B8]/40 bg-white p-5"><div class="text-sm font-semibold">Hyperlokaler Content</div><p class="mt-1 text-sm text-[#475569]">Jede Seite erhält individuellen Text, Cases und Signale, die echte Nähe und Relevanz beweisen.</p></div>
        <div class="rounded-xl border border-[#94A3B8]/40 bg-white p-5"><div class="text-sm font-semibold">Eigene Tracking‑Ebene</div><p class="mt-1 text-sm text-[#475569]">Performance je Ort messbar machen: Telefon‑/Form‑Events, Routen und Terminbuchungen.</p></div>
        <div class="rounded-xl border border-[#94A3B8]/40 bg-white p-5"><div class="text-sm font-semibold">Saubere Trennung</div><p class="mt-1 text-sm text-[#475569]">Technische Abkopplung von der Hauptseite schützt deren Autorität und vermeidet Duplicate Content.</p></div>
      </div>

      <h3 class="mt-10 text-lg font-semibold">Leistungsumfang</h3>
      <ul class="mt-3 space-y-2 text-sm text-[#0B1220]">
        {(service?.features ?? []).map((f) => (
          <li class="flex items-start gap-2"><span class="mt-2 h-1.5 w-1.5 rounded-full bg-[#22D3EE]"></span><span>{f}</span></li>
        ))}
        <li class="flex items-start gap-2"><span class="mt-2 h-1.5 w-1.5 rounded-full bg-[#22D3EE]"></span><span>Citations, lokale Backlinks & GBP‑Verknüpfung</span></li>
      </ul>

      <div class="mt-10 rounded-2xl border border-[#94A3B8]/40 bg-[#0B1220] p-6 text-white">
        <div class="text-lg font-semibold">Regionale Anfragen planbar steigern</div>
        <p class="mt-1 text-white/80">Wir zeigen anhand echter Nachfrage, mit welchen Orten Sie starten und wie Sie skalieren.</p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href={`tel:${contact.phone.replace(/\s+/g, '')}`} class="inline-flex items-center gap-2 rounded-full bg-[#22D3EE] px-5 py-3 font-semibold text-[#0B1220] hover:bg-[#22D3EE]/90 transition-colors">Jetzt anrufen</a>
          <a href={`mailto:${contact.email}`} class="inline-flex items-center gap-2 rounded-full border border-white/20 px-5 py-3 text-white hover:bg-white/10 transition-colors">E‑Mail schreiben</a>
        </div>
      </div>
    </div>

    <aside class="lg:col-span-1">
      <div class="rounded-2xl border border-[#94A3B8]/40 bg-white p-6">
        <div class="text-sm font-semibold">Weitere Leistungen</div>
        <nav class="mt-3 grid grid-cols-1 gap-2">
          {others.map((o) => (<a href={`/leistungen/${o.slug}`} class="text-sm text-[#1B2A4A] hover:text-[#22D3EE] transition-colors">{o.title}</a>))}
        </nav>
        <a href="/" class="mt-4 inline-block text-xs text-[#475569] hover:text-[#0B1220]">← Zur Startseite</a>
      </div>
    </aside>
  </section>

  <section id="kontakt" class="scroll-mt-24 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-16">
    <div class="rounded-2xl border border-[#94A3B8]/40 bg-white p-8">
      <h2 class="text-xl font-semibold">Kostenloses Erstgespräch</h2>
      <p class="mt-2 text-[#475569]">Wir planen Ihr Regio‑Setup und nennen belastbare Zeithorizonte.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href={`tel:${contact.phone.replace(/\s+/g, '')}`} class="inline-flex items-center gap-2 rounded-full bg-[#22D3EE] px-5 py-3 font-semibold text-[#0B1220] hover:bg-[#22D3EE]/90 transition-colors">Anrufen</a>
        <a href={`mailto:${contact.email}`} class="inline-flex items-center gap-2 rounded-full border border-[#1B2A4A]/20 px-5 py-3 font-semibold text-[#1B2A4A] hover:bg-[#1B2A4A]/5 transition-colors">E‑Mail</a>
      </div>
    </div>
  </section>
</Layout>
