---
import Layout from '../../layouts/Layout.astro';
import { brand, services, contact } from '../../data/site';
const service = services.find(s => s.slug === 'webdesign-ecommerce');
const others = services.filter(s => s.slug !== 'webdesign-ecommerce');
---
<Layout title={service?.seo.title ?? `${brand.name} – Webdesign & E‑Commerce`} description={service?.seo.description}>
  <section class="relative bg-[#0B1220] text-white">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(245,158,11,0.14),transparent_45%)]"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
      <nav class="text-xs text-white/70"><a href="/" class="hover:text-white">Start</a> · <span>Webdesign & E‑Commerce</span></nav>
      <h1 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight">Websites & Shops, die Umsatz lieben</h1>
      <p class="mt-2 max-w-3xl text-white/80">{service?.short}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="#kontakt" class="inline-flex items-center gap-2 rounded-full bg-[#22D3EE] px-5 py-3 text-[#0B1220] font-semibold hover:bg-[#22D3EE]/90 transition-colors">Projekt anfragen</a>
        <a href="/" class="inline-flex items-center gap-2 rounded-full border border-white/20 px-5 py-3 text-white hover:bg-white/10 transition-colors">Zur Startseite</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14 grid grid-cols-1 lg:grid-cols-3 gap-10">
    <div class="lg:col-span-2">
      <h2 class="text-xl font-semibold">Design, Performance, Conversion</h2>
      <p class="mt-3 text-[#475569]">Wir entwickeln individuelle Websites und Shops mit kompromissloser Performance. Technische Exzellenz (Core Web Vitals), klares Designsystem und Conversion‑Psychologie werden zu einem konsistenten Nutzererlebnis. Headless/Next.js oder WordPress – wir wählen, was zu Zielen und Team passt.</p>

      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="rounded-xl border border-[#94A3B8]/40 bg-white p-5"><div class="text-sm font-semibold">UX & Prototyping</div><p class="mt-1 text-sm text-[#475569]">Informationsarchitektur, Wireframes und interaktive Prototypen verkürzen Feedback‑Schleifen.</p></div>
        <div class="rounded-xl border border-[#94A3B8]/40 bg-white p-5"><div class="text-sm font-semibold">Core Web Vitals</div><p class="mt-1 text-sm text-[#475569]">LCP, INP, CLS im grünen Bereich – sauberer Code, Caching und Bild‑Pipelines.</p></div>
        <div class="rounded-xl border border-[#94A3B8]/40 bg-white p-5"><div class="text-sm font-semibold">CMS & Headless</div><p class="mt-1 text-sm text-[#475569]">Pragmatisches WordPress oder Headless‑Architektur mit Next.js – beides in Premium‑Qualität.</p></div>
        <div class="rounded-xl border border-[#94A3B8]/40 bg-white p-5"><div class="text-sm font-semibold">CRO & A/B‑Tests</div><p class="mt-1 text-sm text-[#475569]">Hypothesen‑getriebene Optimierung steigert Abschlussraten über den gesamten Funnel.</p></div>
      </div>

      <h3 class="mt-10 text-lg font-semibold">Leistungsumfang</h3>
      <ul class="mt-3 space-y-2 text-sm text-[#0B1220]">
        {(service?.features ?? []).map((f) => (
          <li class="flex items-start gap-2"><span class="mt-2 h-1.5 w-1.5 rounded-full bg-[#22D3EE]"></span><span>{f}</span></li>
        ))}
        <li class="flex items-start gap-2"><span class="mt-2 h-1.5 w-1.5 rounded-full bg-[#22D3EE]"></span><span>Qualitätssicherung, Schulung & Go‑Live‑Support</span></li>
      </ul>

      <div class="mt-10 rounded-2xl border border-[#94A3B8]/40 bg-[#0B1220] p-6 text-white">
        <div class="text-lg font-semibold">Bereit für den nächsten Relaunch</div>
        <p class="mt-1 text-white/80">Wir kombinieren schnelles Time‑to‑Value mit langfristiger Skalierbarkeit.</p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href={`tel:${contact.phone.replace(/\s+/g, '')}`} class="inline-flex items-center gap-2 rounded-full bg-[#22D3EE] px-5 py-3 font-semibold text-[#0B1220] hover:bg-[#22D3EE]/90 transition-colors">Jetzt anrufen</a>
          <a href={`mailto:${contact.email}`} class="inline-flex items-center gap-2 rounded-full border border-white/20 px-5 py-3 text-white hover:bg-white/10 transition-colors">E‑Mail schreiben</a>
        </div>
      </div>
    </div>

    <aside class="lg:col-span-1">
      <div class="rounded-2xl border border-[#94A3B8]/40 bg-white p-6">
        <div class="text-sm font-semibold">Weitere Leistungen</div>
        <nav class="mt-3 grid grid-cols-1 gap-2">
          {others.map((o) => (<a href={`/leistungen/${o.slug}`} class="text-sm text-[#1B2A4A] hover:text-[#22D3EE] transition-colors">{o.title}</a>))}
        </nav>
        <a href="/" class="mt-4 inline-block text-xs text-[#475569] hover:text-[#0B1220]">← Zur Startseite</a>
      </div>
    </aside>
  </section>

  <section id="kontakt" class="scroll-mt-24 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-16">
    <div class="rounded-2xl border border-[#94A3B8]/40 bg-white p-8">
      <h2 class="text-xl font-semibold">Kostenloses Erstgespräch</h2>
      <p class="mt-2 text-[#475569]">Wir entwickeln einen klaren, priorisierten Projektplan – transparent und messbar.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href={`tel:${contact.phone.replace(/\s+/g, '')}`} class="inline-flex items-center gap-2 rounded-full bg-[#22D3EE] px-5 py-3 font-semibold text-[#0B1220] hover:bg-[#22D3EE]/90 transition-colors">Anrufen</a>
        <a href={`mailto:${contact.email}`} class="inline-flex items-center gap-2 rounded-full border border-[#1B2A4A]/20 px-5 py-3 font-semibold text-[#1B2A4A] hover:bg-[#1B2A4A]/5 transition-colors">E‑Mail</a>
      </div>
    </div>
  </section>
</Layout>
