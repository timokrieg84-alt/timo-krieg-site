---
import BaseLayout from "../../layouts/BaseLayout.astro";
const title = "Social Ads Agentur | Meta, LinkedIn & TikTok";
const description = "Bessere Creatives, klarere Zielgruppen, mehr Leads. Social Ads für B2B/B2C – Testing, Retargeting & Attribution.";
---
<BaseLayout title={title} description={description} path="/leistungen/social-ads/">
  <section class="section"><div class="container">
    <h1 class="h1">Social Ads, die Nachfrage schaffen – Meta, LinkedIn, TikTok.</h1>
    <p class="lead">Zielgruppen präzise, Botschaften klar, Creatives getestet. Voller Funnel.</p>
    <div class="grid" style="grid-template-columns:repeat(2,minmax(0,1fr));gap:24px">
      <div class="card"><h3>Pakete</h3><ul><li>Strategie & Funnel</li><li>Setup</li><li>Creative‑Testing</li><li>Retargeting</li></ul></div>
      <div class="card"><h3>Prozess</h3><ol><li>Research</li><li>Setup</li><li>Scale</li></ol></div>
    </div>
    <h3 class="h3" style="margin-top:24px;">FAQ</h3>
    <details class="card"><summary>Keine Creatives?</summary><div>Wir entwickeln Test‑Hypothesen und Briefings.</div></details>
    <details class="card"><summary>B2B auf LinkedIn?</summary><div>Ja – mit klarem Offer (z. B. Whitepaper, Demo, Termin).</div></details>
    <a class="btn btn--outline" href="/kontakt/" style="margin-top:16px;">Social Ads testen – Erstgespräch sichern</a>
  </div></section>
</BaseLayout>
