---
import '../../styles/global.css';
const title = 'Google Ads & LinkedIn Ads Agentur | B2B-Leadgen in DACH | Timo Krieg';
const description = 'Planbare B2B-Pipelines: Kampagnen-Setup, Tracking, Creatives & laufende Optimierung für Google Ads und LinkedIn Ads – lokal in Schwäbisch Gmünd, wirksam in DACH.';
const canonical = '/leistungen/google-ads-linkedin-ads/';
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="/og-default.jpg" />
  <script type="application/ld+json">{JSON.stringify({
    '@context':'https://schema.org','@type':'Service',serviceType:'Google Ads & LinkedIn Ads',category:'https://schema.org/AdvertisingAgency',
    provider:{'@type':'LocalBusiness',name:'Timo Krieg',address:{'@type':'PostalAddress',postalCode:'73529',addressLocality:'Schwäbisch Gmünd',addressCountry:'DE'},areaServed:['DE','AT','CH']},
    url: canonical
  })}</script>
  <script type="application/ld+json">{JSON.stringify({
    '@context':'https://schema.org','@type':'WebPage', name:title, description, url: canonical, inLanguage:'de',
    breadcrumb:{'@type':'BreadcrumbList', itemListElement:[{'@type':'ListItem', position:1, name:'Start', item:'/'},{'@type':'ListItem', position:2, name:'Leistungen', item:'/leistungen/'},{'@type':'ListItem', position:3, name:'Google Ads & LinkedIn Ads', item: canonical}]}
  })}</script>
</head>
<body>
  <header class="border-b border-slate-200 bg-white/70 backdrop-blur sticky top-0 z-50">
    <div class="container py-4 flex items-center justify-between gap-4">
      <a href="/" class="font-semibold tracking-tight">Timo Krieg</a>
      <nav class="hidden md:flex items-center gap-6 text-sm">
        <a href="/leistungen/" class="nav-link">Leistungen</a>
        <a href="/ueber-uns" class="nav-link">Über uns</a>
        <a href="/kontakt" class="nav-link">Kontakt</a>
        <a href="tel:+491604365363" class="btn btn-primary">Jetzt anrufen</a>
      </nav>
      <a href="/kontakt" class="md:hidden btn btn-primary">Kontakt</a>
    </div>
  </header>

  <main>
    <section class="section">
      <div class="container grid gap-8 lg:grid-cols-2 items-start">
        <div>
          <h1 class="text-4xl md:text-5xl font-semibold tracking-tight">Präzise Kampagnen. Bessere Leads. Weniger Streuung.</h1>
          <p class="mt-4 text-lg text-slate-600">Performance Marketing mit Google Ads und LinkedIn Ads – strukturiert, testgetrieben, budgeteffizient.</p>
          <div class="mt-6 flex gap-3">
            <a href="/kontakt" class="btn btn-primary">Kampagnen starten</a>
            <a href="/leistungen/cro-conversion-rate-optimierung/" class="btn btn-secondary">Landingpages optimieren</a>
          </div>
        </div>
        <ul class="card space-y-2">
          <li>Konto‑Audit und saubere Grundstruktur</li>
          <li>Kampagnen‑Setup: Such‑, PMax‑, Remarketing‑, LinkedIn‑Formate</li>
          <li>Zielgruppen, Gebotsstrategien, Anzeigentests</li>
          <li>Landingpages und Conversion‑Tracking</li>
          <li>Laufende Optimierung, Reports, Skalierungshebel</li>
        </ul>
      </div>
    </section>

    <section class="section bg-slate-50">
      <div class="container">
        <h2 class="text-3xl md:text-4xl font-semibold tracking-tight">In 4 Schritten zur B2B‑Leadgen</h2>
        <ol class="mt-8 grid gap-6 md:grid-cols-4">
          <li class="card"><h3 class="font-semibold">1) Fundament</h3><p class="mt-1 text-slate-600">Ziele, Tracking, Baseline.</p></li>
          <li class="card"><h3 class="font-semibold">2) Setup</h3><p class="mt-1 text-slate-600">Kampagnen, Creatives, LPs.</p></li>
          <li class="card"><h3 class="font-semibold">3) Lernen</h3><p class="mt-1 text-slate-600">A/B‑Tests, Suchbegriffe, Audiences.</p></li>
          <li class="card"><h3 class="font-semibold">4) Skalieren</h3><p class="mt-1 text-slate-600">Budgetdreh, Effizienz halten.</p></li>
        </ol>
      </div>
    </section>

    <section class="section">
      <div class="container grid gap-6 md:grid-cols-2">
        <div class="card">
          <h2 class="text-2xl font-semibold">Vorteile für den Mittelstand</h2>
          <ul class="mt-3 list-disc pl-5 text-slate-600 space-y-1">
            <li>Schnelle Marktdaten und planbare Lead‑Pipelines</li>
            <li>Klarer CPL/ROI, transparent im Reporting</li>
            <li>Starke Kombination mit SEO & CRO</li>
            <li>Fokus auf Entscheiderrollen im B2B</li>
          </ul>
        </div>
        <div class="card">
          <h2 class="text-2xl font-semibold">FAQ</h2>
          <details class="mt-3 group rounded-xl border border-slate-200 bg-white p-5 hover:bg-slate-50 transition"><summary class="font-medium">Google Ads oder LinkedIn Ads?</summary><div class="mt-2 text-slate-600">Hängt von Suchintention vs. Zielgruppen‑Targeting ab – oft gewinnt die Kombination.</div></details>
          <details class="mt-3 group rounded-xl border border-slate-200 bg-white p-5 hover:bg-slate-50 transition"><summary class="font-medium">Wie hoch ist das Testbudget?</summary><div class="mt-2 text-slate-600">Start je nach Markt ab 1.500–3.000 € pro Monat sinnvoll.</div></details>
          <details class="mt-3 group rounded-xl border border-slate-200 bg-white p-5 hover:bg-slate-50 transition"><summary class="font-medium">Was ist mit Performance Max?</summary><div class="mt-2 text-slate-600">Einsatz, wenn Datenbasis und Feed stimmen – sonst kontrolliert starten.</div></details>
          <details class="mt-3 group rounded-xl border border-slate-200 bg-white p-5 hover:bg-slate-50 transition"><summary class="font-medium">Wie vermeiden wir Streuverluste?</summary><div class="mt-2 text-slate-600">Negativlisten, exakte Zielgruppen, LP‑Fit, sauberes Tracking.</div></details>
        </div>
      </div>
      <div class="container mt-8"><a href="/kontakt" class="btn btn-primary">Kostenloses Erstgespräch</a></div>
    </section>
  </main>

  <footer class="border-t border-slate-200">
    <div class="container py-8 text-sm text-slate-600 flex flex-col md:flex-row items-center justify-between gap-3">
      <span>© {new Date().getFullYear()} Timo Krieg – Performance Marketing</span>
      <nav class="flex items-center gap-4">
        <a class="underline decoration-slate-300 underline-offset-4 hover:decoration-slate-400" href="/impressum">Impressum</a>
        <a class="underline decoration-slate-300 underline-offset-4 hover:decoration-slate-400" href="/datenschutz">Datenschutz</a>
      </nav>
    </div>
  </footer>
</body>
</html>
