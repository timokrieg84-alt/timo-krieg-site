---
import BaseLayout from "../../layouts/BaseLayout.astro";
const title = "Reinigungsservices in Zürich | Büro, Wohnung, Fenster";
const description = "Alle Dienstleistungen auf einen Blick – Unterhalts‑, Umzugs‑ & Fensterreinigung. Region Zürich & Umgebung. Unverbindliche Beratung anfragen.";
---
<BaseLayout title={title} description={description} path="/leistungen/">
  <section class="section container">
    <h1>Leistungen</h1>
    <p class="lead">Unterhaltsreinigung für Unternehmen und Privathaushalte – klar strukturiert, zuverlässig umgesetzt.</p>
  </section>
  <section class="section container">
    <div class="service-grid">
      <article class="card-service"><div class="icon">🏢</div><h3>Büroreinigung</h3><p>Planbare Einsätze, feste Ansprechperson.</p><a class="link" href="/leistungen/bueroreinigung/">Zur Detailseite →</a></article>
      <article class="card-service"><div class="icon">🏥</div><h3>Praxisreinigung</h3><p>Hygiene nach klaren Standards.</p><a class="link" href="/leistungen/praxisreinigung/">Zur Detailseite →</a></article>
      <article class="card-service"><div class="icon">🏠</div><h3>Wohnungsreinigung</h3><p>Gründlich und schonend.</p><a class="link" href="/leistungen/wohnungsreinigung/">Zur Detailseite →</a></article>
      <article class="card-service"><div class="icon">🚚</div><h3>Umzugsreinigung</h3><p>Mit Abgabegarantie.</p><a class="link" href="/leistungen/umzugsreinigung/">Zur Detailseite →</a></article>
      <article class="card-service"><div class="icon">🪟</div><h3>Fensterreinigung</h3><p>Streifenfrei und sicher.</p><a class="link" href="/leistungen/fensterreinigung/">Zur Detailseite →</a></article>
    </div>
  </section>
</BaseLayout>
