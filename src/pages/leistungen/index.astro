import ServicesBento from '../../components/ServicesBento.astro';
import Funnel from '../../components/Funnel.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Leistungen | Gylsere Januzi">
  <Header />
  <main class="max-w-7xl mx-auto px-4 py-12 sm:py-16">
    <h1 class="text-4xl font-extrabold mb-6">Leistungen</h1>
