---
import Layout from "../../layouts/Layout.astro";
import { site } from "../../data/site";
const services = site.services;
---
<Layout>
  <section class="py-16 sm:py-24 lg:py-28">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-5xl font-semibold text-[#1A1A1A]">Leistungen</h1>
      <p class="mt-3 text-lg text-[#1A1A1A]/80 max-w-2xl">Von SEO über Ads bis Automation: modular buchbar, nahtlos kombinierbar. Jede Leistung mit klaren Messpunkten und Verantwortlichkeiten.</p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s)=> (
          <article class="group rounded-2xl border border-[#123D2A]/10 bg-[#F5F1E9] p-6 shadow-sm hover:shadow-md transition-shadow flex flex-col">
            <div class="text-xs uppercase tracking-wide text-[#123D2A]">{s.subtitle}</div>
            <h2 class="mt-1 text-xl font-semibold text-[#1A1A1A]">{s.title}</h2>
            <p class="mt-2 text-[#1A1A1A]/70">{s.shortDescription}</p>
            <ul class="mt-4 space-y-1 text-sm text-[#1A1A1A]/70 list-disc list-inside">
              {s.features.slice(0,4).map((f)=> (<li>{f}</li>))}
            </ul>
            <div class="mt-6 flex-1"></div>
            <div class="mt-6 flex items-center gap-3">
              <a href={`/leistungen/${s.slug}`} class="inline-flex items-center gap-2 rounded-full bg-[#123D2A] px-4 py-2 text-[#F5F1E9] hover:bg-[#C8501E] transition-colors">Mehr erfahren</a>
              <a href={`/#contact`} class="text-sm text-[#123D2A] hover:text-[#C8501E]">Angebot anfragen</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
