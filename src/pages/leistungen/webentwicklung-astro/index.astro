---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import IconSprite from '../../../components/IconSprite.astro';
import ScrollAnimations from '../../../components/ScrollAnimations.astro';
const pageTitle = 'Webentwicklung mit Astro | Schnelle, SEO‑starke Websites';
const pageDesc = 'Ultra‑schnelle Astro‑Websites mit Top Core Web Vitals, DSGVO‑Konzept & SEO‑Setup. Perfekt für lokale Unternehmen im Raum Stuttgart.';
---
<BaseLayout title={pageTitle} description={pageDesc}>
  <Fragment slot="icons"><IconSprite /></Fragment>
  <Fragment slot="header"><Header /></Fragment>
  <main>
    <section class="section container" data-reveal-group>
      <h1 class="reveal">Webentwicklung mit Astro</h1>
      <p class="reveal text-muted">Ultra‑schnell. SEO‑stark. Wartungsarm. Ihre neue Website mit Astro.</p>
      <div class="grid grid-3 mt-4">
        <article class="card reveal"><h3 class="card__title">Performance</h3><p class="card__meta">Blitzschnelle Ladezeiten, Top Core Web Vitals.</p></article>
        <article class="card reveal"><h3 class="card__title">SEO</h3><p class="card__meta">Saubere IA, strukturierte Daten, SSR.</p></article>
        <article class="card reveal"><h3 class="card__title">DSGVO</h3><p class="card__meta">Privacy by Design, Hosting in der EU.</p></article>
      </div>
      <h2 class="mt-4">Features</h2>
      <ul class="text-muted" style="padding-left:18px">
        <li>Astro Islands – minimale JS‑Last</li>
        <li>Lighthouse 90–100 als Zielkorridor</li>
        <li>Responsive Bildoptimierung (AVIF/WebP)</li>
        <li>Saubere Semantik, Schema.org, Open Graph</li>
        <li>Barrierearme Komponenten</li>
        <li>Formulare mit Spam‑Schutz</li>
        <li>CDN‑Cachings & Edge‑Auslieferung</li>
        <li>Headless optional oder content‑light</li>
        <li>Datenschutzbewusstes Tracking</li>
        <li>Deployment & Monitoring</li>
      </ul>
      <div class="mt-4">
        <a class="btn btn--primary" href="tel:+491604365363">Jetzt anrufen</a>
        <a class="btn btn--ghost" href="/kontakt/" style="margin-left:8px">Kostenloses Erstgespräch</a>
      </div>
    </section>
  </main>
  <ScrollAnimations />
  <Fragment slot="head">
    <script type="application/ld+json">{JSON.stringify({
      "@context":"https://schema.org",
      "@type":"Service",
      "@id":"https://www.listingprofis.de/leistungen/webentwicklung-astro/#service",
      "serviceType":"Webentwicklung mit Astro (schnelle Websites)",
      "name":"Astro‑Websites & Performance‑Optimierung",
      "description":"Ultra‑schnelle, SEO‑starke Websites (Astro/Jamstack) mit Top Core Web Vitals und DSGVO‑Konzept.",
      "areaServed":["Schwäbisch Gmünd","Stuttgart","Baden‑Württemberg","DACH"],
      "provider":{ "@id":"https://www.listingprofis.de/#organization" },
      "offers":{ "@type":"Offer","priceCurrency":"EUR","url":"https://www.listingprofis.de/kontakt/" }
    })}</script>
  </Fragment>
  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>
