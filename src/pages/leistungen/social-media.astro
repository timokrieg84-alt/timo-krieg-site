---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Section from "@/components/Section.astro";
import CTA from "@/components/CTA-Bar.astro";
import Footer from "@/components/Footer.astro";
import HeadSEO from "@/components/HeadSEO.astro";
const meta = {
  title: "Social Media Agentur | Content, Ads & Creatives für KMU/B2B",
  description: "Redaktionspläne, UGC‑Style‑Creatives, Reels/Shorts, LinkedIn‑Ads – kanalübergreifend aus einer Hand.",
  url: "https://example.com/leistungen/social-media/",
  canonical: "https://example.com/leistungen/social-media/",
  image: "/images/hero-bg.webp",
  type: "article"
};
---
<html lang="de" class="dark">
  <head>
    <HeadSEO {...meta} />
    <script type="application/ld+json">
      {JSON.stringify({"@context":"https://schema.org","@type":"Service","@id":"https://example.com/leistungen/social-media/#service","name":"Social Media","serviceType":"Social Media Marketing","provider":{"@id":"https://example.com/#organization"},"areaServed":[{"@type":"Country","name":"Germany"}],"audience":{"@type":"BusinessAudience"}})}
    </script>
  </head>
  <body>
    <Layout title={meta.title} description={meta.description}>
      <Fragment slot="nav"><Navbar /></Fragment>
      <Section id="intro" title="Content, der Kunden bringt." intro="Von Strategie bis Produktion: Social Media, das Reichweite in Anfragen verwandelt – auf Instagram, TikTok, LinkedIn & Co.">
        <div class="grid md:grid-cols-2 gap-8">
          <article class="card p-6">
            <h3 class="h3">Leistungspaket</h3>
            <ul class="mt-3 text-txt-2 grid gap-2">
              <li>• Strategie & Kanalaufbau</li>
              <li>• Foto, Video & Grafik</li>
              <li>• Community‑Management</li>
              <li>• Paid Social</li>
            </ul>
            <div class="mt-6 flex gap-3">
              <a href="/projekt-anfragen" class="btn btn-primary btn-glare">Angebot anfragen</a>
              <a href="/kontakt" class="btn btn-secondary">Beratung buchen</a>
            </div>
          </article>
          <article class="card p-6">
            <h3 class="h3">Messpunkte</h3>
            <ul class="mt-3 text-txt-2 grid gap-2">
              <li>• Reichweite & Engagement</li>
              <li>• Leads & Anfragen</li>
              <li>• CPL & ROAS im Paid</li>
              <li>• Community‑Wachstum</li>
            </ul>
          </article>
        </div>
      </Section>
      <CTA />
      <Fragment slot="footer"><Footer /></Fragment>
    </Layout>
  </body>
</html>
