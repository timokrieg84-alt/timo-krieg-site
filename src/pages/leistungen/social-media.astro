---
import Layout from '../../layouts/Layout.astro';
import { brand, services, contact } from '../../data/site';
const service = services.find(s => s.slug === 'social-media');
const others = services.filter(s => s.slug !== 'social-media');
---
<Layout title={service?.seo.title ?? `${brand.name} – Social Media`} description={service?.seo.description}>
  <section class="relative bg-[#0B1220] text-[#F8FAFC]">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_left,rgba(34,211,238,0.14),transparent_45%)]"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
      <nav class="text-xs text-[#F8FAFC]/70"><a href="/" class="hover:text-[#F8FAFC]">Start</a> · <span>Social Media</span></nav>
      <h1 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight">Social Media mit Substanz</h1>
      <p class="mt-2 max-w-3xl text-[#F8FAFC]/80">{service?.short}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="#kontakt" class="inline-flex items-center gap-2 rounded-full bg-[#22D3EE] px-5 py-3 text-[#0B1220] font-semibold hover:bg-[#22D3EE]/90 transition-colors">Content‑Plan anfragen</a>
        <a href="/" class="inline-flex items-center gap-2 rounded-full border border-[#F8FAFC]/20 px-5 py-3 text-[#F8FAFC] hover:bg-[#F8FAFC]/10 transition-colors">Zur Startseite</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14 grid grid-cols-1 lg:grid-cols-3 gap-10">
    <div class="lg:col-span-2">
      <h2 class="text-xl font-semibold">Von Idee zu Impact</h2>
      <p class="mt-3 text-[#475569]">Wir produzieren Content, der Marken aufbaut und Conversions treibt – in einem Setup, das Planung, Produktion und Distribution effizient verbindet. Community‑Management und Paid Social schließen den Kreis.</p>

      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="rounded-xl border border-[#94A3B8]/40 bg-[#F8FAFC] p-5"><div class="text-sm font-semibold">Content‑Produktion</div><p class="mt-1 text-sm text-[#475569]">Foto, Video, Grafik – in Serien gedacht, für hohe Frequenz ohne Qualitätsverlust.</p></div>
        <div class="rounded-xl border border-[#94A3B8]/40 bg-[#F8FAFC] p-5"><div class="text-sm font-semibold">Community‑Management</div><p class="mt-1 text-sm text-[#475569]">Antwortzeiten, Tonalität und Prozesse, die Nähe schaffen und binden.</p></div>
        <div class="rounded-xl border border-[#94A3B8]/40 bg-[#F8FAFC] p-5"><div class="text-sm font-semibold">Paid Social</div><p class="mt-1 text-sm text-[#475569]">Kampagnen, Funnels und Creatives – datenbasiert und performanceorientiert.</p></div>
        <div class="rounded-xl border border-[#94A3B8]/40 bg-[#F8FAFC] p-5"><div class="text-sm font-semibold">Social Analytics</div><p class="mt-1 text-sm text-[#475569]">Formate evaluieren, Budgets steuern, Lerneffekte sichern.</p></div>
      </div>

      <h3 class="mt-10 text-lg font-semibold">Leistungsumfang</h3>
      <ul class="mt-3 space-y-2 text-sm text-[#0B1220]">
        {(service?.features ?? []).map((f) => (
          <li class="flex items-start gap-2"><span class="mt-2 h-1.5 w-1.5 rounded-full bg-[#22D3EE]"></span><span>{f}</span></li>
        ))}
        <li class="flex items-start gap-2"><span class="mt-2 h-1.5 w-1.5 rounded-full bg-[#22D3EE]"></span><span>Redaktionskalender & Distribution</span></li>
      </ul>

      <div class="mt-10 rounded-2xl border border-[#94A3B8]/40 bg-[#0B1220] p-6 text-[#F8FAFC]">
        <div class="text-lg font-semibold">Reichweite in Ergebnisse verwandeln</div>
        <p class="mt-1 text-[#F8FAFC]/80">Wir orchestrieren Content, Community und Kampagnen für messbaren Output.</p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href={`tel:${contact.phone.replace(/\s+/g, '')}`} class="inline-flex items-center gap-2 rounded-full bg-[#22D3EE] px-5 py-3 font-semibold text-[#0B1220] hover:bg-[#22D3EE]/90 transition-colors">Jetzt anrufen</a>
          <a href={`mailto:${contact.email}`} class="inline-flex items-center gap-2 rounded-full border border-[#F8FAFC]/20 px-5 py-3 text-[#F8FAFC] hover:bg-[#F8FAFC]/10 transition-colors">E‑Mail schreiben</a>
        </div>
      </div>
    </div>

    <aside class="lg:col-span-1">
      <div class="rounded-2xl border border-[#94A3B8]/40 bg-[#F8FAFC] p-6">
        <div class="text-sm font-semibold">Weitere Leistungen</div>
        <nav class="mt-3 grid grid-cols-1 gap-2">
          {others.map((o) => (<a href={`/leistungen/${o.slug}`} class="text-sm text-[#1B2A4A] hover:text-[#22D3EE] transition-colors">{o.title}</a>))}
        </nav>
        <a href="/" class="mt-4 inline-block text-xs text-[#475569] hover:text-[#0B1220]">← Zur Startseite</a>
      </div>
    </aside>
  </section>

  <section id="kontakt" class="scroll-mt-24 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-16">
    <div class="rounded-2xl border border-[#94A3B8]/40 bg-[#F8FAFC] p-8">
      <h2 class="text-xl font-semibold">Content‑Plan & Erstgespräch</h2>
      <p class="mt-2 text-[#475569]">Wir erarbeiten Formate, Frequenz und Prozesse – passend zu Ressourcen und Zielen.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href={`tel:${contact.phone.replace(/\s+/g, '')}`} class="inline-flex items-center gap-2 rounded-full bg-[#22D3EE] px-5 py-3 font-semibold text-[#0B1220] hover:bg-[#22D3EE]/90 transition-colors">Anrufen</a>
        <a href={`mailto:${contact.email}`} class="inline-flex items-center gap-2 rounded-full border border-[#1B2A4A]/20 px-5 py-3 font-semibold text-[#1B2A4A] hover:bg-[#1B2A4A]/5 transition-colors">E‑Mail</a>
      </div>
    </div>
  </section>
</Layout>
