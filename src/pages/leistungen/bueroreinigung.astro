---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SchemaService from "../../components/SchemaService.astro";
const title = "Büroreinigung Zürich | Unterhaltsreinigung vom Profi";
const description = "Saubere Arbeitsplätze, planbare Einsätze, feste Teams. Büroreinigung in Zürich mit Qualität & Kontrolle. Offerte in 24h.";
---
<BaseLayout title={title} description={description} path="/leistungen/bueroreinigung/" ogImage="/images/og-default.svg" jsonLd={{}}>
  <SchemaService name="Büroreinigung" slot="head" />
  <section class="section container">
    <h1>Büroreinigung in Zürich – ruhig, gründlich, zuverlässig</h1>
    <p class="lead">Unterhaltsreinigung nach Plan: fixe Zeiten, feste Ansprechperson. Diskret, effizient und materialgerecht – vom Teppich bis zur Teeküche.</p>

    <h2>Ihre Vorteile</h2>
    <ul>
      <li>Feste Teams, leise Abläufe – produktives Arbeiten bleibt möglich.</li>
      <li>Transparente Qualitätssicherung mit dokumentierten Kontrollen.</li>
      <li>Planbare Einsätze und klare Leistungsverzeichnisse.</li>
    </ul>

    <h2>So läuft es ab – in 3 Schritten</h2>
    <ol>
      <li><strong>Objektaufnahme:</strong> Begehung, Bedarfsklärung, Leistungsverzeichnis.</li>
      <li><strong>Start & Einweisung:</strong> Festes Team, Schlüsselprozesse, erste Qualitätskontrolle.</li>
      <li><strong>Laufender Service:</strong> Regelmässige Checks, Feedbackrunde, Anpassungen nach Bedarf.</li>
    </ol>

    <h2>FAQ</h2>
    <details><summary>Wie oft wird gereinigt?</summary><p>Frequenz und Umfang richten sich nach Nutzung und Grösse. Wir empfehlen einen Plan nach Zonen und Besucheraufkommen.</p></details>
    <details><summary>Arbeiten Sie ausserhalb der Bürozeiten?</summary><p>Ja, wir reinigen frühmorgens, abends oder am Wochenende – leise und abgestimmt.</p></details>
    <details><summary>Welche Flächen sind inkludiert?</summary><p>Arbeitsplätze, Sanitär, Küchenzonen, Böden, Empfang, Besprechungen. Spezialaufgaben nach Vereinbarung.</p></details>
    <details><summary>Gibt es eine Testphase?</summary><p>Auf Wunsch starten wir mit einer Pilotphase, um Abläufe zu verfeinern.</p></details>
    <details><summary>Wie erfolgt die Qualitätssicherung?</summary><p>Mit Checklisten, Stichproben, Foto-Dokumentation auf Wunsch.</p></details>

    <p><a class="btn" href="/kontakt/">Offerte für Büroreinigung anfordern</a></p>
  </section>
</BaseLayout>
