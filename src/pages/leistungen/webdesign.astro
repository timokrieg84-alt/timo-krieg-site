---
import Layout from "../../layouts/Layout.astro";
import { brand, services, sections, projectInfo } from "../../data/site";
const current = services.find((s) => s.slug === "webdesign");
const others = services.filter((s) => s.slug !== "webdesign");
---
<Layout title={`${current?.title} – ${brand.logoText}`} description={current?.excerpt || projectInfo.tagline}>
  <section class="bg-[#FFFFFF]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <nav class="text-sm text-[#94A3B8]" aria-label="Breadcrumb">
        <a class="hover:text-[#1E40AF]" href="/">Start</a>
        <span class="mx-2">/</span>
        <a class="hover:text-[#1E40AF]" href={`/#${sections.services}`}>Leistungen</a>
        <span class="mx-2">/</span>
        <span class="text-[#0F172A]">{current?.title}</span>
      </nav>
      <div class="mt-6 grid lg:grid-cols-3 gap-12">
        <article class="lg:col-span-2">
          <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">{current?.title}</h1>
          <p class="mt-4 text-lg text-[#0F172A] max-w-prose">{current?.excerpt}</p>

          <div class="mt-8 grid sm:grid-cols-2 gap-6">
            <div class="rounded-xl border border-[#F1F5F9] p-6 bg-[#FFFFFF]">
              <h2 class="text-xl font-semibold">Was Sie erhalten</h2>
              <ul class="mt-3 space-y-2 text-sm text-[#0F172A] list-disc pl-5">
                <li>Eine maßgeschneiderte, performante Website mit sauberem, wartbarem Code.</li>
                <li>Ein responsives UI mit klarer Typografie und konsistentem Designsystem.</li>
                <li>Technisches SEO-Fundament: semantisches HTML, strukturierte Daten, saubere IA.</li>
                <li>Deployment-Pipeline, Analytics-Setup und verständliche Dokumentation.</li>
              </ul>
            </div>
            <div class="rounded-xl border border-[#F1F5F9] p-6 bg-[#FFFFFF]">
              <h2 class="text-xl font-semibold">Technologiestack</h2>
              <p class="mt-3 text-sm text-[#0F172A]">Wir setzen auf Astro für maximale Performance und Tailwind für präzise, konsistente Styles. Wo sinnvoll, ergänzen wir progressive Enhancement und partielle Hydration.</p>
            </div>
          </div>

          <div class="mt-10">
            <h2 class="text-2xl font-semibold">Unser Vorgehen</h2>
            <ol class="mt-4 grid sm:grid-cols-2 gap-6">
              <li class="rounded-xl border border-[#F1F5F9] p-6 bg-[#FFFFFF]"><h3 class="font-semibold">Discovery</h3><p class="mt-2 text-sm text-[#0F172A]">Ziele, Zielgruppen, Markenwerte und Content inventarisieren.</p></li>
              <li class="rounded-xl border border-[#F1F5F9] p-6 bg-[#FFFFFF]"><h3 class="font-semibold">UX & IA</h3><p class="mt-2 text-sm text-[#0F172A]">Navigation, Seitenarchitektur und Flows strukturieren.</p></li>
              <li class="rounded-xl border border-[#F1F5F9] p-6 bg-[#FFFFFF]"><h3 class="font-semibold">UI-Design</h3><p class="mt-2 text-sm text-[#0F172A]">Designsystem, Komponenten und States definieren.</p></li>
              <li class="rounded-xl border border-[#F1F5F9] p-6 bg-[#FFFFFF]"><h3 class="font-semibold">Build & Launch</h3><p class="mt-2 text-sm text-[#0F172A]">Astro-Implementierung, QA, Tracking, Go-Live.</p></li>
            </ol>
          </div>

          <div class="mt-10 rounded-xl border border-[#F1F5F9] p-6 bg-[#F1F5F9]">
            <h2 class="text-xl font-semibold">Häufige Ergebnisse</h2>
            <p class="mt-2 text-sm text-[#0F172A]">Reduzierte Ladezeiten, verbesserte Sichtbarkeit, klarere Conversion-Pfade und eine Website, die Ihr Team eigenständig pflegen kann.</p>
          </div>

          <div class="mt-10 flex flex-wrap gap-3">
            {others.map((o) => (
              <a href={`/leistungen/${o.slug}`} class="inline-flex items-center px-3 py-1.5 rounded-full border border-[#F1F5F9] text-[#1E40AF] hover:text-[#F97316] text-sm">Mehr zu {o.title}</a>
            ))}
          </div>

          <div class="mt-12 border-t border-[#F1F5F9] pt-6">
            <a href={`/#${sections.contact}`} class="inline-flex items-center rounded-md bg-[#1E40AF] text-[#FFFFFF] px-5 py-3 font-medium hover:bg-[#0F172A] transition-colors border border-[#1E40AF] hover:border-[#0F172A]">Projekt anfragen</a>
          </div>
        </article>

        <aside class="lg:col-span-1">
          <div class="rounded-xl border border-[#F1F5F9] p-6 bg-[#FFFFFF]">
            <h2 class="font-semibold">Weitere Leistungen</h2>
            <ul class="mt-3 space-y-2 text-sm">
              {others.map((o) => (
                <li><a href={`/leistungen/${o.slug}`} class="hover:text-[#1E40AF]">{o.title}</a></li>
              ))}
            </ul>
            <div class="mt-6">
              <a href="/" class="text-sm text-[#1E40AF] hover:text-[#F97316]">Zur Startseite</a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>
