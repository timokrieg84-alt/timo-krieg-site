---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "Online‑Marketing Freelancer Schwäbisch Gmünd | Timo Krieg";
const description = "Senior Online Marketer: SEO, Google Ads, Landingpages, CRO & Analytics. Klar, messbar, pragmatisch.";
---
<BaseLayout title={title} description={description} path="/ueber-mich/">
  <section class="section"><div class="container hero">
    <div>
      <h1 class="h1">Timo Krieg – Senior Online Marketer und Berater.</h1>
      <p class="lead">Fokus auf effiziente Kundengewinnung, sauberes Tracking & klare Entscheidungsgrundlagen.</p>
      <ul>
        <li>SEO, SEA/Google Ads, Social Ads</li>
        <li>Landingpages & Conversion‑Optimierung</li>
        <li>Analytics: GA4, GTM, Dashboards</li>
        <li>B2B & E‑Commerce</li>
      </ul>
      <p class="help">Zertifikate/Partnerschaften: [bitte bestätigen, z. B. Google Partner]</p>
      <a class="btn btn--primary" href="/kontakt/">Unverbindliches Kennenlernen</a>
    </div>
    <div class="reveal" data-reveal="fade">
      <img src="/images/timo-portrait@1x.webp" alt="Porträt Timo Krieg" width="640" height="800" loading="lazy" decoding="async" />
    </div>
  </div></section>
</BaseLayout>
