---
import site from "../config/site";
import GoldenMasterLayout from "../layouts/GoldenMasterLayout.astro";

const { slug } = Astro.params;
const path = "/" + (Array.isArray(slug) ? slug.join("/") : slug || "");
const page = site.pages.find((p:any) => p.path === path);

if (!page) {
  throw Astro.redirect("/");
}
---
<GoldenMasterLayout title={page.title} variant={page.layout === 'legal' ? 'legal' : 'default'}>
  {page.layout === 'legal' ? (
    <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-8 md:py-12 prose prose-neutral dark:prose-invert">
      <h1 class="mb-6" style="font-family: 'Playfair Display', serif;">{page.content.heading}</h1>
      <pre class="whitespace-pre-wrap break-words font-sans text-[0.95rem] leading-relaxed text-neutral-800 dark:text-neutral-200">{page.content.body}</pre>
    </section>
  ) : null}
</GoldenMasterLayout>
