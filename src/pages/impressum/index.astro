---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import IconSprite from '../../components/IconSprite.astro';
const pageTitle = 'Impressum | ListingProfis – Timo Krieg, Schwäbisch Gmünd';
const pageDesc = 'Rechtliche Angaben zur Digitalagentur ListingProfis, Kitzingstraße 7, 73529 Schwäbisch Gmünd, Baden‑Württemberg.';
---
<BaseLayout title={pageTitle} description={pageDesc}>
  <Fragment slot="icons"><IconSprite /></Fragment>
  <Fragment slot="header"><Header /></Fragment>
  <main>
    <section class="section container">
      <h1>Impressum</h1>
      <p class="text-muted">Verantwortlich für diese Website ist Timo Krieg, ListingProfis / Digitalagentur & Online‑Marketing, Kitzingstraße 7, 73529 Schwäbisch Gmünd. Vollständige rechtliche Angaben, USt‑ID, Vertretungsberechtigung, Haftungshinweise und Bildnachweise werden vor Livegang finalisiert.</p>
    </section>
  </main>
  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>
