---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Kontakt | Performance Marketing Beratung | Schwäbisch Gmünd | Timo Krieg';
const description = 'Kostenloses Erstgespräch: +49 160 4365363. Adresse: Kitzingstraße 7, 73529 Schwäbisch Gmünd. Jetzt Termin sichern.';
const telHref = 'tel:+491604365363';
---
<BaseLayout {title} {description}>
  <section class="container py-16 md:py-24">
    <h1 class="text-3xl md:text-5xl font-semibold">Sprechen wir über Wachstum</h1>
    <p class="mt-4 max-w-2xl text-brand.muted">Kurzer Draht, klare Antworten. In 15 Minuten klären wir Potenziale, Budgetrahmen und nächste Schritte.</p>

    <div class="mt-8 grid gap-8 md:grid-cols-2">
      <div class="card">
        <h2 class="text-xl font-semibold">Direktkontakt</h2>
        <ul class="mt-3 space-y-2">
          <li><a class="focus-ring" href={telHref}>+49 160 4365363</a></li>
          <li><a class="focus-ring" href="mailto:info@listingprofis.de">info@listingprofis.de</a></li>
          <li>Kitzingstraße 7, 73529 Schwäbisch Gmünd</li>
        </ul>
        <div class="mt-4 flex gap-3">
          <a href={telHref} class="btn btn-primary">Jetzt anrufen</a>
          <a href="#form" class="btn btn-secondary">Erstgespräch vereinbaren</a>
        </div>
        <p class="mt-3 text-xs text-brand.muted">Hinweis: Eingehende Anfragen werden per Telegram-Benachrichtigung zugestellt.</p>
      </div>

      <form id="form" class="card space-y-4" novalidate>
        <h2 class="text-xl font-semibold">Kontaktformular</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm mb-1" for="name">Name</label>
            <input id="name" name="name" type="text" class="w-full rounded-md bg-white/5 border-white/10 focus:ring-brand.accent" required />
          </div>
          <div>
            <label class="block text-sm mb-1" for="email">E-Mail</label>
            <input id="email" name="email" type="email" class="w-full rounded-md bg-white/5 border-white/10 focus:ring-brand.accent" required />
          </div>
          <div>
            <label class="block text-sm mb-1" for="phone">Telefon</label>
            <input id="phone" name="phone" type="tel" class="w-full rounded-md bg-white/5 border-white/10 focus:ring-brand.accent" />
          </div>
          <div>
            <label class="block text-sm mb-1" for="budget">Budget</label>
            <select id="budget" name="budget" class="w-full rounded-md bg-white/5 border-white/10 focus:ring-brand.accent">
              <option value="unbekannt">Unbekannt</option>
              <option value="unter-5k">unter 5.000 €</option>
              <option value="5k-15k">5.000–15.000 €</option>
              <option value="15k-50k">15.000–50.000 €</option>
              <option value=">50k">über 50.000 €</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-sm mb-1" for="message">Nachricht</label>
          <textarea id="message" name="message" rows="5" class="w-full rounded-md bg-white/5 border-white/10 focus:ring-brand.accent" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Absenden</button>
        <p class="text-xs text-brand.muted">Mit Ihrer Kontaktaufnahme verarbeiten wir Ihre Angaben zur Beantwortung der Anfrage (Art. 6 Abs. 1 lit. b DSGVO). Details in der <a class="underline" href="/datenschutz">Datenschutzerklärung</a>.</p>
        <p id="form-status" class="text-sm"></p>
      </form>
    </div>
  </section>
  <script is:inline>
    const form = document.getElementById('form');
    const statusEl = document.getElementById('form-status');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      statusEl.textContent = 'Wird gesendet…';
      const fd = new FormData(form);
      const name = fd.get('name')?.toString() || '';
      const email = fd.get('email')?.toString() || '';
      const phone = fd.get('phone')?.toString() || '';
      const budget = fd.get('budget')?.toString() || '';
      const message = fd.get('message')?.toString() || '';
      const payload = {
        name, email, phone,
        site: window.location.href,
        message: `Budget: ${budget}\n\n${message}`
      };
      try {
        const res = await fetch('https://timokrieg.app.n8n.cloud/webhook/contact-form', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        if (!res.ok) throw new Error('Request failed');
        statusEl.textContent = 'Vielen Dank! Ihre Anfrage ist eingegangen. Sie erhalten zusätzlich eine Telegram-Benachrichtigung.';
        form.reset();
      } catch (err) {
        statusEl.textContent = 'Es ist ein Fehler aufgetreten. Bitte versuchen Sie es später erneut oder rufen Sie uns an.';
      }
    });
  </script>
</BaseLayout>
