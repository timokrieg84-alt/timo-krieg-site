---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<Layout title="Kontakt – Gylsere Januzi" description="Nimm Kontakt auf.">
  <Fragment slot="header"><Header /></Fragment>
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid gap-6 sm:grid-cols-2">
      <div>
        <h1 class="text-3xl font-semibold mb-6">Kontakt</h1>
        <p class="text-gray-300 mb-4">Ruf direkt an oder nutze das Formular.</p>
        <a href="tel:+491756372395" class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-[#00C853] text-gray-950 font-semibold hover:bg-[#00C853]/90 transition-colors">+49 175 6372395</a>
      </div>
      <div>
        <form id="contact-form" class="grid gap-3">
          <input class="bg-[#121826] border border-gray-800 rounded-lg px-3 py-2" name="name" placeholder="Name" required />
          <input class="bg-[#121826] border border-gray-800 rounded-lg px-3 py-2" name="email" type="email" placeholder="E-Mail" required />
          <input class="bg-[#121826] border border-gray-800 rounded-lg px-3 py-2" name="phone" type="tel" placeholder="Telefon" />
          <input class="bg-[#121826] border border-gray-800 rounded-lg px-3 py-2" name="site" type="url" placeholder="Website (optional)" />
          <textarea class="bg-[#121826] border border-gray-800 rounded-lg px-3 py-2" name="message" placeholder="Nachricht" rows="4" required></textarea>
          <button type="submit" class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-[#FF6A00] text-white font-medium hover:bg-[#FF6A00]/90 transition-colors">Senden</button>
          <p id="form-status" class="text-sm text-gray-400"></p>
        </form>
        <script>
          const form = document.getElementById('contact-form');
          const status = document.getElementById('form-status');
          form?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const fd = new FormData(form);
            const payload = Object.fromEntries(fd.entries());
            status.textContent = 'Sende...';
            try {
              const res = await fetch('https://timokrieg.app.n8n.cloud/webhook/contact-form', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
              });
              if (!res.ok) throw new Error('net');
              status.textContent = 'Danke! Deine Anfrage ist eingegangen. Du erhältst eine Bestätigung (Telegram-Benachrichtigung ist aktiv).';
              form.reset();
            } catch (err) {
              status.textContent = 'Fehler beim Senden. Bitte versuche es erneut oder rufe an.';
            }
          });
        </script>
      </div>
    </div>
  </section>
  <Fragment slot="footer"><Footer /></Fragment>
</Layout>
