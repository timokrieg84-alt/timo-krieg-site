---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Kontakt | Timo Krieg" description="Kostenloses Erstgespräch: +49 160 4365363.">
  <section class="container py-16 md:py-24">
    <h1 class="text-3xl md:text-5xl font-semibold">Kontakt</h1>
    <div class="mt-8 grid gap-8 md:grid-cols-2">
      <div class="card">
        <h2 class="text-xl font-semibold">Direktkontakt</h2>
        <p class="mt-2 text-slate-300">Telefon: <a class="hover:underline" href="tel:+491604365363">+49 160 4365363</a><br/>E-Mail: <a class="hover:underline" href="mailto:info@listingprofis.de">info@listingprofis.de</a></p>
        <p class="mt-2 text-slate-300">Adresse: Kitzingstraße 7, 73529 Schwäbisch Gmünd</p>
      </div>
      <form class="card space-y-4" action="https://timokrieg.app.n8n.cloud/webhook/contact-form" method="post">
        <h2 class="text-xl font-semibold">Nachricht senden</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm mb-1" for="name">Name</label>
            <input id="name" name="name" type="text" class="w-full rounded-md bg-white/5 border border-white/10 px-3 py-2" required />
          </div>
          <div>
            <label class="block text-sm mb-1" for="email">E-Mail</label>
            <input id="email" name="email" type="email" class="w-full rounded-md bg-white/5 border border-white/10 px-3 py-2" required />
          </div>
          <div>
            <label class="block text-sm mb-1" for="phone">Telefon</label>
            <input id="phone" name="phone" type="tel" class="w-full rounded-md bg-white/5 border border-white/10 px-3 py-2" />
          </div>
          <div>
            <label class="block text-sm mb-1" for="site">Website</label>
            <input id="site" name="site" type="text" class="w-full rounded-md bg-white/5 border border-white/10 px-3 py-2" />
          </div>
        </div>
        <div>
          <label class="block text-sm mb-1" for="message">Nachricht</label>
          <textarea id="message" name="message" rows="5" class="w-full rounded-md bg-white/5 border border-white/10 px-3 py-2" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Absenden</button>
        <p class="text-xs text-slate-400">Hinweis: Eingehende Anfragen werden per Telegram-Benachrichtigung zugestellt.</p>
      </form>
    </div>
  </section>
</BaseLayout>
