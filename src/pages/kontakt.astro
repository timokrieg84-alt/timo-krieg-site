---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/Section.astro";
---
<Layout title="Kontakt – Gylsere Januzi" description="Nimm Kontakt auf.">
  <Fragment slot="header"><Header /></Fragment>
  <Section title="Kontakt aufnehmen" intro="Ruf direkt an, schreib eine E-Mail oder nutze das Formular.">
    <div class="grid gap-6 sm:grid-cols-2">
      <div class="bg-[#131b2e] border border-gray-800 p-6 rounded-xl">
        <h3 class="font-semibold text-white mb-3">Telefon</h3>
        <a href="tel:+491756372395" class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-[#00C853] text-gray-950 font-semibold hover:bg-[#00C853]/90 transition-colors">+49 175 6372395</a>
        <div class="mt-4 text-sm text-gray-400">
          Oder per E-Mail: <a href="mailto:gjanuzikrieg@gmail.com" class="text-[#FF2D9A] hover:underline">gjanuzikrieg@gmail.com</a>
        </div>
      </div>
      <div class="bg-[#131b2e] border border-gray-800 p-6 rounded-xl">
        <h3 class="font-semibold text-white mb-3">Formular</h3>
        <form id="contact-form" class="grid gap-3">
          <input class="bg-[#0b0f19] border border-gray-800 rounded px-3 py-2 text-sm" name="name" placeholder="Name" required />
          <input class="bg-[#0b0f19] border border-gray-800 rounded px-3 py-2 text-sm" name="email" type="email" placeholder="E-Mail" required />
          <input class="bg-[#0b0f19] border border-gray-800 rounded px-3 py-2 text-sm" name="phone" type="tel" placeholder="Telefon" />
          <input class="bg-[#0b0f19] border border-gray-800 rounded px-3 py-2 text-sm" name="site" type="url" placeholder="Website (optional)" />
          <textarea class="bg-[#0b0f19] border border-gray-800 rounded px-3 py-2 text-sm" name="message" placeholder="Nachricht" rows="4" required></textarea>
          <button type="submit" class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-[#FF6A00] text-white font-medium hover:bg-[#FF6A00]/90 transition-colors">Senden</button>
          <p id="form-status" class="text-sm text-gray-400"></p>
        </form>
        <script>
          const form = document.getElementById('contact-form');
          const status = document.getElementById('form-status');
          form?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const fd = new FormData(form);
            const payload = Object.fromEntries(fd.entries());
            status.textContent = "Sende...";
            try {
              const res = await fetch("https://timokrieg.app.n8n.cloud/webhook/contact-form", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
              });
              if (!res.ok) throw new Error("net");
              status.textContent = "Danke! Deine Anfrage ist eingegangen. Du erhältst eine Bestätigung (Telegram-Benachrichtigung ist aktiv).";
              form.reset();
            } catch (err) {
              status.textContent = "Fehler beim Senden. Bitte versuche es erneut oder rufe an.";
            }
          });
        </script>
      </div>
    </div>
  </Section>
  <Fragment slot="footer"><Footer /></Fragment>
</Layout>
