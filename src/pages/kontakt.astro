---
import BaseLayout from "../layouts/BaseLayout.astro";
const submit = `async function onSubmit(e){e.preventDefault();const f=e.currentTarget;const data={name:f.name.value,email:f.email.value,phone:f.phone.value,site:f.site.value,message:f.message.value};const btn=f.querySelector('[data-submit]');btn.disabled=true;btn.textContent='Wird gesendet…';try{const res=await fetch('https://timokrieg.app.n8n.cloud/webhook/contact-form',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});if(!res.ok)throw new Error('Request failed');f.reset();alert('Danke! Wir melden uns – es gibt eine Telegram-Benachrichtigung.');}catch(err){console.error(err);alert('Fehler beim Senden. Bitte später erneut versuchen.');}finally{btn.disabled=false;btn.textContent='Nachricht senden';}}`;
---
<BaseLayout title="Kontakt – Gylsere Januzi Krieg Online Marketing Office" description="Kontakt aufnehmen: Erstgespräch, E-Mail oder Telefon. Wir antworten schnell.">
  <section class="py-12" id="erstgespraech">
    <div class="container">
      <h1 class="text-3xl font-semibold text-white mb-4">Kontakt</h1>
      <p class="text-slate-400 mb-8">Erstgespräch, E-Mail oder Telefon – wir sind schnell für Sie da.</p>

      <form class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-3xl" on:submit={submit}>
        <input required name="name" placeholder="Ihr Name" class="bg-zinc-900 border border-slate-800 rounded-md p-3 text-slate-200" />
        <input required type="email" name="email" placeholder="E-Mail" class="bg-zinc-900 border border-slate-800 rounded-md p-3 text-slate-200" />
        <input name="phone" placeholder="Telefon" class="bg-zinc-900 border border-slate-800 rounded-md p-3 text-slate-200" />
        <input name="site" placeholder="Website (optional)" class="bg-zinc-900 border border-slate-800 rounded-md p-3 text-slate-200" />
        <textarea required name="message" placeholder="Nachricht" class="md:col-span-2 bg-zinc-900 border border-slate-800 rounded-md p-3 text-slate-200" rows="5"></textarea>
        <button type="submit" data-submit class="md:col-span-2 px-4 py-3 rounded-md bg-brand-primary text-white hover:opacity-90">Nachricht senden</button>
      </form>
      <div class="mt-6 text-slate-400">
        <p><strong>Oder direkt:</strong> <a class="text-white underline" href="mailto:gjanuzikrieg@gmail.com">gjanuzikrieg@gmail.com</a> · <a class="text-white underline" href="tel:+491756372395">+49 175 6372395</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
