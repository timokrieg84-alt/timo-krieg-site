---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Section from "@/components/Section.astro";
import Footer from "@/components/Footer.astro";
---
<Layout title="Kontakt | Gylsere Januzi Krieg – Online Marketing Office" description="Sprechen wir über Ziele, Budget und den nächsten Sprint. Termin wählen oder direkt anrufen.">
  <Fragment slot="nav"><Navbar /></Fragment>
  <Section title="Lassen Sie uns über Ihr Projekt sprechen" intro="Erzählen Sie uns kurz von Ihrem Vorhaben – wir melden uns zeitnah mit einer ehrlichen Einschätzung und den nächsten Schritten.">
    <div class="grid md:grid-cols-2 gap-8">
      <div class="card p-6">
        <form id="contactForm" class="grid gap-4" novalidate>
          <label class="grid gap-1">
            <span>Name *</span>
            <input class="p-3 rounded-md bg-bg-2 border border-border" type="text" name="name" required />
          </label>
          <label class="grid gap-1">
            <span>E‑Mail *</span>
            <input class="p-3 rounded-md bg-bg-2 border border-border" type="email" name="email" required />
          </label>
          <label class="grid gap-1">
            <span>Telefon</span>
            <input class="p-3 rounded-md bg-bg-2 border border-border" type="tel" name="phone" />
          </label>
          <label class="grid gap-1">
            <span>Ihre Nachricht *</span>
            <textarea class="p-3 rounded-md bg-bg-2 border border-border" name="message" rows="5" required></textarea>
          </label>
          <p class="text-txt-2 text-sm">Ihre Daten werden ausschließlich zur Bearbeitung Ihrer Anfrage verwendet. Details in der <a class="underline" href="/datenschutz">Datenschutzerklärung</a>.</p>
          <button class="btn btn-primary btn-glare" type="submit">Nachricht senden</button>
          <p id="formMessage" role="status" class="text-sm text-txt-2"></p>
        </form>
      </div>
      <div class="card p-6">
        <address class="not-italic grid gap-2 text-txt-2">
          <strong>Gylsere Januzi Krieg – Online Marketing Office</strong>
          <span>Kitzingstraße 7, 73529 Schwäbisch Gmünd</span>
          <span>Tel. <a class="underline" href="tel:+491756372395">+49 175 6372395</a></span>
          <span>Mail <a class="underline" href="mailto:gjanuzikrieg@gmail.com">gjanuzikrieg@gmail.com</a></span>
        </address>
        <figure class="mt-6">
          <img src="/images/city-schwabisch-gmuend.webp" alt="Abendliche Stadtszene in Schwäbisch Gmünd" class="w-full h-auto rounded-md border border-border" loading="lazy" />
        </figure>
      </div>
    </div>
  </Section>
  <Fragment slot="footer"><Footer /></Fragment>
</Layout>

<script is:client="visible">
  const form = document.querySelector('#contactForm');
  const msg = document.querySelector('#formMessage');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = {
      name: form.name.value,
      email: form.email.value,
      phone: form.phone.value || "",
      site: window.location.hostname,
      message: form.message.value
    };
    try {
      const res = await fetch('https://timokrieg.app.n8n.cloud/webhook/contact-form', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data)
      });
      if (res.ok) {
        msg.textContent = 'Danke! Wir haben Ihre Nachricht erhalten und melden uns zeitnah.';
        form.reset();
      } else {
        msg.textContent = 'Es gab ein Problem. Bitte versuchen Sie es erneut oder rufen Sie uns an.';
      }
    } catch (err) {
      msg.textContent = 'Netzwerkfehler. Bitte später erneut versuchen.';
    }
  });
</script>
