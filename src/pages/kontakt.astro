---
import BaseLayout from "../layouts/BaseLayout.astro";
const submit = `async function onSubmit(e){e.preventDefault();const f=e.currentTarget;const data={name:f.name.value,email:f.email.value,phone:f.phone.value,site:f.site.value,message:f.message.value};const btn=f.querySelector('[data-submit]');btn.disabled=true;btn.textContent='Wird gesendet…';try{const res=await fetch('https://timokrieg.app.n8n.cloud/webhook/contact-form',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});if(!res.ok)throw new Error('Request failed');f.reset();alert('Danke! Wir melden uns – es gibt eine Telegram-Benachrichtigung.');}catch(err){console.error(err);alert('Fehler beim Senden. Bitte später erneut versuchen.');}finally{btn.disabled=false;btn.textContent='Nachricht senden';}}`;
---
<BaseLayout title="Kontakt – Gylsere Januzi Krieg Online Marketing Office" description="Kontakt aufnehmen: Erstgespräch, E-Mail oder Telefon. Wir antworten schnell.">
  <section class="py-16 sm:py-24" id="erstgespraech">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="text-xs uppercase tracking-wider text-[#123D2A]">Kontakt</div>
        <h1 class="mt-3 text-3xl sm:text-5xl font-semibold text-[#1A1A1A] mb-4">Lassen Sie uns über Ihr Projekt sprechen</h1>
        <p class="text-lg text-[#1A1A1A]/70 mb-8">Erstgespräch, E-Mail oder Telefon – wir sind schnell für Sie da.</p>
      </div>

      <form class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-3xl" on:submit={submit}>
        <input required name="name" placeholder="Ihr Name" class="bg-white border border-[#123D2A]/20 rounded-md p-3 text-[#1A1A1A] placeholder:text-[#6B7280] focus:outline-none focus:ring-2 focus:ring-[#123D2A]" />
        <input required type="email" name="email" placeholder="E-Mail" class="bg-white border border-[#123D2A]/20 rounded-md p-3 text-[#1A1A1A] placeholder:text-[#6B7280] focus:outline-none focus:ring-2 focus:ring-[#123D2A]" />
        <input name="phone" placeholder="Telefon" class="bg-white border border-[#123D2A]/20 rounded-md p-3 text-[#1A1A1A] placeholder:text-[#6B7280] focus:outline-none focus:ring-2 focus:ring-[#123D2A]" />
        <input name="site" placeholder="Website (optional)" class="bg-white border border-[#123D2A]/20 rounded-md p-3 text-[#1A1A1A] placeholder:text-[#6B7280] focus:outline-none focus:ring-2 focus:ring-[#123D2A]" />
        <textarea required name="message" placeholder="Nachricht" class="md:col-span-2 bg-white border border-[#123D2A]/20 rounded-md p-3 text-[#1A1A1A] placeholder:text-[#6B7280] focus:outline-none focus:ring-2 focus:ring-[#123D2A]" rows="5"></textarea>
        <button type="submit" data-submit class="md:col-span-2 px-5 py-3 rounded-full bg-[#123D2A] text-[#F5F1E9] hover:bg-[#C8501E] transition-colors">Nachricht senden</button>
      </form>
      <div class="mt-6 text-[#1A1A1A]/70">
        <p><strong>Oder direkt:</strong> <a class="text-[#123D2A] underline hover:text-[#C8501E]" href="mailto:gjanuzikrieg@gmail.com">gjanuzikrieg@gmail.com</a> · <a class="text-[#123D2A] underline hover:text-[#C8501E]" href="tel:+491756372395">+49 175 6372395</a></p>
      </div>
    </div>
  </section>
</BaseLayout>
