---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
const title = 'Kontakt | Angebot anfragen | Online‑Marketing Schwäbisch Gmünd';
const description = 'Kostenloses Erstgespräch: +49 175 6372395 oder gjanuzikrieg@gmail.com. Online‑Marketing Office für Schwäbisch Gmünd & Umgebung.';
const canonical = 'https://online-marketing-office.de/kontakt';
---
<Base {title} {description} {canonical}>
  <Header />
  <main id="main">
    <section class="section container flow">
      <h1>Kontakt</h1>
      <p class="text-muted">Wir melden uns in der Regel innerhalb von 24 Stunden mit den nächsten Schritten.</p>
    </section>
    <Contact />
  </main>
  <Footer />
</Base>
