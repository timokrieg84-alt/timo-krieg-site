---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Kontakt | Performance Marketing Beratung | Schwäbisch Gmünd | Timo Krieg';
const description = 'Kostenloses Erstgespräch: +49 160 4365363. Adresse: Kitzingstraße 7, 73529 Schwäbisch Gmünd. Jetzt Termin sichern.';
const telHref = 'tel:+491604365363';
---
<BaseLayout {title} {description}>
  <section class="container py-16 md:py-24">
    <h1 class="text-3xl md:text-5xl font-semibold">Sprechen wir über Wachstum</h1>
    <p class="mt-4 max-w-2xl text-slate-400">Kurzer Draht, klare Antworten. In 15 Minuten klären wir Potenziale, Budgetrahmen und nächste Schritte.</p>

    <div class="mt-8 grid gap-8 md:grid-cols-2">
      <div class="card">
        <h2 class="text-xl font-semibold">Direktkontakt</h2>
        <ul class="mt-3 space-y-2">
          <li><a class="focus-ring" href={telHref}>+49 160 4365363</a></li>
          <li><a class="focus-ring" href="mailto:info@listingprofis.de">info@listingprofis.de</a></li>
          <li>Kitzingstraße 7, 73529 Schwäbisch Gmünd</li>
        </ul>
        <div class="mt-4 flex gap-3">
          <a href={telHref} class="btn btn-primary">Jetzt anrufen</a>
          <a href="#form" class="btn btn-secondary">Erstgespräch vereinbaren</a>
        </div>
        <p class="mt-3 text-xs text-slate-400">Hinweis: Eingehende Anfragen werden per Telegram-Benachrichtigung zugestellt.</p>
      </div>

      <form id="form" class="card space-y-4" action="https://timokrieg.app.n8n.cloud/webhook/contact-form" method="post">
        <h2 class="text-xl font-semibold">Kontaktformular</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm mb-1" for="name">Name</label>
            <input id="name" name="name" type="text" class="w-full rounded-md bg-white/5 border-white/10 focus:outline-none focus:ring-2 focus:ring-indigo-400" required />
          </div>
          <div>
            <label class="block text-sm mb-1" for="email">E-Mail</label>
            <input id="email" name="email" type="email" class="w-full rounded-md bg-white/5 border-white/10 focus:outline-none focus:ring-2 focus:ring-indigo-400" required />
          </div>
          <div>
            <label class="block text-sm mb-1" for="phone">Telefon</label>
            <input id="phone" name="phone" type="tel" class="w-full rounded-md bg-white/5 border-white/10 focus:outline-none focus:ring-2 focus:ring-indigo-400" />
          </div>
          <div>
            <label class="block text-sm mb-1" for="budget">Budget</label>
            <select id="budget" name="budget" class="w-full rounded-md bg-white/5 border-white/10 focus:outline-none focus:ring-2 focus:ring-indigo-400">
              <option value="unbekannt">Unbekannt</option>
              <option value="unter-5k">unter 5.000 €</option>
              <option value="5k-15k">5.000–15.000 €</option>
              <option value="15k-50k">15.000–50.000 €</option>
              <option value="ueber-50k">über 50.000 €</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-sm mb-1" for="message">Nachricht</label>
          <textarea id="message" name="message" rows="5" class="w-full rounded-md bg-white/5 border-white/10 focus:outline-none focus:ring-2 focus:ring-indigo-400" required></textarea>
        </div>
        <input type="hidden" name="site" value="Kontaktformular" />
        <button type="submit" class="btn btn-primary">Absenden</button>
        <p class="text-xs text-slate-400">Mit Ihrer Kontaktaufnahme verarbeiten wir Ihre Angaben zur Beantwortung der Anfrage (Art. 6 Abs. 1 lit. b DSGVO). Details in der <a class="underline" href="/datenschutz">Datenschutzerklärung</a>.</p>
      </form>
    </div>
  </section>
</BaseLayout>
