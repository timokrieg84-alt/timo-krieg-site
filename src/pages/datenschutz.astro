---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
---
<Layout>
  <section class="py-16 sm:py-24 lg:py-28">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-5xl font-semibold text-[#1A1A1A] mb-6">Datenschutzerklärung</h1>
      <div class="whitespace-pre-line text-[#1A1A1A]/80 bg-[#F5F1E9] rounded-2xl border border-[#123D2A]/10 p-6">{site.legal.datenschutz}</div>
      <div class="mt-8">
        <a href="/" class="text-sm text-[#123D2A] hover:text-[#C8501E]">← Zurück zur Startseite</a>
      </div>
    </div>
  </section>
</Layout>
