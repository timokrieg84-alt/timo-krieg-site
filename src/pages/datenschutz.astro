---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const title = 'Datenschutz | DSGVO‑konform | Online Marketing Office';
const description = 'Informationen zur Datenverarbeitung, Cookies, Tracking (GA4/Consent Mode v2), Betroffenenrechte.';
const canonical = 'https://online-marketing-office.de/datenschutz';
---
<Base {title} {description} {canonical}>
  <Header />
  <main class="section container flow">
    <h1>Datenschutzerklärung</h1>
    <p class="text-muted">Wir verarbeiten personenbezogene Daten gemäß DSGVO. Analytics & Marketing nur mit Ihrer Einwilligung.</p>
    <h2>Verantwortlicher</h2>
    <p>Gylsere Januzi Krieg – Online Marketing Office, Kitzingstraße 7, 73529 Schwäbisch Gmünd, E‑Mail: <a href="mailto:gjanuzikrieg@gmail.com">gjanuzikrieg@gmail.com</a></p>
    <h2>Zwecke & Rechtsgrundlagen</h2>
    <ul class="flow">
      <li>Kontaktaufnahme und Beantwortung von Anfragen (Art. 6 Abs. 1 lit. b, f DSGVO)</li>
      <li>Webanalyse mit Einwilligung (Art. 6 Abs. 1 lit. a DSGVO)</li>
      <li>Systemsicherheit & Logfiles (Art. 6 Abs. 1 lit. f DSGVO)</li>
    </ul>
    <h2>Empfänger & Drittlandtransfer</h2>
    <p>Eine Weitergabe Ihrer Daten erfolgt nur, soweit erforderlich. Kein Verkauf Ihrer Daten.</p>
    <h2>Speicherdauer</h2>
    <p>Speicherung bis zur Zweckerreichung bzw. gesetzlichen Aufbewahrung.</p>
    <h2>Betroffenenrechte</h2>
    <ul class="flow"><li>Auskunft, Berichtigung, Löschung</li><li>Einschränkung, Widerspruch</li><li>Datenübertragbarkeit</li><li>Beschwerderecht bei der Aufsichtsbehörde</li></ul>
    <h2>Kontaktformular</h2>
    <p>Ihre Anfrage wird per sicherer Verbindung an unsere Systeme übertragen. Interne Benachrichtigung via Telegram.</p>
  </main>
  <Footer />
</Base>
