---
import Layout from "../layouts/Layout.astro";
import { legal } from "../data/site";
---
<Layout>
  <section class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="mx-auto">
      <div class="[&>h1]:text-3xl [&>h1]:font-extrabold [&>h1]:tracking-tight [&>h1]:text-[#0B1221] [&>h2]:mt-8 [&>h2]:text-xl [&>h2]:font-semibold [&>h2]:text-[#0B1221] [&>p]:mt-4 [&>p]:text-[#0B1221]/90 [&_a]:text-[#0EA5E9] hover:[&_a]:underline">
        <div set:html={legal.datenschutz}></div>
      </div>
    </div>
  </section>
</Layout>
