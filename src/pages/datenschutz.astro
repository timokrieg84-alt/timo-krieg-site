---
import Layout from "../layouts/Layout.astro";
import { brand, colors, legal } from "../data/site";
const ds = legal.datenschutz;
---
<Layout title={`${ds.title} – ${brand.name}`} description={`${brand.name} – ${ds.title}`}>
  <section class={`bg-[${colors.background}] border-b border-[${colors.muted}]/20`}>
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 pt-16 pb-10">
      <nav class="text-sm">
        <a href="/" class={`text-[${colors.primary}] hover:text-[${colors.secondary}]`}>Start</a>
        <span class={`mx-2 text-[${colors.text}]/40`}>/</span>
        <span class={`text-[${colors.text}]/60`}>{ds.title}</span>
      </nav>
      <h1 class={`mt-4 text-3xl md:text-5xl font-semibold text-[${colors.text}]`}>{ds.title}</h1>
    </div>
  </section>
  <section class={`bg-[${colors.background}]`}>
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12 space-y-10">
      <div class={`rounded-2xl border border-[${colors.muted}]/20 bg-[${colors.background}] p-6 space-y-4`}>
        <h2 class={`text-xl font-semibold text-[${colors.text}]`}>Verantwortlicher</h2>
        <p class={`text-[${colors.text}]/90`}>
          {ds.verantwortlicher.name}<br />
          Ansprechperson: {ds.verantwortlicher.ansprechperson}<br />
          {ds.verantwortlicher.anschrift}<br />
          Telefon: <a class={`text-[${colors.primary}] hover:text-[${colors.secondary}]`} href="tel:+491756372395">{ds.verantwortlicher.telefon}</a><br />
          E-Mail: <a class={`text-[${colors.primary}] hover:text-[${colors.secondary}]`} href="mailto:{ds.verantwortlicher.eMail}">{ds.verantwortlicher.eMail}</a>
        </p>
      </div>

      <div class={`rounded-2xl border border-[${colors.muted}]/20 bg-[${colors.background}] p-6 space-y-4`}>
        <h2 class={`text-xl font-semibold text-[${colors.text}]`}>Allgemeines</h2>
        <p class={`text-[${colors.text}]/90`}>{ds.allgemeines}</p>
      </div>

      <div class={`rounded-2xl border border-[${colors.muted}]/20 bg-[${colors.background}] p-6 space-y-4`}>
        <h2 class={`text-xl font-semibold text-[${colors.text}]`}>Hosting und Server-Logs</h2>
        <p class={`text-[${colors.text}]/90`}>{ds.hostingUndServerLogs}</p>
      </div>

      <div class={`rounded-2xl border border-[${colors.muted}]/20 bg-[${colors.background}] p-6 space-y-4`}>
        <h2 class={`text-xl font-semibold text-[${colors.text}]`}>SSL/TLS-Verschlüsselung</h2>
        <p class={`text-[${colors.text}]/90`}>{ds.sslTls}</p>
      </div>

      <div class={`rounded-2xl border border-[${colors.muted}]/20 bg-[${colors.background}] p-6 space-y-4`}>
        <h2 class={`text-xl font-semibold text-[${colors.text}]`}>Cookies</h2>
        <p class={`text-[${colors.text}]/90`}>{ds.cookies}</p>
      </div>

      <div class={`rounded-2xl border border-[${colors.muted}]/20 bg-[${colors.background}] p-6 space-y-4`}>
        <h2 class={`text-xl font-semibold text-[${colors.text}]`}>Kontaktformular</h2>
        <p class={`text-[${colors.text}]/90`}>{ds.kontaktformular}</p>
      </div>

      <div class={`rounded-2xl border border-[${colors.muted}]/20 bg-[${colors.background}] p-6 space-y-4`}>
        <h2 class={`text-xl font-semibold text-[${colors.text}]`}>Kommunikation</h2>
        <p class={`text-[${colors.text}]/90`}>{ds.kommunikation}</p>
      </div>

      <div class={`rounded-2xl border border-[${colors.muted}]/20 bg-[${colors.background}] p-6 space-y-4`}>
        <h2 class={`text-xl font-semibold text-[${colors.text}]`}>Auftragsverarbeitung</h2>
        <p class={`text-[${colors.text}]/90`}>{ds.auftragsverarbeitung}</p>
      </div>

      <div class={`rounded-2xl border border-[${colors.muted}]/20 bg-[${colors.background}] p-6 space-y-4`}>
        <h2 class={`text-xl font-semibold text-[${colors.text}]`}>Drittlandtransfer</h2>
        <p class={`text-[${colors.text}]/90`}>{ds.drittlandtransfer}</p>
      </div>

      <div class={`rounded-2xl border border-[${colors.muted}]/20 bg-[${colors.background}] p-6 space-y-4`}>
        <h2 class={`text-xl font-semibold text-[${colors.text}]`}>Speicherdauer</h2>
        <p class={`text-[${colors.text}]/90`}>{ds.speicherdauer}</p>
      </div>

      <div class={`rounded-2xl border border-[${colors.muted}]/20 bg-[${colors.background}] p-6 space-y-4`}>
        <h2 class={`text-xl font-semibold text-[${colors.text}]`}>Ihre Rechte</h2>
        <p class={`text-[${colors.text}]/90`}>{ds.ihreRechte}</p>
      </div>

      <div class={`rounded-2xl border border-[${colors.muted}]/20 bg-[${colors.background}] p-6 space-y-4`}>
        <h2 class={`text-xl font-semibold text-[${colors.text}]`}>Beschwerderecht</h2>
        <p class={`text-[${colors.text}]/90`}>{ds.beschwerderecht}</p>
      </div>

      <div class={`rounded-2xl border border-[${colors.muted}]/20 bg-[${colors.background}] p-6 space-y-4`}>
        <h2 class={`text-xl font-semibold text-[${colors.text}]`}>Pflicht zur Bereitstellung</h2>
        <p class={`text-[${colors.text}]/90`}>{ds.pflichtZurBereitstellung}</p>
      </div>

      <div class={`rounded-2xl border border-[${colors.muted}]/20 bg-[${colors.background}] p-6 space-y-4`}>
        <h2 class={`text-xl font-semibold text-[${colors.text}]`}>Änderungen</h2>
        <p class={`text-[${colors.text}]/90`}>{ds.aenderungen}</p>
      </div>

      <div class="pt-4">
        <a href="/" class={`text-sm text-[${colors.primary}] hover:text-[${colors.secondary}]`}>Zur Startseite</a>
      </div>
    </div>
  </section>
</Layout>
