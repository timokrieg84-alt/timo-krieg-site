---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/Section.astro";
---
<Layout title="Datenschutz – Gylsere Januzi" description="Hinweise zum Datenschutz.">
  <Fragment slot="header"><Header /></Fragment>
  <Section title="Datenschutz">
    <div class="prose prose-invert max-w-none text-sm text-gray-300">
      <p>Wir nehmen den Schutz Ihrer Daten ernst. Bei Anfragen über das Kontaktformular werden die angegebenen Daten ausschließlich zur Bearbeitung der Anfrage verwendet. Details teilen wir auf Anfrage mit.</p>
    </div>
  </Section>
  <Fragment slot="footer"><Footer /></Fragment>
</Layout>
