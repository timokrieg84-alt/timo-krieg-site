---
import Layout from "../layouts/Layout.astro";
import { legal, projectInfo, sections } from "../data/site";
const p = legal.privacy;
---
<Layout title={`Datenschutz – ${projectInfo.name}`} description={`Datenschutzerklärung von ${projectInfo.name}` }>
  <section class="pt-10 sm:pt-14 lg:pt-16 pb-10">
    <nav class="text-xs text-[#1E293B] mb-4" aria-label="Breadcrumb">
      <a class="hover:text-[#06B6D4]" href="/">Startseite</a>
      <span class="mx-2">/</span>
      <span class="text-[#0F172A] font-medium">Datenschutz</span>
    </nav>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-[#0F172A]">Datenschutzerklärung</h1>
    <p class="mt-3 max-w-3xl text-[#1E293B]">Mit den folgenden Hinweisen informieren wir Sie über die Verarbeitung personenbezogener Daten beim Besuch unserer Website.</p>
  </section>

  <section class="grid lg:grid-cols-12 gap-10 py-8 border-t border-[#F1F5F9]">
    <div class="lg:col-span-7 space-y-8">
      <div>
        <h2 class="text-xl font-bold text-[#0F172A]">Verantwortlicher</h2>
        <p class="mt-3 text-[#1E293B]">
          {p.responsible.name}<br/>
          Vertreten durch: {p.responsible.representative}<br/>
          {p.responsible.address}<br/>
          Kontakt: {p.responsible.contact}
        </p>
      </div>

      <div>
        <h2 class="text-xl font-bold text-[#0F172A]">Hosting</h2>
        <p class="mt-3 text-[#1E293B]">{p.hosting.note}</p>
        <p class="mt-2 text-[#1E293B]">{p.hosting.dpa}</p>
      </div>

      <div>
        <h2 class="text-xl font-bold text-[#0F172A]">Server-Logfiles</h2>
        <p class="mt-3 text-[#1E293B]">{p.serverLogs}</p>
      </div>

      <div>
        <h2 class="text-xl font-bold text-[#0F172A]">Cookies</h2>
        <p class="mt-3 text-[#1E293B]">{p.cookies}</p>
      </div>

      <div>
        <h2 class="text-xl font-bold text-[#0F172A]">Webanalyse</h2>
        <p class="mt-3 text-[#1E293B]">{p.analytics}</p>
      </div>

      <div>
        <h2 class="text-xl font-bold text-[#0F172A]">Ihre Rechte</h2>
        <ul class="mt-3 list-disc list-inside text-[#1E293B]">
          {p.dataSubjectsRights.map((r) => (<li>{r}</li>))}
        </ul>
        <p class="mt-3 text-[#1E293B]">Wenden Sie sich zur Wahrnehmung Ihrer Rechte jederzeit an: <a class="text-[#C026D3] hover:text-[#06B6D4]" href={`mailto:${p.contactForPrivacy}`}>{p.contactForPrivacy}</a></p>
      </div>

      <div>
        <h2 class="text-xl font-bold text-[#0F172A]">Auftragsverarbeiter</h2>
        <ul class="mt-3 list-disc list-inside text-[#1E293B]">
          {p.processorList.map((r) => (<li>{r}</li>))}
        </ul>
      </div>

      <p class="text-xs text-[#1E293B]">Stand: {p.lastUpdated}</p>
    </div>

    <aside class="lg:col-span-5">
      <div class="rounded-2xl border border-[#F1F5F9] p-6">
        <h3 class="text-base font-semibold text-[#0F172A]">Direktlinks</h3>
        <ul class="mt-3 space-y-2 text-sm text-[#1E293B]">
          <li><a class="text-[#C026D3] hover:text-[#06B6D4]" href="/">Startseite</a></li>
          <li><a class="text-[#C026D3] hover:text-[#06B6D4]" href={`/#${sections.leistungen}`}>Leistungen</a></li>
          <li><a class="text-[#C026D3] hover:text-[#06B6D4]" href={`/#${sections.kontakt}`}>Kontakt</a></li>
          <li><a class="text-[#C026D3] hover:text-[#06B6D4]" href="/impressum">Impressum</a></li>
        </ul>
        <p class="mt-4 text-xs text-[#1E293B]">Diese Datenschutzhinweise gelten für die gesamte Website von {projectInfo.name}.</p>
      </div>
    </aside>
  </section>
</Layout>
