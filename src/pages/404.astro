---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Seite nicht gefunden – Gylsere Januzi Krieg">
  <section class="py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-xs uppercase tracking-wider text-[#123D2A]">Fehler 404</div>
      <h1 class="mt-3 text-3xl sm:text-5xl font-semibold text-[#1A1A1A] mb-2">Seite nicht gefunden</h1>
      <p class="text-lg text-[#1A1A1A]/70">Die angeforderte Seite wurde nicht gefunden. Zurück zur <a href="/" class="text-[#123D2A] underline hover:text-[#C8501E]">Startseite</a>.</p>
    </div>
  </section>
</BaseLayout>
