---
import '../styles/global.css';
const title = 'Seite nicht gefunden (404) | Timo Krieg – Performance Marketing';
const description = 'Die gewünschte Seite existiert nicht. Zurück zur Startseite oder direkt zu Leistungen und Kontakt.';
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="noindex" />
</head>
<body>
  <main class="min-h-screen grid place-items-center bg-slate-50">
    <div class="container text-center">
      <span class="badge">Fehler 404</span>
      <h1 class="mt-4 text-4xl md:text-5xl font-semibold tracking-tight">Diese Seite gibt es nicht.</h1>
      <p class="mt-3 text-slate-600">Vielleicht helfen diese Links weiter:</p>
      <div class="mt-6 flex flex-wrap gap-3 justify-center">
        <a href="/" class="btn btn-primary">Zur Startseite</a>
        <a href="/leistungen/" class="btn btn-secondary">Leistungen</a>
        <a href="/kontakt" class="btn btn-secondary">Kontakt</a>
      </div>
    </div>
  </main>
</body>
</html>
