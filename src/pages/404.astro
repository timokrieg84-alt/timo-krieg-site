---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import IconSprite from '../components/IconSprite.astro';
const pageTitle = 'Seite nicht gefunden | ListingProfis';
const pageDesc = 'Diese Seite gibt es nicht mehr. Zurück zur Startseite oder Kontakt aufnehmen – wir helfen gerne weiter.';
---
<BaseLayout title={pageTitle} description={pageDesc}>
  <Fragment slot="icons"><IconSprite /></Fragment>
  <Fragment slot="header"><Header /></Fragment>
  <main>
    <section class="section container text-center">
      <h1>404 – Seite nicht gefunden</h1>
      <p class="text-muted">Zurück zur <a href="/">Startseite</a> oder <a href="/kontakt/">Kontakt</a>.</p>
    </section>
  </main>
  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>
