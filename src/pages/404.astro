---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Seite nicht gefunden | Timo Krieg" description="Die gesuchte Seite wurde nicht gefunden.">
  <section class="container py-24 text-center">
    <h1 class="text-4xl md:text-6xl font-semibold">404</h1>
    <p class="mt-4 text-brand.muted">Die gesuchte Seite wurde nicht gefunden.</p>
    <div class="mt-6">
      <a href="/" class="btn btn-primary">Zur Startseite</a>
    </div>
  </section>
</BaseLayout>
