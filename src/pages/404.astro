---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Seite nicht gefunden | Timo Krieg</title>
    <meta name="robots" content="noindex" />
  </head>
  <body class="min-h-screen bg-slate-950 text-white font-sans grid place-items-center">
    <main class="container py-16 text-center">
      <h1 class="text-5xl font-semibold">404</h1>
      <p class="mt-3 text-slate-300">Die gesuchte Seite wurde nicht gefunden.</p>
      <div class="mt-6"><a href="/" class="btn btn-primary">Zur Startseite</a></div>
    </main>
  </body>
</html>
