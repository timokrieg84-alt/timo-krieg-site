---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import HeadSEO from "@/components/HeadSEO.astro";
const meta = {
  title: "Impressum | Gylsere Januzi Krieg – Online Marketing Office",
  description: "Impressum und gesetzliche Angaben.",
  url: "https://example.com/impressum/",
  canonical: "https://example.com/impressum/",
  image: "/images/hero-bg.webp",
  type: "article"
};
---
<html lang="de" class="dark">
  <head>
    <HeadSEO {...meta} />
  </head>
  <body>
    <Layout title={meta.title} description={meta.description}>
      <Fragment slot="nav"><Navbar /></Fragment>
      <main class="container py-16">
        <h1 class="h1">Impressum</h1>
        <div class="mt-6 text-txt-2 grid gap-2">
          <p><strong>Dienstanbieter</strong><br/>Gylsere Januzi Krieg – Online Marketing Office<br/>Kitzingstraße 7<br/>73529 Schwäbisch Gmünd</p>
          <p><strong>Kontakt</strong><br/>Telefon: +49 175 6372395<br/>E-Mail: gjanuzikrieg@gmail.com</p>
          <p><strong>Umsatzsteuer-ID</strong><br/>Wird nachgereicht.</p>
          <p><strong>Inhaltlich Verantwortliche</strong><br/>Gylsere Januzi Krieg</p>
          <p><strong>Haftung für Inhalte</strong><br/>Trotz sorgfältiger inhaltlicher Kontrolle übernehmen wir keine Haftung für die Inhalte externer Links.</p>
        </div>
      </main>
      <Fragment slot="footer"><Footer /></Fragment>
    </Layout>
  </body>
</html>
