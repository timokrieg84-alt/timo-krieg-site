---
import Layout from "../layouts/Layout.astro";
import { brand, legal, projectInfo, sections } from "../data/site";
---
<Layout title={`Impressum – ${brand.logoText}`} description={`Impressum von ${projectInfo.name}` }>
  <section class="bg-[#FFFFFF]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <nav class="text-sm text-[#94A3B8]" aria-label="Breadcrumb">
        <a class="hover:text-[#1E40AF]" href="/">Start</a>
        <span class="mx-2">/</span>
        <span class="text-[#0F172A]">Impressum</span>
      </nav>

      <div class="mt-6 grid lg:grid-cols-3 gap-12">
        <article class="lg:col-span-2">
          <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">Impressum</h1>

          <div class="mt-6 grid sm:grid-cols-2 gap-6">
            <div class="rounded-xl border border-[#F1F5F9] p-6 bg-[#FFFFFF]">
              <h2 class="text-xl font-semibold">Verantwortlich</h2>
              <p class="mt-3 text-sm text-[#0F172A]">
                {legal.companyName}<br/>
                {legal.owner}
              </p>
            </div>
            <div class="rounded-xl border border-[#F1F5F9] p-6 bg-[#FFFFFF]">
              <h2 class="text-xl font-semibold">Anschrift</h2>
              <p class="mt-3 text-sm text-[#0F172A]">
                {legal.address.street}<br/>
                {legal.address.zip} {legal.address.city}<br/>
                {legal.address.country}
              </p>
            </div>
            <div class="rounded-xl border border-[#F1F5F9] p-6 bg-[#FFFFFF]">
              <h2 class="text-xl font-semibold">Kontakt</h2>
              <p class="mt-3 text-sm text-[#0F172A]">
                Telefon: <a class="text-[#1E40AF] hover:text-[#F97316]" href={`tel:${legal.contact.phone.replace(/\s+/g, '')}`}>{legal.contact.phone}</a><br/>
                E-Mail: <a class="text-[#1E40AF] hover:text-[#F97316]" href={`mailto:${legal.contact.email}`}>{legal.contact.email}</a><br/>
                Web: <a class="text-[#1E40AF] hover:text-[#F97316]" href={legal.contact.website}>{legal.contact.website}</a>
              </p>
            </div>
            <div class="rounded-xl border border-[#F1F5F9] p-6 bg-[#FFFFFF]">
              <h2 class="text-xl font-semibold">Register & Steuern</h2>
              <p class="mt-3 text-sm text-[#0F172A]">
                {legal.register.type}: {legal.register.court}, Nr. {legal.register.number}<br/>
                USt-IdNr.: {legal.vatId}
              </p>
            </div>
          </div>

          <div class="mt-10 space-y-8">
            {legal.impressumSections.map((sec) => (
              <section>
                <h2 class="text-2xl font-semibold">{sec.title}</h2>
                {sec.paragraphs.map((p) => (
                  <p class="mt-3 text-sm text-[#0F172A] max-w-prose">{p}</p>
                ))}
              </section>
            ))}
          </div>

          <div class="mt-10 rounded-xl border border-[#F1F5F9] p-6 bg-[#F1F5F9] text-sm text-[#0F172A]">
            <p>EU-Streitschlichtung: <a class="text-[#1E40AF] hover:text-[#F97316]" href={legal.euDisputeResolutionUrl}>{legal.euDisputeResolutionUrl}</a></p>
            <p class="mt-2">Zuständige Aufsichtsbehörde: {legal.supervisoryAuthority}</p>
            <p class="mt-2">{legal.consumerDisputeBody}</p>
          </div>

          <div class="mt-12 border-t border-[#F1F5F9] pt-6">
            <a href={`/#${sections.contact}`} class="inline-flex items-center rounded-md bg-[#1E40AF] text-[#FFFFFF] px-5 py-3 font-medium hover:bg-[#0F172A] transition-colors border border-[#1E40AF] hover:border-[#0F172A]">Kontakt aufnehmen</a>
          </div>
        </article>

        <aside class="lg:col-span-1">
          <div class="rounded-xl border border-[#F1F5F9] p-6 bg-[#FFFFFF]">
            <h2 class="font-semibold">Direkt zu</h2>
            <ul class="mt-3 space-y-2 text-sm">
              <li><a href="/" class="hover:text-[#1E40AF]">Startseite</a></li>
              <li><a href={`/#${sections.services}`} class="hover:text-[#1E40AF]">Leistungen</a></li>
              <li><a href={`/datenschutz`} class="hover:text-[#1E40AF]">Datenschutz</a></li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>
