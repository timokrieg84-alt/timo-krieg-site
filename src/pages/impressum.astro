  <main class="max-w-4xl mx-auto px-4 py-16 text-gray-200">
    <h1 class="text-3xl font-bold mb-6 text-white">Impressum</h1>

    <section class="mb-8">
      <h2 class="text-xl font-semibold mb-2 text-white">Angaben gemäß § 5 TMG</h2>
      <address class="not-italic leading-relaxed">
        <div>Gylsere Januzi Online Marketing Office</div>
        <div>Inhaberin: Gylsere Januzi</div>
        <div>73525 Schwäbisch Gmünd</div>
        <div>Deutschland</div>
