---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<Layout title="Impressum – Gylsere Januzi">
  <Fragment slot="header"><Header /></Fragment>
  <section class="py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold text-white mb-4">Impressum</h1>
    <p class="text-gray-400">Inhalt folgt. Kontakt: <a class="text-[#FF2D9A] hover:underline" href="mailto:info@januzi-bau.de">info@januzi-bau.de</a></p>
  </section>
  <Fragment slot="footer"><Footer /></Fragment>
</Layout>
