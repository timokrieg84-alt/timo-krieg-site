---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { legalPlaceholders, projectInfo } from "../data/site";
const page = legalPlaceholders.impressum;
---

<Layout title={`${page.title} | ${projectInfo.company_name}`}>
  <Header />
  <main class="max-w-4xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-extrabold mb-6">{page.title}</h1>
    <article class="prose prose-invert max-w-none">
      <pre class="whitespace-pre-wrap text-sm leading-6">{page.content}</pre>
    </article>
  </main>
  <Footer />
</Layout>
