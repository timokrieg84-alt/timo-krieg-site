---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/Section.astro";
---
<Layout title="Wir – Gylsere Januzi" description="Team und Haltung.">
  <Fragment slot="header"><Header /></Fragment>
  <Section title="Gylsere Januzi - online marketing office" intro="Exzellenz & Digitale Präsenz. Wir arbeiten strukturiert, messbar und ohne Buzzwords.">
    <div class="bg-[#131b2e] border border-gray-800 p-8 rounded-xl max-w-2xl">
      <p class="text-gray-300 leading-relaxed">
        Wir stehen für messbaren Erfolg, klare Kommunikation und kompromisslose Qualität im Online-Marketing. Keine leeren Versprechungen, sondern fundiertes Handwerk und datenbasierte Strategien für Ihren nachhaltigen Vorsprung.
      </p>
    </div>
  </Section>
  <Fragment slot="footer"><Footer /></Fragment>
</Layout>