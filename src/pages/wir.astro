---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Wir – Gylsere Januzi Krieg Online Marketing Office" description="Das Team für konsequente Performance: Strategie, Kreation, Engineering.">
  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="text-xs uppercase tracking-wider text-[#123D2A]">Über uns</div>
        <h1 class="mt-3 text-3xl sm:text-5xl font-semibold text-[#1A1A1A] mb-4">Wir</h1>
        <p class="text-lg text-[#1A1A1A]/70">Wir kombinieren datengetriebenes Marketing mit schnellem, sauberem Engineering. Kurze Wege. Echte Verantwortung. Klarer Fokus auf Ergebnis.</p>
        <div class="mt-8"><a href="/#contact" class="inline-flex items-center gap-2 rounded-full bg-[#123D2A] px-5 py-3 text-[#F5F1E9] hover:bg-[#C8501E] transition-colors">Projekt anfragen</a></div>
      </div>
    </div>
  </section>
</BaseLayout>
