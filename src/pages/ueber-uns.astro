---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const title = 'Über uns | Online‑Marketing Büro Schwäbisch Gmünd | GJK';
const description = 'Ein fester Ansprechpartner, messbare Ergebnisse, Premium‑Anspruch. Boutique‑Office für KMU, Praxen & B2B im Ostalbkreis.';
const canonical = 'https://online-marketing-office.de/ueber-uns';
---
<Base {title} {description} {canonical}>
  <Header />
  <main class="section container flow">
    <h1>Über uns</h1>
    <h2>Boutique‑Office. Große Wirkung.</h2>
    <p>Wir sind ein fokussiertes Online‑Marketing‑Office – präzise, verantwortungsvoll, senior‑geführt. Weniger Streuverlust, mehr Relevanz.</p>
    <h3>Methodik</h3>
    <ul class="flow"><li>Analyse vor Aktion: Daten, Markt, Wettbewerb.</li><li>Klarer Plan: Roadmap mit Prioritäten und KPIs.</li><li>Saubere Umsetzung: Technik, Content, Ads.</li><li>Permanente Optimierung: Tests, Learnings, Skalierung.</li></ul>
    <h3>Werte</h3>
    <ul class="flow"><li>Qualität vor Quantität</li><li>Datenschutz & Transparenz</li><li>Verlässlichkeit & Tempo</li><li>Hands‑on & ergebnisorientiert</li></ul>
    <h3>Verankert in Schwäbisch Gmünd</h3>
    <p>Regional verwurzelt, überregional wirksam – kurze Wege, persönlicher Kontakt, ein fester Ansprechpartner für Ihr Projekt.</p>
    <p><a class="btn" href="/kontakt">Unverbindliches Erstgespräch sichern</a></p>
  </main>
  <Footer />
</Base>
