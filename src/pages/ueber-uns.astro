---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Section from "@/components/Section.astro";
import CTA from "@/components/CTA-Bar.astro";
import Footer from "@/components/Footer.astro";
---
<Layout title="Über uns | Gylsere Januzi Krieg – Online Marketing Office" description="Strategen, Tech‑Nerds & Kreative aus Schwäbisch Gmünd. Wir verbinden Performance, Marke und High‑Performance Webdesign für messbares Wachstum.">
  <Fragment slot="nav"><Navbar /></Fragment>
  <Section title="Premium‑Online‑Marketing aus Schwäbisch Gmünd" intro="Wir entwickeln High‑Performance‑Websites und messbares Online‑Marketing für Unternehmen, die wachsen wollen – mit Fokus auf Sichtbarkeit, Anfragen und Umsatz.">
    <div class="grid md:grid-cols-2 gap-8 items-start">
      <div class="card p-6">
        <h3 class="h3">Werte</h3>
        <ul class="mt-3 text-txt-2 grid gap-2 list-disc pl-5">
          <li>Klarheit: Ziele, KPIs und Erwartungen sind von Beginn an definiert</li>
          <li>Qualität: saubere Codebasis, schnelle Ladezeiten, starke UX</li>
          <li>Verantwortung: DSGVO und Consent‑Management ohne Kompromisse</li>
          <li>Partnerschaft: langfristige Zusammenarbeit auf Augenhöhe</li>
        </ul>
      </div>
      <div class="card p-6">
        <h3 class="h3">Arbeitsweise</h3>
        <p class="text-txt-2 mt-2">Strategisch, datenbasiert, effizient. Moderne Tech‑Stacks (Astro, Headless, Tracking) treffen erprobte SEO‑ & Performance‑Playbooks. Jede Maßnahme zahlt auf Ihre KPIs ein – kein Overhead.</p>
      </div>
    </div>
    <div class="mt-10 grid md:grid-cols-3 gap-6">
      <div class="card p-6"><strong>+30</strong><div class="text-txt-2">Branchenportale</div></div>
      <div class="card p-6"><strong>50</strong><div class="text-txt-2">Satelliten‑Seiten</div></div>
      <div class="card p-6"><strong>100%</strong><div class="text-txt-2">DSGVO‑konform</div></div>
    </div>
  </Section>
  <Section title="Ihre Ansprechpartnerin" intro="Ein fester Kontakt – von der Idee bis zur Skalierung.">
    <div class="grid md:grid-cols-[2fr,1fr] gap-8 items-center">
      <div class="card p-6">
        <p>Gylsere begleitet Ihr Projekt persönlich: verbindlich, erreichbar, lösungsorientiert. Kurze Wege, schnelle Entscheidungen – für Tempo und Qualität.</p>
      </div>
      <figure class="card overflow-hidden">
        <img src="/images/portrait-gylsere.webp" alt="Porträt von Gylsere Januzi Krieg im dunklen Studio‑Look mit Cyan‑Licht" class="w-full h-full object-cover" loading="lazy" />
      </figure>
    </div>
  </Section>
  <CTA />
  <Fragment slot="footer"><Footer /></Fragment>
</Layout>
