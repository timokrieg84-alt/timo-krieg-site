---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Über uns: Ihre Digitalagentur für B2B‑Wachstum | Schwäbisch Gmünd | Timo Krieg';
const description = 'Klarer Kurs. Messbare Ergebnisse. Regional verwurzelt, in DACH aktiv. Persönlicher Ansprechpartner: Timo Krieg.';
---
<BaseLayout {title} {description}>
  <section class="container py-16 md:py-24">
    <h1 class="text-3xl md:text-5xl font-semibold">Klarer Kurs. Messbare Ergebnisse.</h1>
    <p class="mt-4 max-w-3xl text-slate-400">Ein Projekt, ein Ziel: geschäftsrelevante Resultate. Wir kombinieren präzises Handwerk mit ehrlicher Beratung – ohne Jargon, ohne Umwege.</p>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      <div class="card">
        <h2 class="text-xl font-semibold">Philosophie</h2>
        <p class="mt-2 text-slate-400">Strategie vor Design. Fokus auf Kundennutzen, klare KPIs und kontinuierliches Lernen.</p>
      </div>
      <div class="card">
        <h2 class="text-xl font-semibold">Qualitätsversprechen</h2>
        <ul class="mt-2 list-disc pl-5 text-slate-300 space-y-1">
          <li>Performance by default: Speed, SEO, Conversion</li>
          <li>Transparenz in Zeit, Budget und Ergebnis</li>
          <li>Verbindliche Kommunikation, schnelle Reaktionszeiten</li>
        </ul>
      </div>
      <div class="card">
        <h2 class="text-xl font-semibold">Regionaler Fokus</h2>
        <p class="mt-2 text-slate-400">Verwurzelt in Schwäbisch Gmünd, aktiv in DACH. Wir kennen die Bedürfnisse des Mittelstands – von Industrie bis Dienstleistung.</p>
      </div>
    </div>

    <div class="mt-12 card">
      <h2 class="text-xl font-semibold">Ihr Ansprechpartner</h2>
      <p class="mt-2 text-slate-400">Timo Krieg – Inhaber, Strategieberatung, Webdesign, Performance Marketing. Ein Ansprechpartner, der Verantwortung übernimmt – vom Kick-off bis zum Skalieren.</p>
      <div class="mt-4 flex flex-col sm:flex-row gap-3">
        <a href="tel:+491604365363" class="btn btn-primary">Jetzt anrufen</a>
        <a href="/kontakt" class="btn btn-secondary">Erstgespräch vereinbaren</a>
      </div>
    </div>
  </section>
</BaseLayout>
