---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Section from "@/components/Section.astro";
import CTA from "@/components/CTA-Bar.astro";
import Footer from "@/components/Footer.astro";
import HeadSEO from "@/components/HeadSEO.astro";
const meta = {
  title: "Über uns | Gylsere Januzi Krieg – Online Marketing Office",
  description: "Strategen, Tech‑Nerds & Kreative aus Schwäbisch Gmünd. Performance, Marke & High‑Performance Webdesign für messbares Wachstum.",
  url: "https://example.com/ueber-uns/",
  canonical: "https://example.com/ueber-uns/",
  image: "/images/hero-bg.webp",
  type: "article"
};
---
<html lang="de" class="dark">
  <head>
    <HeadSEO {...meta} />
  </head>
  <body>
    <Layout title={meta.title} description={meta.description}>
      <Fragment slot="nav"><Navbar /></Fragment>
      <Section id="about" title="Premium – pragmatisch – messbar" intro="Wir entwickeln High‑Performance‑Websites und Online‑Marketing für Unternehmen, die wachsen wollen – mit Fokus auf Sichtbarkeit, Anfragen und Umsatz.">
        <div class="grid md:grid-cols-2 gap-8">
          <article class="card p-6">
            <h3 class="h3">Werte</h3>
            <ul class="mt-3 text-txt-2 grid gap-2">
              <li>• Klarheit: Ziele, KPIs und Erwartungen sind von Beginn an definiert</li>
              <li>• Qualität: saubere Codebasis, schnelle Ladezeiten, starke UX</li>
              <li>• Verantwortung: DSGVO und Consent‑Management ohne Kompromisse</li>
              <li>• Partnerschaft: langfristige Zusammenarbeit auf Augenhöhe</li>
            </ul>
          </article>
          <article class="card p-6">
            <h3 class="h3">Arbeitsweise</h3>
            <p class="text-txt-2 mt-2">Strategisch, datenbasiert, effizient. Moderner Tech‑Stack (Astro, Headless, Tracking) kombiniert mit erprobten SEO‑ und Performance‑Playbooks. Jede Maßnahme zahlt auf Ihre KPIs ein – kein Overhead.</p>
          </article>
        </div>
      </Section>
      <Section id="contact-person" title="Ihre Ansprechpartnerin" intro="Gylsere begleitet Ihr Projekt von der Idee bis zur Skalierung – verbindlich, erreichbar, lösungsorientiert.">
        <div class="card p-6 grid md:grid-cols-3 gap-6 items-center">
          <picture class="md:col-span-1">
            <img src="/images/portrait-gylsere.webp" alt="Porträt von Gylsere Januzi Krieg" class="w-full h-auto rounded-lg border border-border" loading="lazy" />
          </picture>
          <div class="md:col-span-2">
            <p class="text-txt-2">Ein Ansprechpartner. Kurze Wege. Schnelle Entscheidungen. Termine vor Ort in Schwäbisch Gmünd oder remote.</p>
            <div class="mt-4 flex flex-wrap gap-3">
              <a href="/projekt-anfragen" class="btn btn-primary btn-glare">Projekt anfragen</a>
              <a href="/kontakt" class="btn btn-secondary">Kontakt</a>
            </div>
          </div>
        </div>
      </Section>
      <CTA />
      <Fragment slot="footer"><Footer /></Fragment>
    </Layout>
  </body>
</html>
