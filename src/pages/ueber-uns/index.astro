---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import IconSprite from '../../components/IconSprite.astro';
import ScrollAnimations from '../../components/ScrollAnimations.astro';
const pageTitle = 'Timo Krieg – ListingProfis | Digitalagentur in Schwäbisch Gmünd';
const pageDesc = 'Wir bauen Sichtbarkeit vor Ort: Local SEO, GBP, Listings & performante Astro‑Websites. Persönlich, schnell, messbar – aus Schwäbisch Gmünd.';
---
<BaseLayout title={pageTitle} description={pageDesc}>
  <Fragment slot="icons"><IconSprite /></Fragment>
  <Fragment slot="header"><Header /></Fragment>
  <main>
    <section class="section container" data-reveal-group>
      <h1 class="reveal">Über uns</h1>
      <p class="reveal text-muted" style="max-width:68ch">Wir machen lokale Marktführer sichtbar. Als Online‑Marketing‑Agentur in Schwäbisch Gmünd verbinden wir präzise Strategie, schnelle Umsetzung und messbare Resultate.</p>
      <div class="grid grid-3 mt-4">
        <article class="card reveal">
          <h3 class="card__title">1) Analyse</h3>
          <p class="card__meta">Audit von Google Business Profile, Website, Listings, Reputation, Wettbewerbern.</p>
        </article>
        <article class="card reveal">
          <h3 class="card__title">2) Umsetzung</h3>
          <p class="card__meta">Schnelle To‑dos zuerst – Astro Performance, GBP, Citations, Bewertungen, lokale Seiten.</p>
        </article>
        <article class="card reveal">
          <h3 class="card__title">3) Wachstum</h3>
          <p class="card__meta">Monitoring, Reporting, kontinuierliche Optimierung für nachhaltige Rankings & Leads.</p>
        </article>
      </div>
      <div class="grid grid-4 mt-4" data-reveal-group>
        <div class="card reveal"><strong>Lokal verwurzelt</strong><p class="card__meta">Schwäbisch Gmünd – kurze Wege, schnelle Reaktion.</p></div>
        <div class="card reveal"><strong>Technisch vorn</strong><p class="card__meta">Astro, Core Web Vitals, strukturierte Daten, saubere Architektur.</p></div>
        <div class="card reveal"><strong>Transparent</strong><p class="card__meta">Klare Roadmaps, Reporting, echte KPIs.</p></div>
        <div class="card reveal"><strong>Fokus Ergebnis</strong><p class="card__meta">Leads, Termine, Umsatz – kein Aktionismus.</p></div>
      </div>
      <div class="mt-4">
        <a class="btn btn--primary" href="tel:+491604365363">Jetzt anrufen</a>
        <a class="btn btn--ghost" href="/kontakt/" style="margin-left:8px">Kostenloses Erstgespräch</a>
      </div>
    </section>
  </main>
  <ScrollAnimations />
  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>
