---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Leistungen from '../components/Leistungen.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
const title = 'Leistungen: SEO, Local SEO, Ads, GEO, Webdesign/E‑Com | GJK';
const description = 'Full‑Service: SEO, Local SEO, Google Ads, GEO, Webdesign & E‑Commerce (Astro/Next.js), AI & Automation, Terminbuchung, Reputation, Social, Foto/Video, Branding, Praxis‑TV, Code & Factoring.';
const canonical = 'https://online-marketing-office.de/leistungen';
---
<Base {title} {description} {canonical}>
  <Header />
  <main id="main">
    <section class="section container flow">
      <h1>Leistungen</h1>
      <p class="text-muted">End‑to‑End: Strategie, Umsetzung, Optimierung – immer messbar.</p>
    </section>
    <Leistungen />
    <Contact />
  </main>
  <Footer />
</Base>
