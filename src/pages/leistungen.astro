---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<Layout title="Leistungen – Gylsere Januzi" description="Alle Leistungen im Überblick.">
  <Fragment slot="header"><Header /></Fragment>
  <section class="py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl font-semibold mb-6">Leistungen</h1>
      <!-- Inhalte 1:1 werden hier eingefügt. -->
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3"></div>
    </div>
  </section>
  <Fragment slot="footer"><Footer /></Fragment>
</Layout>
