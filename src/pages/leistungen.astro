---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Leistungen | Timo Krieg" description="Webdesign (Astro), SEO/Content, Google/LinkedIn Ads – Mittelstand in DACH.">
  <section class="container py-16 md:py-24">
    <h1 class="text-3xl md:text-5xl font-semibold">Leistungen</h1>
    <div class="mt-8 grid gap-6">
      <article class="card">
        <h2 class="text-xl font-semibold">Webdesign mit Astro</h2>
        <p class="mt-2 text-slate-300">Blitzschnelle, barrierearme Websites, die konvertieren.</p>
      </article>
      <article class="card">
        <h2 class="text-xl font-semibold">SEO & Content</h2>
        <p class="mt-2 text-slate-300">Technik, Keyword-Strategie und Inhalte mit klarem Mehrwert.</p>
      </article>
      <article class="card">
        <h2 class="text-xl font-semibold">Google/LinkedIn Ads</h2>
        <p class="mt-2 text-slate-300">Planen, testen, skalieren – messbarer ROI.</p>
      </article>
    </div>
  </section>
</BaseLayout>
