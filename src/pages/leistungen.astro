---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Section from "../components/Section.astro";
---
<Layout title="Leistungen – Gylsere Januzi" description="Alle Leistungen im Überblick.">
  <Fragment slot="header"><Header /></Fragment>
  <Section title="Leistungen" intro="Diese Inhalte werden 1:1 aus der bisherigen Live-Domain übernommen.">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <article class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur"><h3 class="font-semibold mb-2">Service A</h3><p class="text-gray-400">1:1-Text folgt sofort.</p></article>
      <article class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur"><h3 class="font-semibold mb-2">Service B</h3><p class="text-gray-400">1:1-Text folgt sofort.</p></article>
      <article class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur"><h3 class="font-semibold mb-2">Service C</h3><p class="text-gray-400">1:1-Text folgt sofort.</p></article>
    </div>
  </Section>
  <Fragment slot="footer"><Footer /></Fragment>
</Layout>
