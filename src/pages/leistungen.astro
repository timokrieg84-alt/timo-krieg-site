---
import BaseLayout from "../layouts/BaseLayout.astro";
const services = [
  { id: "seo", title: "SEO", subtitle: "Sichtbar werden, wenn es zählt.", description: "Technisches SEO, Content-Strategie und Backlinks – damit Ihre Kunden Sie finden, bevor es Ihre Wettbewerber tun.", features: ["Technisches SEO", "Content & Keywords", "Backlink-Aufbau", "Local SEO"] },
  { id: "seo-regio", title: "SEO-Regio", subtitle: "Die absolute Umland-Dominanz.", description: "Das geniale Prinzip: Ihre Original-Website bleibt zu 100% unangetastet! Wir erstellen ein Netzwerk aus 50 zusätzlichen, eigenständigen Webseiten für 50 umliegende Ortschaften mit individuell maßgeschneiderten Texten.", features: ["50 Satelliten-Seiten", "Kein Risiko für Original-Site", "Umland-Abdeckung", "Local SEO Boost"] },
  { id: "google-ads", title: "Google Ads", subtitle: "Jeder Klick mit Absicht.", description: "Performance Max, Search, YouTube – mit messbarem ROAS, exklusivem Klickschutz gegen Mitbewerber und ohne Budgetverschwendung.", features: ["Search & Performance Max", "Conversion-Tracking", "Klickschutz (Click-Fraud)", "Retargeting"] },
  { id: "geo", title: "GEO", subtitle: "Sichtbar in ChatGPT, Perplexity & Google AI.", description: "Generative Engine Optimization – deine Marke wird in AI-Antworten zitiert, nicht nur bei Google gerankt. LLM-crawlbare Inhalte, Entity-SEO, llms.txt und Citation-Ready Content.", features: ["LLM-Crawling", "Entity-SEO", "Citation-Ready Content", "llms.txt & AI Overviews"] },
  { id: "webdesign", title: "Webdesign & E-Commerce", subtitle: "Websites, die verkaufen.", description: "Maßgeschneidertes Design mit Astro & Next.js – ultraschnell, skalierbar und konversionsstark mit exzellenten Core Web Vitals, DSGVO-Sicherheit und Verkaufspsychologie.", features: ["Custom Design", "Astro & Next.js", "Core Web Vitals", "CRO & APIs"] },
  { id: "online-terminvereinbarung", title: "Online-Terminvereinbarung", subtitle: "24/7 Terminbuchungen automatisieren.", description: "Einbindung professioneller Online-Terminbuchungssysteme (inkl. Jameda & Doctolib Schnittstellen) direkt in Ihre Webpräsenz und Suchmaschinen für lückenlose Auslastung.", features: ["API-Schnittstellen", "24/7-Buchung", "Automatisierte Abläufe", "Echtzeit-Synchronisation"] },
  { id: "marketing", title: "Marketing", subtitle: "Der Mix, der wirkt.", description: "Von Content über Social bis Email – ganzheitliches Marketing, das auf Ihre Zahlen einzahlt.", features: ["Content", "Social Media", "Reporting & Analytics"] },
  { id: "ai-automation", title: "AI & Automation", subtitle: "Prozesse, die mitdenken.", description: "Custom-AI-Agenten, LLM-Integrationen und Workflow-Automation – damit Sie Zeit für das Wesentliche haben.", features: ["Custom-AI-Agenten", "LLM-Integrationen", "Workflow-Automatisierung"] },
  { id: "branding", title: "Branding", subtitle: "Markenbildung mit Substanz.", description: "Brand DNA, Visual Identity und Messaging – eine Marke, die bleibt.", features: ["Brand Strategy", "Visual Identity", "Logo & Design System", "Messaging"] },
  { id: "social-media", title: "Social Media", subtitle: "Content, der Kunden bringt.", description: "Strategie, Content-Produktion und Kanal-Management für Instagram, TikTok, LinkedIn & Co. – Social Media, das messbar Anfragen und Umsatz liefert.", features: ["Strategie & Kanalaufbau", "Foto, Video & Grafik", "Community-Management", "Paid Social"] },
  { id: "reputation", title: "Reputation & Bewertungen", subtitle: "Automatisierte Top-Bewertungen & Schutz.", description: "Google-Rezensionen vollautomatisch sammeln sowie unfaire, böswillige oder gefälschte Bewertungen prüfen, melden und rechtskonform entfernen lassen.", features: ["Rezensionen löschen", "Review-Monitoring", "5-Sterne-System", "Reputation-Recovery"] },
  { id: "praxis-tv", title: "Praxis- & Wartezimmer-TV", subtitle: "Hochkonvertierende Präsentationen.", description: "Visuell überragende Bildschirmpräsentationen für Wartezimmer zur Patientenaufklärung und Förderung von Zusatzleistungen.", features: ["Wartezimmer-TV", "Patienten-Aufklärung", "Zusatzleistungen", "Visuelle Konzepte"] },
  { id: "code-exzellenz", title: "Code-Exzellenz & Software", subtitle: "Custom Programmierarbeiten.", description: "Entwicklung individueller Softwarelösungen, Custom-Tools, API-Schnittstellen, CRM-Verknüpfungen und Erneuerung von Altsystemen.", features: ["Custom Software", "API-Integrationen", "Legacy-Modernisierung", "Prozessautomatisierung"] },
  { id: "factoring", title: "Premium-Factoring", subtitle: "Sofortige Liquidität & Ausfallschutz.", description: "Verkauf offener B2B-Forderungen für Geldeingang innerhalb von 24–48 Stunden inkl. 100% Übernahme des Ausfallrisikos.", features: ["100% Ausfallschutz", "Sofort-Liquidität", "Bessere Bonität", "Debitorenmanagement"] }
];
---
<BaseLayout title="Leistungen – Gylsere Januzi Krieg Online Marketing Office" description="Alle 14 Leistungen im Überblick: SEO, GEO, Ads, Webdesign, Social, AI & mehr.">
  <section class="section-y container-px">
    <h1 class="text-3xl font-semibold tracking-tight mb-3">Leistungen</h1>
    <p class="text-zinc-400 max-w-3xl mb-8">Unser vollständiges Leistungsspektrum – modular kombinierbar, messbar wirksam.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((s) => (
        <article id={s.id} class="card">
          <h2 class="h2 mb-1">{s.title}</h2>
          <p class="muted mb-3">{s.subtitle}</p>
          <p class="text-sm text-zinc-200 mb-4">{s.description}</p>
          <div class="flex flex-wrap gap-2" aria-label="Features">
            {s.features.map((f) => <span class="chip">{f}</span>)}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
