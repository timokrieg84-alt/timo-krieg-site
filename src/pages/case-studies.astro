---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Case Studies – Gylsere Januzi Krieg Online Marketing Office" description="Ergebnisse, die überzeugen: ausgewählte Projekte und Wirkung.">
  <section class="py-16 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="text-xs uppercase tracking-wider text-[#123D2A]">Referenzen</div>
        <h1 class="mt-3 text-3xl sm:text-5xl font-semibold text-[#1A1A1A] mb-4">Case Studies</h1>
        <p class="text-lg text-[#1A1A1A]/70">Bald verfügbar – sprechen wir bis dahin über Ihre Ziele und passende Referenzen.</p>
        <div class="mt-8"><a href="/#contact" class="inline-flex items-center gap-2 rounded-full bg-[#123D2A] px-5 py-3 text-[#F5F1E9] hover:bg-[#C8501E] transition-colors">Projekt anfragen</a></div>
      </div>
    </div>
  </section>
</BaseLayout>
