---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Case Studies – Gylsere Januzi Krieg" description="Ergebnisse, die überzeugen: ausgewählte Projekte und Wachstumsgeschichten.">
  <section class="section">
    <div class="container">
      <h1 class="text-white text-3xl font-bold mb-2">Case Studies</h1>
      <p class="text-slate-400 mb-8">Ausgewählte Kundenprojekte mit konkreten Ergebnissen. Mehr Cases auf Anfrage.</p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <article class="card">
          <h3>SEO-Regio für Dienstleister</h3>
          <div class="subtitle">+180% organische Anfragen in 4 Monaten</div>
          <p>50 Satelliten-Seiten, Local SEO & GMB-Optimierung führten zu dominanten Local Rankings.</p>
          <div class="chips">
            <span class="chip">Local SEO</span>
            <span class="chip">Google My Business</span>
            <span class="chip">Content</span>
          </div>
        </article>
        <article class="card">
          <h3>Performance Max Kampagnen</h3>
          <div class="subtitle">ROAS 5.2 bei 20k€ Spend</div>
          <p>Klare Creative-Strategie, sauberes Tracking und aggressives Retargeting.</p>
          <div class="chips">
            <span class="chip">Google Ads</span>
            <span class="chip">Tracking</span>
            <span class="chip">ROAS</span>
          </div>
        </article>
        <article class="card">
          <h3>Astro Website Relaunch</h3>
          <div class="subtitle">LCP < 1.5s, +34% Conversion-Rate</div>
          <p>Ultraschnelles Frontend in Astro & Next.js, klare Informationsstruktur und CRO.</p>
          <div class="chips">
            <span class="chip">Astro</span>
            <span class="chip">Core Web Vitals</span>
            <span class="chip">CRO</span>
          </div>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
