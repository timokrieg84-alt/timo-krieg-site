---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import IconSprite from '../../components/IconSprite.astro';
import ScrollAnimations from '../../components/ScrollAnimations.astro';
const pageTitle = 'Referenzen | Local‑SEO & Website‑Projekte aus der Region';
const pageDesc = 'Ergebnisse, die zählen: Cases zu GBP‑Rankings, Bewertungen, schnelleren Websites & mehr Leads aus Schwäbisch Gmünd und Stuttgart.';
---
<BaseLayout title={pageTitle} description={pageDesc}>
  <Fragment slot="icons"><IconSprite /></Fragment>
  <Fragment slot="header"><Header /></Fragment>
  <main>
    <section class="section container" data-reveal-group>
      <h1 class="reveal">Referenzen</h1>
      <p class="reveal text-muted">Ausgewählte Projekte – kurz, klar, messbar.</p>
      <div class="grid grid-3 mt-4">
        <article class="card reveal"><h3 class="card__title">Autohaus, Schwäbisch Gmünd</h3><p class="card__meta">Local SEO + GBP‑Posts → +81% Kartenaufrufe, +54% Anrufe</p></article>
        <article class="card reveal"><h3 class="card__title">Physiopraxis, Ostalbkreis</h3><p class="card__meta">Reputation‑Programm → Ø 4,9 Sterne, 3× mehr Termin‑Anfragen</p></article>
        <article class="card reveal"><h3 class="card__title">IT‑Dienstleister, Stuttgart</h3><p class="card__meta">Astro Relaunch → LCP 0,7 s, +42% organische Leads</p></article>
        <article class="card reveal"><h3 class="card__title">Restaurantkette, BW</h3><p class="card__meta">Listings‑Konsolidierung → −76% Dubletten, +39% Wegbeschreibungen</p></article>
        <article class="card reveal"><h3 class="card__title">Handwerk 24/7, DACH</h3><p class="card__meta">Local Landingpages → +68% organischer Non‑Brand‑Traffic</p></article>
        <article class="card reveal"><h3 class="card__title">E‑Bike‑Store, Schwäbisch Gmünd</h3><p class="card__meta">Content & Ads → ROAS 4,2, deutliche Umsatzsteigerung</p></article>
      </div>
      <div class="mt-4">
        <a class="btn btn--primary" href="tel:+491604365363">Jetzt anrufen</a>
        <a class="btn btn--ghost" href="/kontakt/" style="margin-left:8px">Kostenloses Erstgespräch</a>
      </div>
    </section>
  </main>
  <ScrollAnimations />
  <Fragment slot="footer"><Footer /></Fragment>
</BaseLayout>
